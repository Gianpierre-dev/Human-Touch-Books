{
  "name": "human-touch-books",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "postinstall": "prisma generate",
    "start": "node ./dist/server/entry.mjs",
    "check": "astro check",
    "lint": "eslint .",
    "formato": "prettier --check .",
    "format": "prettier --write .",
    "test:unitarias": "node --experimental-strip-types --test \"pruebas/unitarias/*.test.mjs\"",
    "test:humo": "node pruebas/humo.mjs",
    "test": "pnpm test:unitarias && pnpm test:humo"
  },
  "dependencies": {
    "@astrojs/node": "^9.4.0",
    "@aws-sdk/client-s3": "^3.1096.0",
    "@prisma/client": "^6.16.0",
    "astro": "^5.13.0",
    "bcryptjs": "^3.0.3",
    "jsonwebtoken": "^9.0.3",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@tailwindcss/vite": "^4.1.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "eslint": "^10.8.1",
    "eslint-plugin-astro": "^3.1.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^6.16.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "prisma",
      "@prisma/client",
      "esbuild",
      "sharp"
    ]
  }
}
