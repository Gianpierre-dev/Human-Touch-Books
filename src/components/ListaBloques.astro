---
// Lista administrable de bloques cortos (título + texto + orden + visibilidad).
// La usan /admin/bloques y /admin/chips: comparten exactamente la misma
// mecánica y sólo cambian el copy, los límites y el endpoint. Duplicar el
// marcado obligaría a corregir cualquier detalle de accesibilidad dos veces.
import type { LimitesBloque } from "../lib/bloques";

interface Elemento {
  id: string;
  titulo: string;
  texto?: string | null;
  orden: number;
  activa: boolean;
  /** Valor del campo extra opcional, si la lista declara `campoOpcional`. */
  valorOpcional?: string | null;
}

/**
 * Campo de texto extra que algunas listas necesitan y otras no (la frase
 * destacada de una sección institucional, por ejemplo). Se declara aquí en vez
 * de duplicar el componente: el resto de la mecánica es idéntica.
 */
interface CampoOpcional {
  /** Nombre del campo del formulario. También forma el código de error. */
  nombre: string;
  etiqueta: string;
  ayuda: string;
  limite: number;
  filas?: number;
}

/** Icono y color que la web asigna a cada posición. Se muestran como vista previa. */
interface EstiloPrevio {
  color: string;
  icono: string;
}

interface Props {
  encabezado: string;
  descripcion: string;
  /** Aviso que se muestra cuando la lista está vacía. */
  vacio: string;
  /** Nombre del elemento en singular y plural, para los textos de la pantalla. */
  singular: string;
  plural: string;
  /** "el" o "la": concuerda los mensajes con el género del nombre. */
  articulo: string;
  rutaApi: string;
  limites: LimitesBloque;
  elementos: Elemento[];
  ok: string | null;
  error: string | null;
  ayudaTitulo: string;
  ayudaTexto: string;
  /**
   * Nivel del encabezado de la lista. Es 1 cuando la lista ES la pantalla; se
   * pasa 2 cuando la pantalla monta varias listas y ya tiene su propio h1.
   */
  nivelEncabezado?: 1 | 2;
  /** Los pilares de una línea no llevan texto: solo la etiqueta. */
  conTexto?: boolean;
  /** Campos que el alta necesita mandar además del formulario (línea, tipo…). */
  camposOcultos?: Record<string, string>;
  /** Estilos fijos por posición. Vacío = la lista no muestra vista previa. */
  estilos?: readonly EstiloPrevio[];
  /** Enlace de vuelta cuando la lista vive dentro de otra pantalla. */
  volver?: { href: string; texto: string };
  /** Campo de texto extra, opcional en el formulario y en el modelo. */
  campoOpcional?: CampoOpcional;
  /** Filas del textarea de «Texto». Los textos largos necesitan más de 3. */
  filasTexto?: number;
}

const {
  encabezado,
  descripcion,
  vacio,
  singular,
  plural,
  articulo,
  rutaApi,
  limites,
  elementos,
  ok,
  error,
  ayudaTitulo,
  ayudaTexto,
  nivelEncabezado = 1,
  conTexto = true,
  camposOcultos = {},
  estilos = [],
  volver,
  campoOpcional,
  filasTexto = 3,
} = Astro.props;

// La pantalla de bloques de una linea monta este componente DOS veces (pilares
// y argumentos). Los identificadores del formulario tienen que ser unicos en el
// documento: si se repiten, `aria-describedby` resuelve siempre al primero y el
// segundo formulario se anuncia con la ayuda del otro.
const sufijoId = singular
  .toLowerCase()
  .normalize("NFD")
  .replace(/[̀-ͯ]/g, "")
  .replace(/[^a-z0-9]+/g, "-")
  .replace(/(^-|-$)/g, "");
const idAyudaTitulo = `ayuda-nuevo-titulo-${sufijoId}`;
const idAyudaTexto = `ayuda-nuevo-texto-${sufijoId}`;
const idAyudaOpcional = `ayuda-nuevo-opcional-${sufijoId}`;

// Astro admite una variable en mayúscula como etiqueta: así la lista se puede
// anidar bajo un h1 ajeno sin duplicar encabezados de nivel 1.
const Encabezado = nivelEncabezado === 2 ? "h2" : "h1";
const SubEncabezado = nivelEncabezado === 2 ? "h3" : "h2";

const ocultos = Object.entries(camposOcultos);

const activos = elementos.filter((elemento) => elemento.activa).length;

// Concuerda el demostrativo con el género del nombre: "este bloque", "esta tarjeta".
const demostrativo = articulo === "la" ? "esta" : "este";

const MENSAJES_OK: Record<string, string> = {
  creado: `Se agregó ${articulo} ${singular}.`,
  guardado: "Cambios guardados.",
  eliminado: `Se eliminó ${articulo} ${singular}.`,
  visible: `Ya se muestra en la web.`,
  oculto: `Dejó de mostrarse en la web.`,
  reordenado: "Orden actualizado.",
  sincambios: "No había nada que cambiar.",
};

const MENSAJES_ERROR: Record<string, string> = {
  sintitulo: "El título es obligatorio.",
  titulolargo: `El título admite hasta ${limites.titulo} caracteres.`,
  sintexto: "El texto es obligatorio.",
  textolargo: `El texto admite hasta ${limites.texto} caracteres.`,
  orden: "El orden debe ser un número.",
  noexiste: `No encontramos ${articulo} ${singular}.`,
  accion: "No reconocimos la acción solicitada.",
  // El código de error del campo extra lo forma su propio nombre: así el
  // validador del servidor y este mensaje no se pueden desincronizar.
  ...(campoOpcional && {
    [`${campoOpcional.nombre}largo`]: `${campoOpcional.etiqueta} admite hasta ${campoOpcional.limite} caracteres.`,
  }),
};

const textoError = error ? (MENSAJES_ERROR[error] ?? error) : null;

const clasesCampo =
  "mt-1.5 min-h-[44px] w-full rounded-lg border border-line bg-paper px-3.5 py-2.5 text-sm outline-none focus-visible:border-brand focus-visible:ring-2 focus-visible:ring-brand/30";
const clasesBoton =
  "foco-marca inline-flex min-h-[44px] items-center justify-center gap-1.5 rounded-full border border-line bg-surface px-4 text-xs font-bold text-ink transition-colors hover:bg-surface-2 disabled:cursor-not-allowed disabled:opacity-40";
const clasesBotonPeligro =
  "foco-marca inline-flex min-h-[44px] items-center justify-center rounded-full border border-accent/40 bg-surface px-4 text-xs font-bold text-accent-deep transition-colors hover:bg-accent/10";
const clasesBotonPrincipal =
  "foco-marca inline-flex min-h-[44px] items-center rounded-full bg-brand px-7 text-sm font-bold text-white transition-colors hover:bg-brand-deep";
---

<Encabezado
  class:list={[
    nivelEncabezado === 2 ? "text-xl font-bold text-ink" : "text-2xl font-extrabold text-ink",
  ]}
>
  {encabezado}
</Encabezado>
<p class="mt-1 text-sm text-ink/70">
  {elementos.length}
  {elementos.length === 1 ? singular : plural}, {activos} visible{activos === 1 ? "" : "s"} en la web.
  {descripcion}
</p>

{
  ok && (
    <p class="mt-4 rounded-lg bg-wa/10 px-4 py-2.5 text-sm font-semibold text-wa-deep">
      {MENSAJES_OK[ok] ?? "Listo."}
    </p>
  )
}
{
  textoError && (
    <p class="mt-4 rounded-lg bg-accent/10 px-4 py-2.5 text-sm font-semibold text-accent-deep">
      {textoError}
    </p>
  )
}

{
  elementos.length === 0 && (
    <p class="mt-6 rounded-xl border border-line bg-surface px-6 py-10 text-center text-sm text-ink/70">
      {vacio}
    </p>
  )
}

{
  /* Ocultar todo no devuelve el contenido original: deja la zona sin
    elementos. Conviene decirlo antes de que sorprenda en la web. */
}
{
  elementos.length > 0 && activos === 0 && (
    <p class="mt-6 rounded-lg border border-line bg-surface-2 px-4 py-3 text-sm text-ink/75">
      Ningún elemento está visible, así que esta zona no se muestra en la web. Activa al menos uno
      para que vuelva a verse.
    </p>
  )
}

<div class="mt-6 space-y-5">
  {
    elementos.map((elemento, posicion) => (
      <article
        id={`elemento-${elemento.id}`}
        class="rounded-xl border border-line bg-surface p-6 shadow-sm"
        aria-labelledby={`titulo-${elemento.id}`}
      >
        <div class="flex flex-wrap items-start justify-between gap-3">
          <div class="flex items-center gap-3">
            {/* Vista previa del estilo fijo que la web le da a esta posición: el
                icono y el color no se editan, pero conviene verlos aquí para
                entender qué cambia al reordenar. Decorativa. */}
            {estilos.length > 0 && (
              <span
                class="grid h-9 w-9 shrink-0 place-items-center rounded-full"
                style={`background-color:${estilos[posicion % estilos.length]?.color}`}
                aria-hidden="true"
              >
                <svg viewBox="0 0 24 24" class="h-5 w-5 fill-white">
                  <path d={estilos[posicion % estilos.length]?.icono} />
                </svg>
              </span>
            )}
            <SubEncabezado id={`titulo-${elemento.id}`} class="text-base font-bold text-ink">
              {posicion + 1}. {elemento.titulo}
            </SubEncabezado>
          </div>
          <span
            class:list={[
              "inline-block rounded-full px-2.5 py-0.5 text-[0.7rem] font-bold",
              elemento.activa ? "bg-wa/15 text-wa-deep" : "bg-surface-2 text-ink/70",
            ]}
          >
            {elemento.activa ? "Visible" : "Oculto"}
          </span>
        </div>

        <div class="mt-4 flex flex-wrap items-center gap-2">
          <form method="post" action={`${rutaApi}/${elemento.id}`}>
            <input type="hidden" name="_accion" value="subir" />
            <button
              type="submit"
              class={clasesBoton}
              disabled={posicion === 0}
              aria-label={`Subir «${elemento.titulo}» una posición`}
            >
              <svg viewBox="0 0 24 24" class="h-4 w-4 fill-current" aria-hidden="true">
                <path d="M12 6l6 6h-4v6h-4v-6H6l6-6Z" />
              </svg>
              Subir
            </button>
          </form>
          <form method="post" action={`${rutaApi}/${elemento.id}`}>
            <input type="hidden" name="_accion" value="bajar" />
            <button
              type="submit"
              class={clasesBoton}
              disabled={posicion === elementos.length - 1}
              aria-label={`Bajar «${elemento.titulo}» una posición`}
            >
              <svg viewBox="0 0 24 24" class="h-4 w-4 fill-current" aria-hidden="true">
                <path d="M12 18l-6-6h4V6h4v6h4l-6 6Z" />
              </svg>
              Bajar
            </button>
          </form>
          <form method="post" action={`${rutaApi}/${elemento.id}`}>
            <input type="hidden" name="_accion" value="activar" />
            <button
              type="submit"
              class={clasesBoton}
              aria-label={`${elemento.activa ? "Ocultar" : "Mostrar"} en la web «${elemento.titulo}»`}
            >
              {elemento.activa ? "Ocultar" : "Mostrar"}
            </button>
          </form>
          <form
            method="post"
            action={`${rutaApi}/${elemento.id}`}
            onsubmit={`return confirm('¿Eliminar ${demostrativo} ${singular}? No se puede deshacer.')`}
          >
            <input type="hidden" name="_accion" value="eliminar" />
            <button
              type="submit"
              class={clasesBotonPeligro}
              aria-label={`Eliminar «${elemento.titulo}»`}
            >
              Eliminar
            </button>
          </form>
        </div>

        <form
          method="post"
          action={`${rutaApi}/${elemento.id}`}
          class="mt-5 border-t border-line pt-5"
        >
          <label class="block">
            <span class="text-sm font-semibold text-ink">
              Título <span class="text-accent-deep">*</span>
            </span>
            <input
              type="text"
              name="titulo"
              required
              maxlength={limites.titulo}
              value={elemento.titulo}
              class={clasesCampo}
            />
          </label>
          {conTexto && (
            <label class="mt-4 block">
              <span class="text-sm font-semibold text-ink">
                Texto <span class="text-accent-deep">*</span>
              </span>
              {/* Sin saltos de línea alrededor: el contenido del textarea ES su valor. */}
              <textarea
                name="texto"
                rows={filasTexto}
                required
                maxlength={limites.texto}
                class={clasesCampo}
              >
                {elemento.texto ?? ""}
              </textarea>
            </label>
          )}
          {campoOpcional && (
            <label class="mt-4 block">
              <span class="text-sm font-semibold text-ink">{campoOpcional.etiqueta}</span>
              <textarea
                name={campoOpcional.nombre}
                rows={campoOpcional.filas ?? 2}
                maxlength={campoOpcional.limite}
                class={clasesCampo}
              >
                {elemento.valorOpcional ?? ""}
              </textarea>
              <span class="mt-1.5 block text-xs text-ink/70">
                {campoOpcional.ayuda} Puede quedar vacío. Hasta {campoOpcional.limite} caracteres.
              </span>
            </label>
          )}
          <label class="mt-4 block max-w-[12rem]">
            <span class="text-sm font-semibold text-ink">Orden</span>
            <input type="number" name="orden" value={elemento.orden} class={clasesCampo} />
          </label>
          <button type="submit" class:list={[clasesBotonPrincipal, "mt-5"]}>
            Guardar cambios
          </button>
        </form>
      </article>
    ))
  }
</div>

<form
  method="post"
  action={rutaApi}
  class="mt-8 max-w-2xl rounded-xl border border-line bg-surface p-6 shadow-sm md:p-8"
>
  <SubEncabezado class="text-lg font-bold text-ink">Agregar {singular}</SubEncabezado>

  {ocultos.map(([nombre, valor]) => <input type="hidden" name={nombre} value={valor} />)}

  <label class="mt-5 block">
    <span class="text-sm font-semibold text-ink">
      Título <span class="text-accent-deep">*</span>
    </span>
    <input
      type="text"
      name="titulo"
      required
      maxlength={limites.titulo}
      aria-describedby={idAyudaTitulo}
      class={clasesCampo}
    />
  </label>
  <p id={idAyudaTitulo} class="mt-1.5 text-xs text-ink/70">
    {ayudaTitulo} Hasta {limites.titulo} caracteres.
  </p>

  {
    conTexto && (
      <>
        <label class="mt-4 block">
          <span class="text-sm font-semibold text-ink">
            Texto <span class="text-accent-deep">*</span>
          </span>
          <textarea
            name="texto"
            rows={filasTexto}
            required
            maxlength={limites.texto}
            aria-describedby={idAyudaTexto}
            class={clasesCampo}
          />
        </label>
        <p id={idAyudaTexto} class="mt-1.5 text-xs text-ink/70">
          {ayudaTexto} Hasta {limites.texto} caracteres.
        </p>
      </>
    )
  }

  {
    campoOpcional && (
      <>
        <label class="mt-4 block">
          <span class="text-sm font-semibold text-ink">{campoOpcional.etiqueta}</span>
          <textarea
            name={campoOpcional.nombre}
            rows={campoOpcional.filas ?? 2}
            maxlength={campoOpcional.limite}
            aria-describedby={idAyudaOpcional}
            class={clasesCampo}
          />
        </label>
        <p id={idAyudaOpcional} class="mt-1.5 text-xs text-ink/70">
          {campoOpcional.ayuda} Puede quedar vacío. Hasta {campoOpcional.limite} caracteres.
        </p>
      </>
    )
  }

  <label class="mt-4 block max-w-[12rem]">
    <span class="text-sm font-semibold text-ink">Orden</span>
    <input type="number" name="orden" value={elementos.length + 1} class={clasesCampo} />
  </label>

  <button type="submit" class:list={[clasesBotonPrincipal, "mt-6"]}>
    Agregar {singular}
  </button>
</form>

{
  volver && (
    <p class="mt-8">
      <a
        href={volver.href}
        class="foco-marca inline-flex min-h-[44px] items-center gap-2 text-sm font-bold text-brand hover:text-brand-deep"
      >
        <svg viewBox="0 0 24 24" class="h-4 w-4 fill-current" aria-hidden="true">
          <path d="M14 7l-5 5 5 5V7Z" />
        </svg>
        {volver.texto}
      </a>
    </p>
  )
}
