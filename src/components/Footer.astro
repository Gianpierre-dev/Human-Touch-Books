---
// Pie del sitio publico.
//
// LA COLUMNA «EXPLORA» SALE DE LA MISMA NAVEGACION QUE EL MENU
// Antes eran anclas escritas a mano y se desfasaban solas: cada pagina
// institucional o linea nueva aparecia en la cabecera y no en el pie. Ahora las
// dos partes leen `src/lib/navegacion.ts`, asi que publicar una pagina en el
// panel la deja enlazada en los dos sitios sin tocar codigo.
import { NAVEGACION_VACIA, type EnlaceMenu, type Navegacion } from "../lib/navegacion";
import { defectoFijo } from "../lib/textos";

interface Props {
  whatsapp?: string;
  correoContacto?: string;
  ubicacion?: string;
  /** Páginas institucionales y líneas activas, las mismas de la cabecera. */
  navegacion?: Navegacion;
  /** Párrafo bajo el logotipo. Administrable desde /admin/textos. */
  descripcion?: string;
  /**
   * Prefijo de los enlaces de ancla. Vacío en la landing; "/" en el resto de
   * páginas, para que el ancla lleve a la landing y no a la nada.
   */
  base?: string;
}

// El texto del catálogo es la única fuente del valor por defecto: así el pie no
// se desincroniza del placeholder que ve el panel.
const DESCRIPCION_POR_DEFECTO = defectoFijo("pie_descripcion");

// Los títulos de las dos columnas y el enlace a preguntas frecuentes viajan en
// la misma prop `navegacion`: son administrables y llegan ya resueltos.
const {
  whatsapp = "51982953436",
  correoContacto = "informes@humantouchbooks.pe",
  ubicacion = "La Molina, Lima — Perú",
  navegacion = NAVEGACION_VACIA,
  descripcion = DESCRIPCION_POR_DEFECTO,
  base = "",
} = Astro.props;

const { etiquetas } = navegacion;

const whatsappVisible = `+${whatsapp.slice(0, 2)} ${whatsapp.slice(2, 5)} ${whatsapp.slice(5, 8)} ${whatsapp.slice(8)}`;
const year = new Date().getFullYear();

// Area tactil de 44 px de alto en cada enlace del pie (WCAG 2.5.8).
const claseEnlace = "foco-marca inline-flex min-h-[44px] items-center text-ink/75";

// Primero las páginas institucionales y las líneas (destinos propios), y al
// final el ancla de la landing: un enlace a una sección de otra página se lee
// mejor cerrando la lista que mezclado entre las páginas.
const explora: EnlaceMenu[] = [
  ...navegacion.paginas,
  ...navegacion.lineas,
  { href: `${base}#preguntas`, etiqueta: etiquetas.pie_preguntas },
];
---

<footer class="border-t border-line bg-surface-2">
  <div class="mx-auto max-w-6xl px-4 py-14 md:px-8">
    <div class="flex flex-col gap-10 md:flex-row md:items-start md:justify-between">
      <div class="max-w-sm">
        <img src="/brand/logo.png" alt="Human Touch Books" class="h-14 w-auto" width="113" height="70" />
        <p class="mt-4 text-sm leading-relaxed text-ink/75">{descripcion}</p>
      </div>

      <div class="grid grid-cols-1 gap-8 text-sm sm:grid-cols-2 sm:gap-10">
        <div>
          <h2 class="font-display text-base text-ink">{etiquetas.pie_explora}</h2>
          <ul class="mt-2">
            {explora.map((enlace) => (
              <li>
                <a href={enlace.href} class={claseEnlace}>
                  <span class="enlace-sub">{enlace.etiqueta}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
        <div>
          <h2 class="font-display text-base text-ink">{etiquetas.pie_contacto}</h2>
          <ul class="mt-2">
            <li>
              <a href={`https://wa.me/${whatsapp}`} class={claseEnlace}><span class="enlace-sub">{whatsappVisible}</span></a>
            </li>
            <li>
              <a href={`mailto:${correoContacto}`} class={claseEnlace}><span class="enlace-sub">{correoContacto}</span></a>
            </li>
            <li>
              <a href={`${base}#contacto`} class={claseEnlace}><span class="enlace-sub">Solicitar información</span></a>
            </li>
            <li class="flex min-h-[44px] items-center text-ink/75">{ubicacion}</li>
          </ul>
        </div>
      </div>
    </div>

    {/* La política va junto al copyright, no en «Explora»: es una página legal,
        no un destino que la visitante esté buscando. */}
    <div
      class="mt-12 flex flex-col gap-2 border-t border-line pt-6 text-xs text-ink/70 sm:flex-row sm:items-center sm:justify-between sm:gap-6"
    >
      <p>© {year} Human Touch Books · Editorial. Todos los derechos reservados.</p>
      <a href="/privacidad" class="foco-marca inline-flex min-h-[44px] items-center text-ink/70">
        <span class="enlace-sub">Política de privacidad</span>
      </a>
    </div>
  </div>
</footer>
