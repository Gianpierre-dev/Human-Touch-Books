---
// Pie del sitio publico.
//
// LA COLUMNA «EXPLORA» SALE DE LA MISMA NAVEGACION QUE EL MENU
// Antes eran anclas escritas a mano y se desfasaban solas: cada pagina
// institucional o linea nueva aparecia en la cabecera y no en el pie. Ahora las
// dos partes leen `src/lib/navegacion.ts`, asi que publicar una pagina en el
// panel la deja enlazada en los dos sitios sin tocar codigo.
import { NAVEGACION_VACIA, type EnlaceMenu, type Navegacion } from "../lib/navegacion";
import { listarRedes, type RedesSociales } from "../lib/redes";

interface Props {
  whatsapp?: string;
  correoContacto?: string;
  ubicacion?: string;
  /**
   * Direcciones de los perfiles cargados en /admin/ajustes. Solo se pinta el
   * icono de las redes con direccion: no hay valor por defecto que inventar.
   */
  redes?: RedesSociales;
  /** Páginas institucionales y líneas activas, las mismas de la cabecera. */
  navegacion?: Navegacion;
  /**
   * Prefijo de los enlaces de ancla. Vacío en la landing; "/" en el resto de
   * páginas, para que el ancla lleve a la landing y no a la nada.
   */
  base?: string;
}

// Los títulos de las columnas, el enlace a preguntas y el párrafo bajo el
// logotipo viajan en la misma prop `navegacion`: son administrables y llegan
// ya resueltos, sin que cada página tenga que acordarse de leerlos.
const {
  whatsapp = "51982953436",
  correoContacto = "informes@humantouchbooks.pe",
  ubicacion = "La Molina, Lima — Perú",
  redes = {},
  navegacion = NAVEGACION_VACIA,
  base = "",
} = Astro.props;

const { etiquetas } = navegacion;
const descripcion = etiquetas.pie_descripcion;

// Glifos de marca dibujados a mano (fill-current, un solo path), como el resto
// de los iconos del proyecto: no se agrega una libreria de iconos por cuatro
// dibujos. La clave es la misma del catalogo de redes.
const GLIFOS_RED: Record<string, string> = {
  facebook:
    "M14.5 22v-9h3l.5-3.5h-3.5V7.2c0-1 .3-1.7 1.8-1.7h1.9V2.4c-.3 0-1.5-.15-2.8-.15-2.8 0-4.7 1.7-4.7 4.8V9.5H7.5V13h3.2v9h3.8Z",
  instagram:
    "M7.5 2h9A5.5 5.5 0 0 1 22 7.5v9a5.5 5.5 0 0 1-5.5 5.5h-9A5.5 5.5 0 0 1 2 16.5v-9A5.5 5.5 0 0 1 7.5 2Zm0 2A3.5 3.5 0 0 0 4 7.5v9A3.5 3.5 0 0 0 7.5 20h9a3.5 3.5 0 0 0 3.5-3.5v-9A3.5 3.5 0 0 0 16.5 4h-9Zm4.5 3a5 5 0 1 1 0 10 5 5 0 1 1 0-10Zm0 2a3 3 0 1 0 0 6 3 3 0 1 0 0-6Zm5.5-3.3a1.3 1.3 0 1 1 0 2.6 1.3 1.3 0 1 1 0-2.6Z",
  tiktok:
    "M13 3h3c.3 2.6 1.8 4.1 4 4.3v3.3c-1.5 0-2.9-.5-4-1.2v5.1h-3V3Zm-3 5.5a6 6 0 1 1 0 12 6 6 0 1 1 0-12Zm0 3.2a2.8 2.8 0 1 0 0 5.6 2.8 2.8 0 1 0 0-5.6Z",
  youtube:
    "M5 4h14a4 4 0 0 1 4 4v8a4 4 0 0 1-4 4H5a4 4 0 0 1-4-4V8a4 4 0 0 1 4-4Zm5 4.5v7l6-3.5-6-3.5Z",
};

const redesCargadas = listarRedes(redes);

const whatsappVisible = `+${whatsapp.slice(0, 2)} ${whatsapp.slice(2, 5)} ${whatsapp.slice(5, 8)} ${whatsapp.slice(8)}`;
const year = new Date().getFullYear();

// Area tactil de 44 px de alto en cada enlace del pie (WCAG 2.5.8).
const claseEnlace = "foco-marca inline-flex min-h-[44px] items-center text-ink/75";

// Primero las páginas institucionales y las líneas (destinos propios), y al
// final el ancla de la landing: un enlace a una sección de otra página se lee
// mejor cerrando la lista que mezclado entre las páginas.
const explora: EnlaceMenu[] = [
  ...navegacion.paginas,
  ...navegacion.lineas,
  { href: `${base}#preguntas`, etiqueta: etiquetas.pie_preguntas },
];
---

<footer class="border-t border-line bg-surface-2">
  <div class="mx-auto max-w-6xl px-4 py-14 md:px-8">
    <div class="flex flex-col gap-10 md:flex-row md:items-start md:justify-between">
      <div class="max-w-sm">
        <img
          src="/brand/logo.webp"
          alt="Human Touch Books"
          class="h-14 w-auto"
          width="113"
          height="70"
        />
        <p class="mt-4 text-sm leading-relaxed text-ink/75">{descripcion}</p>

        {
          redesCargadas.length > 0 && (
            <ul class="mt-4 -ml-2.5 flex flex-wrap items-center">
              {redesCargadas.map(({ red, url }) => (
                <li>
                  <a
                    href={url}
                    target="_blank"
                    rel="noopener"
                    aria-label={`Human Touch Books en ${red.nombre}`}
                    class="foco-marca grid h-11 w-11 place-items-center text-ink/70 transition-colors hover:text-brand"
                  >
                    <svg viewBox="0 0 24 24" class="h-5 w-5 fill-current" aria-hidden="true">
                      <path d={GLIFOS_RED[red.campo]} />
                    </svg>
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>

      {
        /* min-w-0: como hijo de flex, sin el la columna crece hasta su
          contenido y el correo empujaba scroll horizontal en tablet. */
      }
      <div class="grid min-w-0 grid-cols-1 gap-8 text-sm sm:grid-cols-2 sm:gap-10">
        <div>
          <h2 class="font-display text-base text-ink">{etiquetas.pie_explora}</h2>
          <ul class="mt-2">
            {
              explora.map((enlace) => (
                <li>
                  <a href={enlace.href} class={claseEnlace}>
                    <span class="enlace-sub">{enlace.etiqueta}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <h2 class="font-display text-base text-ink">{etiquetas.pie_contacto}</h2>
          <ul class="mt-2">
            <li>
              <a href={`https://wa.me/${whatsapp}`} class={claseEnlace}
                ><span class="enlace-sub">{whatsappVisible}</span></a
              >
            </li>
            <li>
              {
                /* overflow-wrap: el correo no tiene espacios; sin un punto de
                corte permitido desbordaba la columna en tablet (medido: 57px
                de scroll horizontal en las 8 paginas a 768px). */
              }
              <a href={`mailto:${correoContacto}`} class={`${claseEnlace} [overflow-wrap:anywhere]`}
                ><span class="enlace-sub">{correoContacto}</span></a
              >
            </li>
            <li>
              <a href={`${base}#contacto`} class={claseEnlace}
                ><span class="enlace-sub">Solicitar información</span></a
              >
            </li>
            <li class="flex min-h-[44px] items-center text-ink/75">{ubicacion}</li>
          </ul>
        </div>
      </div>
    </div>

    {
      /* La política va junto al copyright, no en «Explora»: es una página legal,
        no un destino que la visitante esté buscando. */
    }
    <div
      class="mt-12 flex flex-col gap-2 border-t border-line pt-6 text-xs text-ink/70 sm:flex-row sm:items-center sm:justify-between sm:gap-6"
    >
      <p>© {year} Human Touch Books · Editorial. Todos los derechos reservados.</p>
      <a href="/privacidad" class="foco-marca inline-flex min-h-[44px] items-center text-ink/70">
        <span class="enlace-sub">Política de privacidad</span>
      </a>
    </div>
  </div>
</footer>
