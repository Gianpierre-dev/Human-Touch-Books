---
// Pagina institucional publica (/nosotros/{clave}): «Quiénes somos», «Misión y
// visión», y las que el cliente vaya escribiendo. UNA plantilla para todas: lo
// que cambia entre ellas son los datos, no el marcado.
//
// Cada seccion se OMITE cuando no tiene contenido. A diferencia de la pagina de
// una linea, aqui no hay textos por defecto: el contenido institucional no se
// puede derivar del nombre de la pagina. Por eso una pagina con solo titular y
// parrafos tiene que verse digna por si sola, y lo hace: el hero ocupa toda la
// pantalla y la franja de contacto cierra siempre.
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { bd } from "../../lib/bd";
import { cargarNavegacion } from "../../lib/navegacion";
import { ESTILOS_SECCION, ESTILOS_VALOR, partirEnParrafos } from "../../lib/paginas";

export const prerender = false;

const { clave = "" } = Astro.params;

const pagina = await bd.paginaInstitucional.findUnique({
  where: { clave },
  include: {
    secciones: { where: { activa: true }, orderBy: [{ orden: "asc" }, { creadoEn: "asc" }] },
    bloques: { where: { activa: true }, orderBy: [{ orden: "asc" }, { creadoEn: "asc" }] },
  },
});

// Una pagina desactivada no existe para el publico: 404 real, no una pagina en
// blanco con estado 200 que Google indexaria igual. `activa` arranca en false,
// asi que un borrador nunca se publica solo. El `rewrite` renderiza la pagina
// de marca (src/pages/404.astro) SIN cambiar la URL, y el estado 404 lo fija esa
// pagina.
if (!pagina || !pagina.activa) {
  return Astro.rewrite("/404");
}

// El icono y el color de cada seccion y de cada valor se asignan POR POSICION,
// ciclando los arreglos del codigo (src/lib/paginas.ts). No son editables.
const secciones = pagina.secciones.map((seccion, posicion) => ({
  ...seccion,
  parrafos: partirEnParrafos(seccion.texto),
  estilo: ESTILOS_SECCION[posicion % ESTILOS_SECCION.length]!,
}));

const valores = pagina.bloques.map((bloque, posicion) => ({
  ...bloque,
  estilo: ESTILOS_VALOR[posicion % ESTILOS_VALOR.length]!,
}));

const parrafos = partirEnParrafos(pagina.parrafos);

// Sin titular propio se usa el nombre del menu: el h1 nunca queda vacio.
const titular = pagina.tituloPagina?.trim() || pagina.titulo;
const hayImagen = Boolean(pagina.imagenUrl);
// Sin medidas guardadas (fila cargada antes de guardarlas) se usa una proporcion
// 4:3 para reservar el hueco: el objetivo es que no haya salto de maquetado.
const ancho = pagina.ancho ?? 1600;
const alto = pagina.alto ?? 1200;

// Datos de contacto: los mismos que administra /admin/ajustes para la landing.
const filasAjustes = await bd.ajuste.findMany();
const ajustes = Object.fromEntries(filasAjustes.map((ajuste) => [ajuste.clave, ajuste.valor]));
const whatsapp = ajustes.whatsapp ?? "51982953436";
const correoContacto = ajustes.correo_contacto ?? "informes@humantouchbooks.pe";
const ubicacion = ajustes.ubicacion ?? "La Molina, Lima — Perú";

const TEXTO_WHATSAPP = "Hola, quiero información sobre Human Touch Books.";
const enlaceWhatsapp = `https://wa.me/${whatsapp}?text=${encodeURIComponent(TEXTO_WHATSAPP)}`;

const navegacion = await cargarNavegacion();

// La descripcion sale del primer parrafo del hero, recortada. Sin parrafos cae
// al titular: mejor una descripcion corta que la generica del sitio.
const descripcion = parrafos[0]?.slice(0, 160) ?? `${titular} — Human Touch Books`;
const tituloPestana = `${pagina.titulo} — Human Touch Books`;

// Tarjeta social propia: la imagen del hero de la pagina, con sus medidas
// REALES de la base (no el 1600x1200 de respaldo que reserva el hueco). Sin
// imagen se queda la portada social general del sitio.
const imagenSocial = pagina.imagenUrl
  ? { url: pagina.imagenUrl, ancho: pagina.ancho ?? undefined, alto: pagina.alto ?? undefined }
  : undefined;
---

<Layout
  title={tituloPestana}
  description={descripcion}
  anclaContenido="#contenido"
  imagenSocial={imagenSocial}
>
  <Header whatsapp={whatsapp} base="/" navegacion={navegacion} />

  <main id="contenido" tabindex="-1">
    <!-- HERO -->
    <section class="border-b border-line bg-surface" aria-labelledby="titulo-pagina">
      <div
        class:list={[
          "mx-auto grid max-w-6xl items-center gap-10 px-4 py-14 md:px-8 md:py-20",
          hayImagen && "lg:grid-cols-[1.05fr_0.95fr]",
        ]}
      >
        <div class="reveal">
          {
            pagina.antetitulo && (
              <span class="text-xs font-bold tracking-[0.2em] text-brand uppercase">
                {pagina.antetitulo}
              </span>
            )
          }
          {/* Regla del sistema: el azul de marca como TEXTO solo sobre blanco
              puro, que es donde cumple 4,5:1. Por eso el hero va sin tinte. */}
          <h1
            id="titulo-pagina"
            class:list={[
              "font-display text-[clamp(2.1rem,5vw,3.4rem)] leading-[1.08] font-bold tracking-tight text-ink",
              pagina.antetitulo && "mt-2",
            ]}
          >
            {titular}
            {
              pagina.tituloDestacado && (
                <>
                  {" "}
                  <span class="text-brand">{pagina.tituloDestacado}</span>
                </>
              )
            }
          </h1>

          {
            parrafos.length > 0 && (
              <div class="mt-6 max-w-[58ch] space-y-4 leading-relaxed text-ink/75">
                {parrafos.map((parrafo) => (
                  <p>{parrafo}</p>
                ))}
              </div>
            )
          }

          <div class="mt-8 flex flex-wrap items-center gap-3.5">
            <a
              href="#contacto-institucional"
              class="foco-marca boton-elevar [--sombra-hover:rgb(18_74_153_/_0.5)] inline-flex min-h-[52px] items-center gap-2.5 rounded-full bg-brand px-8 text-[0.95rem] font-bold text-white shadow-lg hover:bg-brand-deep"
            >
              <svg viewBox="0 0 24 24" class="h-4.5 w-4.5 fill-current" aria-hidden="true">
                <path
                  d="M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2Zm0 4-8 5-8-5V6l8 5 8-5v2Z"
                ></path>
              </svg>
              Conoce nuestros materiales
            </a>
            <a
              href="/"
              class="foco-marca inline-flex min-h-[52px] items-center gap-2 rounded-full border border-line bg-surface px-7 text-[0.95rem] font-bold text-ink transition-colors hover:bg-surface-2"
            >
              <svg viewBox="0 0 24 24" class="h-4 w-4 fill-current" aria-hidden="true">
                <path d="M14 7l-5 5 5 5V7Z"></path>
              </svg>
              Volver al inicio
            </a>
          </div>
        </div>

        {
          hayImagen && (
            <div class="reveal-scroll">
              <img
                src={pagina.imagenUrl}
                alt={pagina.imagenAlt ?? ""}
                width={ancho}
                height={alto}
                style={`aspect-ratio: ${ancho} / ${alto};`}
                class="block w-full rounded-2xl object-cover shadow-xl shadow-navy/15 ring-1 ring-line"
                loading="eager"
                fetchpriority="high"
              />
            </div>
          )
        }
      </div>
    </section>

    <!-- SECCIONES GRANDES (Misión, Visión…) -->
    {
      secciones.length > 0 && (
        <section class="bg-paper py-16 md:py-20" aria-labelledby="titulo-secciones">
          <div class="mx-auto max-w-5xl px-4 md:px-8">
            {/* La seccion necesita un nombre accesible y no hay un titular
                administrable para ella: los titulos de las secciones YA dicen
                de que va. El encabezado va solo para lector de pantalla. */}
            <h2 id="titulo-secciones" class="sr-only">
              {pagina.titulo}
            </h2>
            <ul class="space-y-8">
              {secciones.map((seccion) => (
                <li class="reveal-scroll">
                  {/* Rejilla de dos columnas: el circulo cuelga a la izquierda
                      y el titulo y el cuerpo comparten la columna derecha, como
                      en la pieza. Se prefiere a posicionar el circulo en
                      absoluto: asi el texto nunca se le puede montar encima por
                      mucho que crezca el titulo. */}
                  <article class="grid grid-cols-[3.5rem_1fr] items-start gap-x-4 gap-y-3 rounded-2xl border border-line bg-surface p-6 shadow-sm sm:grid-cols-[4rem_1fr] sm:gap-x-5 md:p-9">
                    {/* Circulo decorativo: el titulo de al lado ya nombra la
                        seccion en texto, asi que el icono va aria-hidden. */}
                    <span
                      class="grid h-14 w-14 place-items-center self-center rounded-full sm:h-16 sm:w-16"
                      style={`background-color:${seccion.estilo.color}`}
                      aria-hidden="true"
                    >
                      <svg viewBox="0 0 24 24" class="h-7 w-7 fill-white sm:h-8 sm:w-8">
                        <path d={seccion.estilo.icono} />
                      </svg>
                    </span>

                    <h3 class="self-center font-display text-[clamp(1.4rem,2.6vw,1.9rem)] leading-tight font-bold tracking-wide text-brand-deep uppercase">
                      {seccion.titulo}
                    </h3>

                    {/* Desde sm el cuerpo arranca en la segunda columna, para
                        quedar alineado con el titulo. En el movil mas angosto
                        ocupa las dos: sangrarlo ahi dejaba renglones de unos
                        cuarenta caracteres. */}
                    <div class="col-span-2 max-w-[68ch] space-y-3 leading-relaxed text-ink/80 sm:col-span-1 sm:col-start-2">
                      {seccion.parrafos.map((parrafo) => (
                        <p>{parrafo}</p>
                      ))}
                      {seccion.destacado && (
                        <p class="!mt-6 max-w-[62ch] border-l-4 border-brand pl-4 font-semibold text-brand-deep">
                          {seccion.destacado}
                        </p>
                      )}
                    </div>
                  </article>
                </li>
              ))}
            </ul>
          </div>
        </section>
      )
    }

    <!-- VALORES -->
    {
      valores.length > 0 && (
        <section class="border-t border-line bg-surface-2 py-16 md:py-20" aria-labelledby="titulo-valores">
          <div class="mx-auto max-w-6xl px-4 md:px-8">
            <div class="reveal-scroll text-center">
              {pagina.bloquesAntetitulo && (
                <span class="text-xs font-bold tracking-[0.2em] text-brand-deep uppercase">
                  {pagina.bloquesAntetitulo}
                </span>
              )}
              {/* Sin titular propio el encabezado sigue existiendo, oculto: la
                  seccion tiene que tener nombre accesible igual. */}
              <h2
                id="titulo-valores"
                class:list={[
                  pagina.bloquesTitulo
                    ? "mt-2 font-display text-[clamp(1.6rem,3.2vw,2.3rem)] leading-tight font-bold text-ink"
                    : "sr-only",
                ]}
              >
                {pagina.bloquesTitulo ?? "Nuestros valores"}
              </h2>
            </div>

            {/* Cuatro tarjetas caben justo en una fila; con tres columnas la
                cuarta quedaba huérfana en una segunda fila. Cualquier otra
                cantidad se reparte de a tres, que es como se ve la pieza de
                «Quiénes somos». */}
            <ul
              class:list={[
                "grid gap-6 sm:grid-cols-2",
                valores.length === 4 ? "lg:grid-cols-4" : "lg:grid-cols-3",
                // Sin titular visible las tarjetas no necesitan separarse de
                // nada: el aire de la sección ya las despega del bloque anterior.
                pagina.bloquesTitulo || pagina.bloquesAntetitulo ? "mt-12" : "mt-0",
              ]}
            >
              {valores.map((valor) => (
                <li class="reveal-scroll">
                  <article class="flex h-full items-start gap-4 rounded-2xl border border-line bg-surface p-6 shadow-sm">
                    <span
                      class="grid h-14 w-14 shrink-0 place-items-center rounded-full"
                      style={`background-color:${valor.estilo.color}`}
                      aria-hidden="true"
                    >
                      <svg viewBox="0 0 24 24" class="h-7 w-7 fill-white">
                        <path d={valor.estilo.icono} />
                      </svg>
                    </span>
                    <div>
                      <h3 class="text-[1.05rem] leading-snug font-bold text-ink">{valor.titulo}</h3>
                      <p class="mt-2 text-[0.9rem] leading-relaxed text-ink/75">{valor.texto}</p>
                    </div>
                  </article>
                </li>
              ))}
            </ul>

            {
              pagina.cierreTexto && (
                <p class="reveal-scroll mx-auto mt-12 max-w-[62ch] text-center text-[1.05rem] leading-relaxed text-ink/80">
                  {pagina.cierreTexto}
                  {pagina.cierreDestacado && (
                    <>
                      {" "}
                      <strong class="font-bold text-brand-deep">{pagina.cierreDestacado}</strong>
                    </>
                  )}
                </p>
              )
            }
          </div>
        </section>
      )
    }

    {/* La frase de cierre acompaña a los valores. Sin valores cargados, se
        muestra igual: es contenido propio y no puede desaparecer con ellos. */}
    {
      valores.length === 0 && pagina.cierreTexto && (
        <section class="border-t border-line bg-surface-2 py-14" aria-label="Cierre">
          <p class="reveal-scroll mx-auto max-w-[62ch] px-4 text-center text-[1.05rem] leading-relaxed text-ink/80 md:px-8">
            {pagina.cierreTexto}
            {pagina.cierreDestacado && (
              <>
                {" "}
                <strong class="font-bold text-brand-deep">{pagina.cierreDestacado}</strong>
              </>
            )}
          </p>
        </section>
      )
    }

    <!-- CIERRE DE CONTACTO -->
    {/* Mismo patron que la franja final de /lineas/{clave}, con el azul de
        marca: una pagina institucional no pertenece a ninguna linea. */}
    <section
      id="contacto-institucional"
      class="franja-marca text-white"
      aria-labelledby="titulo-contacto"
    >
      <div
        class="mx-auto flex max-w-6xl flex-col items-start gap-8 px-4 py-14 md:flex-row md:items-center md:justify-between md:px-8 md:py-16"
      >
        <div class="max-w-[46ch]">
          <h2
            id="titulo-contacto"
            class="font-display text-[clamp(1.5rem,3vw,2.1rem)] leading-tight font-bold"
          >
            ¿Quieres conocer nuestros materiales?
          </h2>
          {/* Blanco puro: bajarlo a /85 lo funde con el fondo y el contraste
              cae por debajo del mínimo. */}
          <p class="mt-3 leading-relaxed text-white">
            Escríbenos y te acompañamos a elegir la propuesta que necesita tu institución.
          </p>
        </div>
        <div class="flex w-full flex-wrap items-center gap-3.5 md:w-auto">
          <a
            href="/#contacto"
            class="foco-claro inline-flex min-h-[52px] flex-1 items-center justify-center gap-2.5 rounded-full bg-white px-8 text-[0.95rem] font-extrabold whitespace-nowrap text-ink shadow-[0_12px_28px_-10px_rgba(0,0,0,0.55)] transition duration-300 ease-out hover:-translate-y-0.5 md:flex-none"
          >
            <svg viewBox="0 0 24 24" class="h-4.5 w-4.5 fill-brand" aria-hidden="true">
              <path
                d="M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2Zm0 4-8 5-8-5V6l8 5 8-5v2Z"
              ></path>
            </svg>
            Contáctanos
          </a>
          <a
            href={enlaceWhatsapp}
            target="_blank"
            rel="noopener"
            class="foco-claro inline-flex min-h-[52px] flex-1 items-center justify-center gap-2 rounded-full border border-white/50 px-7 text-[0.95rem] font-bold whitespace-nowrap text-white transition-colors hover:border-white hover:bg-white/10 md:flex-none"
          >
            <svg viewBox="0 0 24 24" class="h-4.5 w-4.5 fill-current" aria-hidden="true">
              <path
                d="M12 2a10 10 0 0 0-8.6 15l-1.3 4.7 4.8-1.3A10 10 0 1 0 12 2Zm5.3 14.2c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .1-1.7-.1-.4-.2-.9-.3-1.6-.6-2.7-1.2-4.5-4-4.6-4.2-.2-.2-1.1-1.5-1.1-2.8 0-1.3.7-2 .9-2.2.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 2c.1.2.1.4 0 .5l-.4.6c-.2.2-.3.4-.1.7.2.3.9 1.4 1.9 2.3 1.3 1.1 2.3 1.4 2.6 1.6.3.1.5.1.7-.1l.7-.8c.2-.3.4-.2.7-.1l2 .9c.3.2.5.2.6.4.1.1.1.7-.1 1.3Z"
              ></path>
            </svg>
            Escríbenos por WhatsApp
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer
    whatsapp={whatsapp}
    correoContacto={correoContacto}
    ubicacion={ubicacion}
    navegacion={navegacion}
    base="/"
  />
</Layout>
