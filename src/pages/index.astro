                  <option value="">Selecciona un asunto</option>
                  <option>Información para colegios</option>
                  <option>Información para padres de familia</option>
                  <option>Capacitaciones y talleres</option>
                  <option>Otro</option>
                </select>
                {campoInvalido === "asunto" && <ErrorCampo campo="asunto" mensaje={textoError} />}
              </label>
            </div>
            <label class="mt-4 block">
              <span class="text-sm font-semibold text-ink">Mensaje <span class="text-accent">*</span></span>
              <textarea
                name="mensaje"
                rows="4"
                required
                maxlength="2000"
                placeholder="Escribe tu mensaje aquí…"
                class={clasesCampo}
                {...estadoCampo("mensaje")}></textarea>
              {campoInvalido === "mensaje" && <ErrorCampo campo="mensaje" mensaje={textoError} />}
            </label>

            {/* Trampa antispam: invisible para las personas, tentadora para los bots. */}
            <div class="hidden" aria-hidden="true">
              <label>
                Sitio web
                <input type="text" name="sitio_web" tabindex="-1" autocomplete="off" />
              </label>
            </div>

            <div class="mt-6 grid gap-3 sm:grid-cols-2">
              <button
                type="submit"
                class="foco-marca inline-flex min-h-[48px] w-full items-center justify-center gap-2 rounded-full bg-brand px-7 text-sm font-bold text-white transition-colors hover:bg-brand-deep"
              >
                <svg viewBox="0 0 24 24" class="h-4 w-4 fill-current" aria-hidden="true">
                  <path d="M2 21 23 12 2 3v7l15 2-15 2v7Z" />
                </svg>
                Enviar mensaje
              </button>
              <a
                id="enlace-whatsapp"
                href={enlaceWhatsappGenerico}
                target="_blank"
                rel="noopener"
                data-whatsapp={whatsapp}
                class="foco-marca inline-flex min-h-[48px] w-full items-center justify-center gap-2 rounded-full border border-wa px-7 text-sm font-bold text-wa transition-colors hover:bg-wa/10"
              >
                <svg viewBox="0 0 24 24" class="h-4 w-4 fill-current" aria-hidden="true">
                  <path d="M12 2a10 10 0 0 0-8.6 15l-1.3 4.7 4.8-1.3A10 10 0 1 0 12 2Zm5.3 14.2c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .1-1.7-.1-.4-.2-.9-.3-1.6-.6-2.7-1.2-4.5-4-4.6-4.2-.2-.2-1.1-1.5-1.1-2.8 0-1.3.7-2 .9-2.2.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 2c.1.2.1.4 0 .5l-.4.6c-.2.2-.3.4-.1.7.2.3.9 1.4 1.9 2.3 1.3 1.1 2.3 1.4 2.6 1.6.3.1.5.1.7-.1l.7-.8c.2-.3.4-.2.7-.1l2 .9c.3.2.5.2.6.4.1.1.1.7-.1 1.3Z" />
                </svg>
                Continuar por WhatsApp
              </a>
            </div>

            <p class="mt-3 flex items-center justify-center gap-1.5 text-center text-xs text-ink/70">
              <svg viewBox="0 0 24 24" class="h-3.5 w-3.5 fill-brand" aria-hidden="true">
                <path d="M12 2 4 5v6c0 5 3.4 9.7 8 11 4.6-1.3 8-6 8-11V5l-8-3Z" />
              </svg>
              Tu información está segura. No compartimos tus datos.
            </p>
          </form>
        </div>
      </div>
    </section>

    <!-- CIERRE -->
    <section class="relative overflow-hidden bg-navy text-white" aria-labelledby="titulo-cierre">
      <div
        class="pointer-events-none absolute inset-0 bg-[radial-gradient(48rem_24rem_at_80%_-20%,#1e6fd955,transparent_62%)]"
        aria-hidden="true"
      >
      </div>
      <div
        class="relative mx-auto flex max-w-6xl flex-col items-start gap-8 px-4 py-14 md:flex-row md:items-center md:justify-between md:px-8 md:py-16"
      >
        <div class="max-w-[46ch]">
          <h2 id="titulo-cierre" class="text-[clamp(1.5rem,3vw,2.1rem)] font-display leading-tight font-bold">
