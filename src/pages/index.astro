                  <h3 class="mt-2.5 text-[0.8125rem] leading-tight font-bold text-ink">{c.titulo}</h3>
                  <p class="mt-1.5 text-[0.75rem] leading-snug text-ink/75">{c.texto}</p>
                </div>
              ))
            }
          </div>

          {/* Antes decia "INGRESA AQUI" y hacia scroll al formulario: prometia un
              login que no existe en esta pagina. El acceso se solicita. */}
          <div class="mt-8 flex flex-wrap items-center gap-4">
            <a
              href="#contacto"
              class="foco-marca inline-flex min-h-[52px] items-center gap-2.5 rounded-full bg-gradient-to-r from-brand to-violet px-8 text-[0.95rem] font-bold text-white shadow-lg shadow-brand/25 transition duration-300 ease-out hover:-translate-y-0.5 hover:shadow-xl"
            >
              <span class="grid h-6 w-6 place-items-center rounded-full bg-white/20">
                <svg viewBox="0 0 24 24" class="h-3.5 w-3.5 fill-white" aria-hidden="true">
                  <path d="M10 17l5-5-5-5v10Z" />
