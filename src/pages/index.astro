          >
            <svg viewBox="0 0 24 24" class="h-4.5 w-4.5 fill-brand" aria-hidden="true">
              <path d="M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2Zm0 4-8 5-8-5V6l8 5 8-5v2Z" />
            </svg>
            Solicitar información
          </a>
          <a
            href={enlaceWhatsappGenerico}
            target="_blank"
            rel="noopener"
            class="foco-claro inline-flex min-h-[52px] flex-1 items-center justify-center gap-2 rounded-full border border-white/45 px-7 text-[0.95rem] font-bold whitespace-nowrap text-white transition-colors hover:border-white hover:bg-white/10 md:flex-none"
          >
            <svg viewBox="0 0 24 24" class="h-4.5 w-4.5 fill-current" aria-hidden="true">
              <path d="M12 2a10 10 0 0 0-8.6 15l-1.3 4.7 4.8-1.3A10 10 0 1 0 12 2Zm5.3 14.2c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .1-1.7-.1-.4-.2-.9-.3-1.6-.6-2.7-1.2-4.5-4-4.6-4.2-.2-.2-1.1-1.5-1.1-2.8 0-1.3.7-2 .9-2.2.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 2c.1.2.1.4 0 .5l-.4.6c-.2.2-.3.4-.1.7.2.3.9 1.4 1.9 2.3 1.3 1.1 2.3 1.4 2.6 1.6.3.1.5.1.7-.1l.7-.8c.2-.3.4-.2.7-.1l2 .9c.3.2.5.2.6.4.1.1.1.7-.1 1.3Z" />
            </svg>
            Escríbenos por WhatsApp
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer
    whatsapp={whatsapp}
    correoContacto={correoContacto}
    ubicacion={ubicacion}
    hayColeccion={escolares.length > 0}
  />

  {/*
    Carrusel de la portada: mejora progresiva.
    Sin este script el carrusel ya funciona (flechas-ancla, puntos y arrastre).
    Con el, las flechas se reducen a un unico par que sabe donde estamos y se
    habilita el avance automatico, que solo arranca si la persona no pidio
    reducir el movimiento y se frena con hover, foco dentro o cualquier
    interaccion.
  */}
  <script is:inline>
    (() => {
      const region = document.getElementById("hero-carrusel");
      const pista = document.getElementById("hero-pista");
      const controles = document.getElementById("hero-controles");
      if (!region || !pista || !controles) return;

      const diapositivas = pista.querySelectorAll("[data-diapositiva]");
      const total = diapositivas.length;
      if (total < 2) return;

      const anterior = document.getElementById("hero-anterior");
      const siguiente = document.getElementById("hero-siguiente");
      const pausa = document.getElementById("hero-pausa");
      const puntos = Array.from(region.querySelectorAll("[data-punto]"));
      if (!anterior || !siguiente) return;

      // Primero se muestran los controles nuevos y despues se retiran los de
      // respaldo: si algo fallara antes, siempre queda un juego utilizable.
      controles.hidden = false;
      region.querySelectorAll("[data-flechas-ancla]").forEach((flechas) => {
        flechas.hidden = true;
      });

      const animacionPermitida = window.matchMedia("(prefers-reduced-motion: no-preference)").matches;
      const INTERVALO = 6500;

      let indice = 0;
      let temporizador = null;
      let detenido = false;

      const marcar = () => {
        puntos.forEach((punto, posicion) => {
          if (posicion === indice) punto.setAttribute("aria-current", "true");
          else punto.removeAttribute("aria-current");
        });
      };

      const irA = (destino) => {
        indice = (destino + total) % total;
        pista.scrollTo({
          left: pista.clientWidth * indice,
          behavior: animacionPermitida ? "smooth" : "auto",
        });
        marcar();
      };

      const frenar = () => {
        if (temporizador === null) return;
        window.clearInterval(temporizador);
        temporizador = null;
      };

      const arrancar = () => {
        if (!animacionPermitida || detenido || temporizador !== null) return;
        temporizador = window.setInterval(() => irA(indice + 1), INTERVALO);
      };

      // Cualquier interaccion deliberada detiene el avance automatico: quien
      // esta mirando manda, y el boton queda listo para reanudarlo.
      const detenerPorPersona = () => {
        if (detenido) return;
        detenido = true;
        frenar();
        if (pausa) {
          pausa.setAttribute("aria-pressed", "true");
          pausa.textContent = "Reanudar";
        }
      };

      anterior.addEventListener("click", () => {
        detenerPorPersona();
        irA(indice - 1);
      });
      siguiente.addEventListener("click", () => {
        detenerPorPersona();
        irA(indice + 1);
      });

      puntos.forEach((punto, posicion) => {
        punto.addEventListener("click", (evento) => {
          evento.preventDefault(); // el ancla movería toda la página
          detenerPorPersona();
          irA(posicion);
        });
      });

      ["pointerdown", "touchstart", "wheel", "keydown"].forEach((tipo) => {
        pista.addEventListener(tipo, detenerPorPersona, { passive: true });
      });

      // El arrastre no dispara los controles: el indice se recalcula al parar.
      let repaso = 0;
      pista.addEventListener(
        "scroll",
        () => {
          window.clearTimeout(repaso);
          repaso = window.setTimeout(() => {
            const visible = Math.round(pista.scrollLeft / pista.clientWidth);
            if (visible !== indice && visible >= 0 && visible < total) {
              indice = visible;
              marcar();
            }
          }, 120);
        },
        { passive: true },
      );

      marcar();

      if (!animacionPermitida || !pausa) return;

      pausa.hidden = false;
      pausa.addEventListener("click", () => {
        if (!detenido) {
          detenerPorPersona();
          return;
        }
        detenido = false;
        pausa.setAttribute("aria-pressed", "false");
        pausa.textContent = "Pausar";
        arrancar();
      });

      region.addEventListener("mouseenter", frenar);
      region.addEventListener("mouseleave", arrancar);
      region.addEventListener("focusin", frenar);
      region.addEventListener("focusout", (evento) => {
        if (!region.contains(evento.relatedTarget)) arrancar();
      });
      document.addEventListener("visibilitychange", () => {
        if (document.hidden) frenar();
        else arrancar();
      });

      arrancar();
    })();
  </script>

  {/* Lleva el foco al aviso de estado para que los lectores de pantalla lo anuncien. */}
  <script is:inline>
    (() => {
      const estado = document.getElementById("estado-contacto");
      if (estado && estado.textContent.trim() !== "") estado.focus();
    })();
  </script>

  {/* Mejora progresiva: si hay JS, el boton de WhatsApp lleva lo que ya escribiste. */}
  <script is:inline>
    (() => {
      const formulario = document.getElementById("formulario-contacto");
      const enlace = document.getElementById("enlace-whatsapp");
      if (!formulario || !enlace) return;

      const numero = enlace.dataset.whatsapp;

      enlace.addEventListener("click", (evento) => {
        const datos = new FormData(formulario);
        const nombre = String(datos.get("nombre") ?? "").trim();
        const asunto = String(datos.get("asunto") ?? "").trim();
        const mensaje = String(datos.get("mensaje") ?? "").trim();
        if (!nombre && !asunto && !mensaje) return; // sin datos, vale el enlace generico

        const lineas = ["Hola, soy " + (nombre || "un interesado") + "."];
        if (asunto) lineas.push("Asunto: " + asunto);
        if (mensaje) lineas.push(mensaje);

        evento.preventDefault();
        window.open(
          "https://wa.me/" + numero + "?text=" + encodeURIComponent(lineas.join("\n")),
          "_blank",
          "noopener",
        );
      });
    })();
  </script>
</Layout>
