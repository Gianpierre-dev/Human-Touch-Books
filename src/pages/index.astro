                      <dl class="mt-3 space-y-1 text-[0.8125rem] text-ink/75">
                        {libro.autor && (
                          <div class="flex gap-1.5">
                            <dt class="font-semibold text-ink">Autor:</dt>
                            <dd>{libro.autor}</dd>
