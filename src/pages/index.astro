    <!-- PLAN LECTOR -->
    {
      literatura.length > 0 && (
        <section
          id="plan-lector"
          class="border-t border-line bg-surface py-16 md:py-20"
          aria-labelledby="titulo-plan-lector"
        >
          <div class="mx-auto max-w-6xl px-4 md:px-8">
            <div class="reveal-scroll">
              <span class="text-xs font-bold tracking-[0.2em] text-brand uppercase">
                Línea de literatura
              </span>
              <h2
                id="titulo-plan-lector"
                class="mt-2 text-[clamp(1.7rem,3.4vw,2.4rem)] font-display leading-tight font-bold text-ink"
