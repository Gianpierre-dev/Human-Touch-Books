---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ErrorCampo from "../components/ErrorCampo.astro";
import { bd } from "../lib/bd";
import {
  ESPACIO_NOSOTROS,
  ESPACIO_PLATAFORMA,
  HERO_POR_DEFECTO,
  SUBTITULO_HERO_POR_DEFECTO,
  textoNosotrosPorDefecto,
  type EspacioImagen,
} from "../lib/contenido";

export const prerender = false;

// Catalogo y ajustes administrados desde el panel (/admin)
const libros = await bd.libro.findMany({
  where: { destacado: true },
  orderBy: [{ linea: "asc" }, { orden: "asc" }],
});

// Cada linea del catalogo se muestra en su propio bloque: mezclarlas en una sola
// tira obligaba a la visitante a adivinar que es texto escolar y que es lectura.
const escolares = libros.filter((l) => l.linea === "escolar");
const literatura = libros.filter((l) => l.linea === "literatura");

const gradosEscolares = escolares.map((l) => l.grado).filter((g): g is string => Boolean(g));
const primerGrado = gradosEscolares.at(0);
const ultimoGrado = gradosEscolares.at(-1);
// Subtitulo comun de la serie: viene del catalogo, no se inventa aqui.
const subtituloSerie = escolares.at(0)?.subtitulo ?? "";

const filasAjustes = await bd.ajuste.findMany();
const ajustes = Object.fromEntries(filasAjustes.map((a) => [a.clave, a.valor]));
const whatsapp = ajustes.whatsapp ?? "51982953436";
const correoContacto = ajustes.correo_contacto ?? "informes@humantouchbooks.pe";
const horarios = (ajustes.horario ?? "Lunes a viernes: 8:00 a. m. – 5:00 p. m.").split("|");
const ubicacion = ajustes.ubicacion ?? "La Molina, Lima — Perú";
const whatsappVisible = `+${whatsapp.slice(0, 2)} ${whatsapp.slice(2, 5)} ${whatsapp.slice(5, 8)} ${whatsapp.slice(8)}`;
const subtituloHero = ajustes.hero_subtitulo ?? SUBTITULO_HERO_POR_DEFECTO;
const textoNosotros = ajustes.nosotros_texto ?? textoNosotrosPorDefecto(ubicacion);

// Portada: sin imagenes cargadas se mantiene la del diseno original; con una se
// muestra fija y con dos o mas se arma el carrusel.
const imagenesHero = await bd.imagenHero.findMany({
  where: { activa: true },
  orderBy: [{ orden: "asc" }, { creadoEn: "asc" }],
});
const hayCarrusel = imagenesHero.length > 1;
const totalDiapositivas = imagenesHero.length;

// Imagenes de secciones fijas: cada espacio cae al archivo del repositorio
// mientras no se cargue una imagen desde el panel.
const imagenesSitio = await bd.imagenSitio.findMany();
const imagenPorClave = new Map(imagenesSitio.map((imagen) => [imagen.clave, imagen]));

interface ImagenResuelta {
  imagenUrl: string;
  altTexto: string;
  ancho: number;
  alto: number;
}

interface FilaImagenSitio {
  imagenUrl: string;
  altTexto: string;
  ancho: number | null;
  alto: number | null;
}

// Las medidas mandan la proporcion del hueco reservado: se usan las reales de la
// imagen cargada y, si falta la fila (o es anterior a que se guardaran), las del
// archivo del repositorio.
function resolverImagen(espacio: EspacioImagen, fila: FilaImagenSitio | undefined): ImagenResuelta {
  if (!fila) {
    return {
      imagenUrl: espacio.imagenUrl,
      altTexto: espacio.altTexto,
      ancho: espacio.ancho,
      alto: espacio.alto,
    };
  }
  return {
    imagenUrl: fila.imagenUrl,
    altTexto: fila.altTexto,
    ancho: fila.ancho ?? espacio.ancho,
    alto: fila.alto ?? espacio.alto,
  };
}

const retrato = resolverImagen(ESPACIO_NOSOTROS, imagenPorClave.get(ESPACIO_NOSOTROS.clave));
const imagenPlataforma = resolverImagen(
  ESPACIO_PLATAFORMA,
  imagenPorClave.get(ESPACIO_PLATAFORMA.clave),
);

// Resultado del envio del formulario (lo define /api/contacto al redirigir)
const estadoContacto = Astro.url.searchParams.get("contacto");
const campoConError = Astro.url.searchParams.get("campo") ?? "";

const MENSAJES_ERROR: Record<string, string> = {
  nombre: "Revisa tu nombre: es obligatorio y admite hasta 120 caracteres.",
  correo: "Revisa tu correo electrónico: no tiene un formato válido.",
  telefono: "Revisa tu teléfono: debe tener al menos 6 dígitos (puedes usar +, espacios y paréntesis).",
  asunto: "Selecciona un asunto para tu consulta.",
  mensaje: "Escribe tu mensaje: es obligatorio y admite hasta 2000 caracteres.",
  tamano: "El formulario es demasiado extenso. Acorta tu mensaje e inténtalo de nuevo.",
  limite: "Recibimos varios envíos desde tu conexión. Espera unos minutos o escríbenos por WhatsApp.",
};

const MENSAJE_ERROR_GENERICO =
  "No pudimos enviar tu mensaje. Inténtalo de nuevo o escríbenos por WhatsApp.";
const textoError = MENSAJES_ERROR[campoConError] ?? MENSAJE_ERROR_GENERICO;

// El banner de arriba anuncia el fallo, pero un lector de pantalla que recorre
// el formulario campo por campo no lo vuelve a oir. Marcamos ademas el campo
// culpable con aria-invalid y le colgamos su mensaje con aria-describedby.
// Solo aplica a los campos reales del formulario: "tamano" y "limite" describen
// el envio completo, no un campo, y se quedan solo en el banner.
const CAMPOS_DEL_FORMULARIO = ["nombre", "correo", "telefono", "asunto", "mensaje"] as const;
type CampoFormulario = (typeof CAMPOS_DEL_FORMULARIO)[number];

const campoInvalido = (CAMPOS_DEL_FORMULARIO as readonly string[]).includes(campoConError)
  ? (campoConError as CampoFormulario)
  : null;

/** Atributos de validacion del campo: vacios salvo que este sea el que fallo. */
function estadoCampo(campo: CampoFormulario) {
  if (campo !== campoInvalido) return {};
  return { "aria-invalid": "true", "aria-describedby": `error-${campo}` };
}

// Espeja la validacion del servidor. Va como constante porque escrito directo en
// el atributo Astro se come los backslashes y el patron queda mal ("\s" -> "s").
// Los parentesis van escapados: el flag `v` del atributo pattern los prohibe sueltos.
const PATRON_TELEFONO = "(?=(?:\\D*\\d){6,})[\\d\\s+\\(\\)\\-]{7,20}";

// Sin JavaScript el boton de WhatsApp abre una conversacion con texto generico.
const TEXTO_WHATSAPP = "Hola, quiero información sobre el proyecto Tutoría SMART 2027.";
const enlaceWhatsappGenerico = `https://wa.me/${whatsapp}?text=${encodeURIComponent(TEXTO_WHATSAPP)}`;

const clasesCampo =
  "mt-1.5 min-h-[44px] w-full rounded-lg border border-line bg-paper px-3.5 py-3 text-sm outline-none placeholder:text-ink/65 focus-visible:border-brand focus-visible:ring-2 focus-visible:ring-brand/30 aria-[invalid]:border-accent-deep aria-[invalid]:ring-2 aria-[invalid]:ring-accent/25";

const valores = [
  {
    icono: "M12 3 2 8l10 5 8-4v5h2V8L12 3Zm-6 9v4c0 1.7 2.7 3 6 3s6-1.3 6-3v-4l-6 3-6-3Z",
    titulo: "Aprendizaje significativo",
    texto:
      "Metodologías activas que llevan a tus estudiantes de la explicación a la comprensión y la reflexión.",
  },
  {
    icono: "M16 11c1.7 0 3-1.3 3-3s-1.3-3-3-3-3 1.3-3 3 1.3 3 3 3Zm-8 0c1.7 0 3-1.3 3-3S9.7 5 8 5 5 6.3 5 8s1.3 3 3 3Zm0 2c-2.3 0-7 1.2-7 3.5V19h14v-2.5c0-2.3-4.7-3.5-7-3.5Zm8 0c-.3 0-.6 0-1 .1 1.2.8 2 2 2 3.4V19h6v-2.5c0-2.3-4.7-3.5-7-3.5Z",
    titulo: "Habilidades para convivir",
    texto:
      "Sesiones que fortalecen las competencias socioemocionales y de convivencia dentro del aula.",
  },
  {
    icono: "M12 2 4.5 20.3l.7.7L12 18l6.8 3 .7-.7L12 2Z",
    titulo: "Preparados para decidir",
    texto:
      "Herramientas para acompañar la toma de decisiones y la construcción del proyecto de vida.",
  },
  {
    icono: "M12 21s-7.5-4.8-9.5-9C1 8.5 3 5.5 6 5.5c1.8 0 3.2 1 4 2.2.8-1.2 2.2-2.2 4-2.2 3 0 5 3 3.5 6.5-2 4.2-9.5 9-9.5 9Z",
    titulo: "Un texto por cada grado",
    texto:
      "Materiales y recursos graduados para que la tutoría tenga continuidad en todos los años de primaria.",
  },
];

const chipsPlataforma = [
  {
    color: "#124a99",
    bg: "#e8f1fd",
    icono: "M16 11c1.7 0 3-1.3 3-3s-1.3-3-3-3-3 1.3-3 3 1.3 3 3 3Zm-8 0c1.7 0 3-1.3 3-3S9.7 5 8 5 5 6.3 5 8s1.3 3 3 3Zm0 2c-2.3 0-7 1.2-7 3.5V19h14v-2.5c0-2.3-4.7-3.5-7-3.5Zm8 0c-.3 0-.6 0-1 .1 1.2.8 2 2 2 3.4V19h6v-2.5c0-2.3-4.7-3.5-7-3.5Z",
    titulo: "Comunidad conectada",
    texto: "Docentes, directores, familias y alumnos en un mismo espacio.",
  },
  {
    color: "#12803c",
    bg: "#e8f7ee",
    icono: "M12 3 2 8l10 5 8-4v5h2V8L12 3Zm-6 9v4c0 1.7 2.7 3 6 3s6-1.3 6-3v-4l-6 3-6-3Z",
    titulo: "Recursos educativos",
    texto: "Material de la colección disponible cuando lo necesitas.",
  },
  {
    color: "#5b21b6",
    bg: "#f1eafd",
    icono: "M12 2 4 5v6c0 5 3.4 9.7 8 11 4.6-1.3 8-6 8-11V5l-8-3Zm-1 14-3.5-3.5 1.4-1.4L11 13.2l4.6-4.6 1.4 1.4L11 16Z",
    titulo: "Entorno seguro",
    texto: "Protegemos tu información y la de tus estudiantes.",
  },
  {
    color: "#a15c00",
    bg: "#fdf3e0",
    icono: "M20 2H4a2 2 0 0 0-2 2v18l4-4h14a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2Z",
    titulo: "Comunicación eficiente",
    texto: "Mensajería y avisos en tiempo real.",
  },
];

// Preguntas frecuentes: se administran desde el panel. Mientras la tabla este
// vacia se usan estas, calculadas con datos que ya viven en la base (catalogo,
// ajustes de contacto) o en el propio formulario. Nada nuevo.
interface PreguntaVista {
  pregunta: string;
  respuesta: string;
  enlace?: { href: string; texto: string };
}

const preguntasPorDefecto: PreguntaVista[] = [
  {
    pregunta: "¿Para qué grados está disponible la colección?",
    respuesta:
      primerGrado && ultimoGrado
        ? `Tutoría SMART reúne ${escolares.length} títulos, uno por grado: de ${primerGrado} a ${ultimoGrado}.` +
          (literatura.length > 0 ? " Además contamos con una línea de Plan Lector." : "")
        : "Escríbenos y te enviamos el detalle de los títulos disponibles.",
  },
  {
    pregunta: "¿Trabajan con colegios o también con padres de familia?",
    respuesta:
      "Con ambos. En el formulario puedes elegir información para colegios, información para padres de familia o capacitaciones y talleres.",
  },
  {
    pregunta: "¿Cómo solicito información o una cotización?",
    respuesta: `Completa el formulario de contacto, escríbenos a ${correoContacto} o contáctanos por WhatsApp al ${whatsappVisible}.`,
    enlace: { href: "#contacto", texto: "Ir al formulario" },
  },
  {
    pregunta: "¿Dónde están y en qué horario atienden?",
    respuesta: `Estamos en ${ubicacion}. Horario de atención: ${horarios.map((h) => h.trim()).join(" · ")}.`,
  },
  {
    pregunta: "¿Cómo se accede a la plataforma Tutoría SMART?",
    respuesta:
      "La plataforma se habilita para las instituciones que trabajan con la editorial. Solicita el acceso desde el formulario y lo coordinamos con tu colegio.",
    enlace: { href: "#contacto", texto: "Solicitar acceso" },
  },
];

const preguntasCargadas = await bd.pregunta.findMany({
  where: { activa: true },
  orderBy: [{ orden: "asc" }, { creadoEn: "asc" }],
});

const preguntas: PreguntaVista[] =
  preguntasCargadas.length > 0
    ? preguntasCargadas.map((p) => ({
        pregunta: p.pregunta,
        respuesta: p.respuesta,
        ...(p.enlaceHref && p.enlaceTexto
          ? { enlace: { href: p.enlaceHref, texto: p.enlaceTexto } }
          : {}),
      }))
    : preguntasPorDefecto;
---

<Layout
  title="Tutoría SMART 2027 — Human Touch Books"
  description="Proyecto Tutoría SMART 2027: programa de tutoría y convivencia escolar para colegios y familias. Formación integral para una nueva generación."
  anclaContenido="#inicio"
>
  <Header whatsapp={whatsapp} hayColeccion={escolares.length > 0} />

  <main id="inicio" tabindex="-1">
    <!-- HERO -->
    <section class="relative overflow-hidden bg-navy text-white" aria-labelledby="titulo-hero">
      <div
        class="pointer-events-none absolute inset-0 bg-[radial-gradient(60rem_30rem_at_110%_-10%,#1e6fd955,transparent_60%),radial-gradient(40rem_24rem_at_-10%_110%,#35a3f533,transparent_60%)]"
        aria-hidden="true"
      >
      </div>
      <div
        class="relative mx-auto grid max-w-6xl items-center gap-10 px-4 py-14 md:grid-cols-[1.05fr_0.95fr] md:px-8 md:py-20"
      >
        <div class="reveal">
          <span
            class="inline-flex items-center rounded-full bg-brand-bright/20 px-4 py-1 text-xs font-bold tracking-[0.2em] text-white uppercase"
          >
            Proyecto
          </span>
          <h1
            id="titulo-hero"
            class="mt-4 text-[clamp(2.4rem,5.5vw,3.9rem)] leading-[1.02] font-extrabold tracking-tight"
          >
            TUTORÍA SMART<br />
            <span class="text-brand-bright">2027</span>
          </h1>
          <p class="mt-3 text-lg font-semibold text-brand-bright/95">
            {subtituloHero}
          </p>
          <p class="mt-4 max-w-[52ch] leading-relaxed text-white/80">
            Programa de tutoría y convivencia escolar diseñado para fortalecer habilidades
            socioemocionales, liderazgo y proyecto de vida.
          </p>

          {/* El CTA de conversion va primero y con el mayor peso visual disponible
              sobre el navy: pastilla blanca solida. Explorar la coleccion es la
              accion secundaria. */}
          <div class="mt-8 flex flex-wrap items-center gap-3.5">
            <a
              href="#contacto"
              class="foco-claro inline-flex min-h-[52px] items-center gap-2.5 rounded-full bg-white px-8 text-[0.95rem] font-extrabold text-navy shadow-[0_12px_28px_-10px_rgba(0,0,0,0.65)] ring-1 ring-white/70 transition duration-300 ease-out hover:-translate-y-0.5 hover:bg-brand-bright hover:text-navy hover:shadow-[0_18px_34px_-12px_rgba(53,163,245,0.75)]"
            >
              <svg viewBox="0 0 24 24" class="h-4.5 w-4.5 fill-brand" aria-hidden="true">
                <path d="M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2Zm0 4-8 5-8-5V6l8 5 8-5v2Z" />
              </svg>
              Solicitar información
            </a>
            <a
              href="#coleccion"
              class="foco-claro inline-flex min-h-[52px] items-center gap-2 rounded-full border border-white/45 px-7 text-[0.95rem] font-bold text-white transition-colors hover:border-white hover:bg-white/10"
            >
              <svg viewBox="0 0 24 24" class="h-4 w-4 fill-current" aria-hidden="true">
                <path d="M18 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2Zm-6 2 4 0v7l-2-1.5L12 11V4Z" />
              </svg>
              Conocer la colección
            </a>
          </div>

          <p class="mt-6 flex items-start gap-2.5 text-[0.85rem] leading-relaxed text-white/75">
            <svg viewBox="0 0 24 24" class="mt-0.5 h-4 w-4 shrink-0 fill-brand-bright" aria-hidden="true">
              <path d="M12 2 4 5v6c0 5 3.4 9.7 8 11 4.6-1.3 8-6 8-11V5l-8-3Zm-1 14-3.5-3.5 1.4-1.4L11 13.2l4.6-4.6 1.4 1.4L11 16Z" />
            </svg>
            <span>
              Con el respaldo académico de <strong class="font-semibold text-white"
                >Rafael Bisquerra Alzina</strong
              >, referente internacional en educación emocional.
            </span>
          </p>
        </div>

        {/* Portada: administrable desde /admin/portada. Sin imagenes cargadas se
            mantiene la imagen del mock aprobado, recortada para quitar los restos
            de tipografia de la maqueta original (ver scripts/limpiar-mocks.mjs). */}
        <div class="relative mx-auto w-full max-w-lg">
          {
            totalDiapositivas === 0 ? (
              <div class="relative overflow-hidden rounded-2xl shadow-2xl ring-1 ring-white/15">
                <img
                  src={HERO_POR_DEFECTO.imagenUrl}
                  alt={HERO_POR_DEFECTO.altTexto}
                  class="block w-full"
                  width={HERO_POR_DEFECTO.ancho}
                  height={HERO_POR_DEFECTO.alto}
                  loading="eager"
                  fetchpriority="high"
                />
                <div
                  class="pointer-events-none absolute inset-0"
                  style="background: linear-gradient(100deg, #0a255066 0%, #0a255022 34%, transparent 62%);"
                  aria-hidden="true"
                />
              </div>
            ) : (
              // Con una sola imagen esto no es un carrusel y no debe anunciarse
              // como tal: sin controles, el rol solo confundiría.
              <div
                id="hero-carrusel"
                class="relative"
                role={hayCarrusel ? "group" : undefined}
                aria-roledescription={hayCarrusel ? "carrusel" : undefined}
                aria-label={hayCarrusel ? "Imágenes del proyecto Tutoría SMART" : undefined}
              >
                {/* El marco conserva la proporcion de la imagen original: la
                    portada ocupa el mismo lugar y tamano que antes y no hay
                    salto de maquetado al cargar cada imagen. */}
                <div
                  id="hero-pista"
                  class="hero-pista flex overflow-x-auto overscroll-x-contain rounded-2xl shadow-2xl ring-1 ring-white/15"
                >
                  {imagenesHero.map((imagen, indice) => (
                    <div
                      id={`hero-imagen-${indice + 1}`}
                      data-diapositiva
                      class="hero-diapositiva relative w-full shrink-0"
                      role={hayCarrusel ? "group" : undefined}
                      aria-roledescription={hayCarrusel ? "diapositiva" : undefined}
                      aria-label={hayCarrusel ? `${indice + 1} de ${totalDiapositivas}` : undefined}
                    >
                      <img
                        src={imagen.imagenUrl}
                        alt={imagen.altTexto}
                        class="block aspect-[505/336] w-full object-cover"
                        width={HERO_POR_DEFECTO.ancho}
                        height={HERO_POR_DEFECTO.alto}
                        loading={indice === 0 ? "eager" : "lazy"}
                        fetchpriority={indice === 0 ? "high" : undefined}
                      />
                      <div
                        class="pointer-events-none absolute inset-0"
                        style="background: linear-gradient(100deg, #0a255066 0%, #0a255022 34%, transparent 62%);"
                        aria-hidden="true"
                      />
                      {hayCarrusel && (
                        <div
                          data-flechas-ancla
                          class="pointer-events-none absolute inset-0 flex items-center justify-between px-2"
                        >
                          <a
                            href={`#hero-imagen-${indice === 0 ? totalDiapositivas : indice}`}
                            class="hero-control foco-claro pointer-events-auto"
                            aria-label={`Ver imagen ${indice === 0 ? totalDiapositivas : indice} de ${totalDiapositivas}`}
                          >
                            <svg viewBox="0 0 24 24" class="h-5 w-5 fill-current" aria-hidden="true">
                              <path d="M15 5 8 12l7 7V5Z" />
                            </svg>
                          </a>
                          <a
                            href={`#hero-imagen-${indice + 2 > totalDiapositivas ? 1 : indice + 2}`}
                            class="hero-control foco-claro pointer-events-auto"
                            aria-label={`Ver imagen ${indice + 2 > totalDiapositivas ? 1 : indice + 2} de ${totalDiapositivas}`}
                          >
                            <svg viewBox="0 0 24 24" class="h-5 w-5 fill-current" aria-hidden="true">
                              <path d="M9 5l7 7-7 7V5Z" />
                            </svg>
                          </a>
                        </div>
                      )}
                    </div>
                  ))}
                </div>

                {hayCarrusel && (
                  <>
                    {/* Par unico de flechas: solo con JavaScript, que es cuando
                        se sabe que diapositiva esta a la vista. */}
                    <div
                      id="hero-controles"
                      class="pointer-events-none absolute inset-0 flex items-center justify-between px-2"
                      hidden
                    >
                      <button
                        type="button"
                        id="hero-anterior"
                        class="hero-control foco-claro pointer-events-auto"
                        aria-label="Imagen anterior"
                      >
                        <svg viewBox="0 0 24 24" class="h-5 w-5 fill-current" aria-hidden="true">
                          <path d="M15 5 8 12l7 7V5Z" />
                        </svg>
                      </button>
                      <button
                        type="button"
                        id="hero-siguiente"
                        class="hero-control foco-claro pointer-events-auto"
                        aria-label="Imagen siguiente"
                      >
                        <svg viewBox="0 0 24 24" class="h-5 w-5 fill-current" aria-hidden="true">
                          <path d="M9 5l7 7-7 7V5Z" />
                        </svg>
                      </button>
                    </div>

                    <div class="mt-2 flex flex-wrap items-center justify-center gap-x-1 gap-y-1">
                      {imagenesHero.map((_, indice) => (
                        <a
                          href={`#hero-imagen-${indice + 1}`}
                          data-punto
                          class="foco-claro grid h-11 w-11 place-items-center"
                          aria-label={`Ver imagen ${indice + 1} de ${totalDiapositivas}`}
                        >
                          <span class="hero-punto" />
                        </a>
                      ))}
                      <button
                        type="button"
                        id="hero-pausa"
                        hidden
                        aria-pressed="false"
                        class="foco-claro ml-1 inline-flex min-h-[44px] items-center gap-1.5 rounded-full border border-white/40 px-4 text-xs font-bold text-white transition-colors hover:bg-white/10"
                      >
                        Pausar
                      </button>
                    </div>
                  </>
                )}
              </div>
            )
          }
        </div>
      </div>
    </section>

