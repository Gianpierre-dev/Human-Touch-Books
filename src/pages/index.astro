            {
              estadoContacto === "ok" && (
                <p class="mb-4 rounded-xl border border-wa/30 bg-wa/10 px-4 py-3 text-sm font-semibold text-wa-deep">
                  Recibimos tu mensaje. Te contactaremos pronto.
                </p>
              )
            }
            {
              estadoContacto === "error" && (
                <p class="mb-4 rounded-xl border border-accent/30 bg-accent/10 px-4 py-3 text-sm font-semibold text-accent-deep">
                  {textoError}
                </p>
              )
            }
          </div>

          <form
            id="formulario-contacto"
            class="rounded-2xl bg-surface p-6 shadow-md ring-1 ring-line md:p-8"
            action="/api/contacto"
            method="post"
          >
            <h3 class="text-lg font-bold text-ink">Envíanos tu mensaje</h3>
            <div class="mt-5 grid gap-4 sm:grid-cols-2">
              <label class="block">
                <span class="text-sm font-semibold text-ink">Nombre completo <span class="text-accent">*</span></span>
                <input
                  type="text"
                  name="nombre"
                  required
                  maxlength="120"
                  autocomplete="name"
                  placeholder="Escribe tu nombre"
                  class={clasesCampo}
                  {...estadoCampo("nombre")}
                />
                {campoInvalido === "nombre" && <ErrorCampo campo="nombre" mensaje={textoError} />}
              </label>
              <label class="block">
                <span class="text-sm font-semibold text-ink">Correo electrónico <span class="text-accent">*</span></span>
                <input
                  type="email"
                  name="correo"
                  required
                  maxlength="160"
                  autocomplete="email"
                  spellcheck="false"
                  placeholder="ejemplo@correo.com"
                  class={clasesCampo}
                  {...estadoCampo("correo")}
                />
                {campoInvalido === "correo" && <ErrorCampo campo="correo" mensaje={textoError} />}
              </label>
              <label class="block">
                <span class="text-sm font-semibold text-ink">Teléfono <span class="text-accent">*</span></span>
                <input
                  type="tel"
                  name="telefono"
                  required
                  maxlength="20"
                  autocomplete="tel"
                  inputmode="tel"
                  pattern={PATRON_TELEFONO}
                  title="Entre 7 y 20 caracteres, con al menos 6 dígitos. Puedes usar espacios, +, paréntesis y guiones."
                  placeholder="Ej. 987 654 321"
                  class={clasesCampo}
                  {...estadoCampo("telefono")}
                />
                {campoInvalido === "telefono" && <ErrorCampo campo="telefono" mensaje={textoError} />}
              </label>
              <label class="block">
                <span class="text-sm font-semibold text-ink">Asunto <span class="text-accent">*</span></span>
                <select
                  name="asunto"
                  required
                  class={`${clasesCampo} text-ink`}
                  {...estadoCampo("asunto")}
