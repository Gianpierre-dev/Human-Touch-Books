                  spellcheck="false"
                  placeholder="ejemplo@correo.com"
                  class={clasesCampo}
                  {...estadoCampo("correo")}
                />
                {campoInvalido === "correo" && <ErrorCampo campo="correo" mensaje={textoError} />}
              </label>
              <label class="block">
                <span class="text-sm font-semibold text-ink">Teléfono <span class="text-accent">*</span></span>
