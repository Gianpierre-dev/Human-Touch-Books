    descripcion={textos.pie_descripcion}
  />

  {/*
    Carrusel de la portada: mejora progresiva sobre un fondo de capas.
    Sin JavaScript queda fija la primera imagen y los controles ni aparecen:
    no existe la mecanica de fundido que podrian manejar. Con el, flechas,
    puntos y avance automatico, que solo arranca si la persona no pidio
    reducir el movimiento y se frena con hover, foco dentro o cualquier
    interaccion.
  */}
  <script is:inline>
    (() => {
      const region = document.getElementById("hero-carrusel");
      const fondo = document.getElementById("hero-fondo");
      const controles = document.getElementById("hero-controles");
      if (!region || !fondo || !controles) return;

      const diapositivas = Array.from(fondo.querySelectorAll("[data-diapositiva]"));
      const total = diapositivas.length;
      if (total < 2) return;

      const anterior = document.getElementById("hero-anterior");
      const siguiente = document.getElementById("hero-siguiente");
      const pausa = document.getElementById("hero-pausa");
      const puntos = Array.from(controles.querySelectorAll("[data-punto]"));
      if (!anterior || !siguiente) return;

      controles.hidden = false;

      const animacionPermitida = window.matchMedia("(prefers-reduced-motion: no-preference)").matches;
      const INTERVALO = 6500;

      let indice = 0;
      let temporizador = null;
      let detenido = false;

      const marcar = () => {
        puntos.forEach((punto, posicion) => {
          if (posicion === indice) punto.setAttribute("aria-current", "true");
          else punto.removeAttribute("aria-current");
        });
      };

      // El fundido lo hace el CSS: aqui solo se mueve la marca de visible.
      const irA = (destino) => {
        indice = (destino + total) % total;
        diapositivas.forEach((diapositiva, posicion) => {
          diapositiva.toggleAttribute("data-visible", posicion === indice);
        });
        marcar();
      };

      const frenar = () => {
        if (temporizador === null) return;
        window.clearInterval(temporizador);
        temporizador = null;
      };

      const arrancar = () => {
        if (!animacionPermitida || detenido || temporizador !== null) return;
        temporizador = window.setInterval(() => irA(indice + 1), INTERVALO);
      };

      // Cualquier interaccion deliberada detiene el avance automatico: quien
      // esta mirando manda, y el boton queda listo para reanudarlo.
      const detenerPorPersona = () => {
        if (detenido) return;
        detenido = true;
        frenar();
        if (pausa) {
          pausa.setAttribute("aria-pressed", "true");
          pausa.textContent = "Reanudar";
        }
      };

      anterior.addEventListener("click", () => {
        detenerPorPersona();
        irA(indice - 1);
      });
      siguiente.addEventListener("click", () => {
        detenerPorPersona();
        irA(indice + 1);
      });

      puntos.forEach((punto, posicion) => {
        punto.addEventListener("click", () => {
          detenerPorPersona();
          irA(posicion);
        });
      });

      marcar();

      if (!animacionPermitida || !pausa) return;

      pausa.hidden = false;
      pausa.addEventListener("click", () => {
        if (!detenido) {
          detenerPorPersona();
          return;
        }
        detenido = false;
        pausa.setAttribute("aria-pressed", "false");
        pausa.textContent = "Pausar";
        arrancar();
      });

      region.addEventListener("mouseenter", frenar);
      region.addEventListener("mouseleave", arrancar);
      region.addEventListener("focusin", frenar);
      region.addEventListener("focusout", (evento) => {
        if (!region.contains(evento.relatedTarget)) arrancar();
      });
      document.addEventListener("visibilitychange", () => {
        if (document.hidden) frenar();
        else arrancar();
      });

      arrancar();
    })();
  </script>

  {/* Lleva el foco al aviso de estado para que los lectores de pantalla lo anuncien. */}
  <script is:inline>
    (() => {
      const estado = document.getElementById("estado-contacto");
      if (estado && estado.textContent.trim() !== "") estado.focus();
    })();
  </script>

  {/* Mejora progresiva: si hay JS, el boton de WhatsApp lleva lo que ya escribiste. */}
  <script is:inline>
    (() => {
      const formulario = document.getElementById("formulario-contacto");
      const enlace = document.getElementById("enlace-whatsapp");
      if (!formulario || !enlace) return;

      const numero = enlace.dataset.whatsapp;

      enlace.addEventListener("click", (evento) => {
        const datos = new FormData(formulario);
        const nombre = String(datos.get("nombre") ?? "").trim();
        const asunto = String(datos.get("asunto") ?? "").trim();
        const mensaje = String(datos.get("mensaje") ?? "").trim();
        if (!nombre && !asunto && !mensaje) return; // sin datos, vale el enlace generico

        const lineas = ["Hola, soy " + (nombre || "un interesado") + "."];
        if (asunto) lineas.push("Asunto: " + asunto);
        if (mensaje) lineas.push(mensaje);

        evento.preventDefault();
        window.open(
          "https://wa.me/" + numero + "?text=" + encodeURIComponent(lineas.join("\n")),
          "_blank",
          "noopener",
        );
      });
    })();
  </script>
</Layout>
