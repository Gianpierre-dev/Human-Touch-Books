---
import PanelLayout from "../../layouts/PanelLayout.astro";
import { bd } from "../../lib/bd";
import { LIMITES, SUBTITULO_HERO_POR_DEFECTO, textoNosotrosPorDefecto } from "../../lib/contenido";

export const prerender = false;

const filas = await bd.ajuste.findMany();
const ajustes = Object.fromEntries(filas.map((a) => [a.clave, a.valor]));
const ok = Astro.url.searchParams.get("ok");
const error = Astro.url.searchParams.get("error");

const MENSAJES_ERROR: Record<string, string> = {
  largo: `Revisa los textos: el subtítulo admite hasta ${LIMITES.subtituloHero} caracteres y el párrafo de Nosotros hasta ${LIMITES.textoNosotros}.`,
};

const ubicacion = ajustes.ubicacion ?? "La Molina, Lima — Perú";

const clasesCampo =
  "mt-1.5 min-h-[44px] w-full rounded-lg border border-line bg-paper px-3.5 py-2.5 text-sm outline-none focus-visible:border-brand focus-visible:ring-2 focus-visible:ring-brand/30";
---

<PanelLayout titulo="Ajustes" correo={Astro.locals.sesion?.correo}>
  <h1 class="text-2xl font-extrabold text-ink">Ajustes del sitio</h1>
  <p class="mt-1 mb-6 text-sm text-ink/70">
    Datos de contacto y textos que se muestran en la página web.
  </p>

  {
    ok && (
      <p class="mb-5 rounded-lg bg-wa/10 px-4 py-2.5 text-sm font-semibold text-[#15803d]">
        Cambios guardados.
      </p>
    )
  }
  {
    error && (
      <p class="mb-5 rounded-lg bg-accent/10 px-4 py-2.5 text-sm font-semibold text-accent-deep">
        {MENSAJES_ERROR[error] ?? "No pudimos guardar los cambios."}
      </p>
    )
  }

  <form
    method="post"
    action="/api/admin/ajustes"
    class="max-w-xl rounded-xl border border-line bg-surface p-6 shadow-sm md:p-8"
  >
    <label class="block">
      <span class="text-sm font-semibold text-ink">Correo de contacto</span>
      <input type="email" name="correo_contacto" value={ajustes.correo_contacto ?? ""} class={clasesCampo} />
    </label>
    <label class="mt-4 block">
      <span class="text-sm font-semibold text-ink">WhatsApp (solo números, con 51)</span>
      <input type="text" name="whatsapp" value={ajustes.whatsapp ?? ""} class={clasesCampo} />
    </label>
    <label class="mt-4 block">
      <span class="text-sm font-semibold text-ink">Horario de atención</span>
      <input type="text" name="horario" value={ajustes.horario ?? ""} class={clasesCampo} />
    </label>
    <label class="mt-4 block">
      <span class="text-sm font-semibold text-ink">Ubicación</span>
      <input type="text" name="ubicacion" value={ajustes.ubicacion ?? ""} class={clasesCampo} />
    </label>

    <h2 class="mt-8 border-t border-line pt-6 text-lg font-bold text-ink">Textos de la página</h2>

    {/* Estos dos campos van VACIOS cuando no hay valor propio: el texto que se
        ve en gris es el que la web usa por defecto y se calcula solo (el de
        Nosotros incluye la ubicación de arriba). Si se precargara como valor,
        al guardar cualquier otro ajuste se congelaría ese texto para siempre. */}
    <label class="mt-4 block">
      <span class="text-sm font-semibold text-ink">Subtítulo de la portada</span>
      <input
        type="text"
        name="hero_subtitulo"
        maxlength={LIMITES.subtituloHero}
        value={ajustes.hero_subtitulo ?? ""}
        placeholder={SUBTITULO_HERO_POR_DEFECTO}
        aria-describedby="ayuda-hero-subtitulo"
        class={clasesCampo}
      />
    </label>
    <p id="ayuda-hero-subtitulo" class="mt-1.5 text-xs text-ink/70">
      Se muestra bajo el titular principal. Hasta {LIMITES.subtituloHero} caracteres. Déjalo vacío
      para usar el texto por defecto.
    </p>

    <label class="mt-4 block">
      <span class="text-sm font-semibold text-ink">Texto de la sección Nosotros</span>
      {/* Sin saltos de línea alrededor: el contenido del textarea ES su valor. */}
      <textarea
        name="nosotros_texto"
        rows="4"
        maxlength={LIMITES.textoNosotros}
        placeholder={textoNosotrosPorDefecto(ubicacion)}
        aria-describedby="ayuda-nosotros-texto"
        class={clasesCampo}>{ajustes.nosotros_texto ?? ""}</textarea>
    </label>
    <p id="ayuda-nosotros-texto" class="mt-1.5 text-xs text-ink/70">
      Párrafo de presentación de la editorial. Hasta {LIMITES.textoNosotros} caracteres. Déjalo
      vacío para usar el texto por defecto, que incluye la ubicación de arriba.
    </p>

    <button
      type="submit"
      class="mt-6 rounded-full bg-brand px-7 py-2.5 text-sm font-bold text-white transition-colors hover:bg-brand-deep"
    >
      Guardar cambios
    </button>
  </form>
</PanelLayout>
