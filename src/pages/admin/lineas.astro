---
import PanelLayout from "../../layouts/PanelLayout.astro";
import { bd } from "../../lib/bd";
import {
  defectosContenidoLinea,
  ETIQUETA_TIPO_LINEA,
  LIMITES_CONTENIDO_LINEA,
  LIMITES_LINEA,
  type ContenidoLinea,
} from "../../lib/lineas";
import { CONTRASTE_MINIMO } from "../../lib/contraste";

export const prerender = false;

// El conteo de libros viaja en la misma consulta (`_count`): evita una consulta
// por linea al pintar la lista.
const lineas = await bd.linea.findMany({
  orderBy: [{ orden: "asc" }, { creadoEn: "asc" }],
  include: { _count: { select: { libros: true } } },
});
const activas = lineas.filter((linea) => linea.activa).length;
const sinLinea = await bd.libro.count({ where: { lineaId: null } });

const ok = Astro.url.searchParams.get("ok");
const error = Astro.url.searchParams.get("error");

const MENSAJES_OK: Record<string, string> = {
  creada: "Línea agregada.",
  guardada: "Cambios guardados.",
  eliminada:
    "Línea eliminada. Sus libros quedaron sin línea asignada y no se muestran en la web hasta que les asignes otra.",
  visible: "La línea quedó activa.",
  oculta: "La línea quedó desactivada.",
  reordenada: "Orden actualizado.",
  sincambios: "No había nada que cambiar.",
  contenido: "Contenido de la página guardado.",
  heroguardada: "Imagen del hero actualizada.",
  heroquitada: "Se quitó la imagen del hero. La página se sigue viendo, sin foto.",
};

const MENSAJES_ERROR: Record<string, string> = {
  sinnombre: "El nombre es obligatorio.",
  nombrelargo: `El nombre admite hasta ${LIMITES_LINEA.nombre} caracteres.`,
  sinetiqueta: "La etiqueta corta es obligatoria.",
  etiquetalarga: `La etiqueta corta admite hasta ${LIMITES_LINEA.etiquetaCorta} caracteres.`,
  sinclave: "La clave es obligatoria.",
  clavelarga: `La clave admite hasta ${LIMITES_LINEA.clave} caracteres.`,
  claveformato:
    "La clave solo admite minúsculas, números y guiones internos. Por ejemplo: tutoria-primaria.",
  claverepetida: "Ya existe otra línea con esa clave. Elige una diferente.",
  sindescripcion: "La descripción es obligatoria.",
  descripcionlarga: `La descripción admite hasta ${LIMITES_LINEA.descripcion} caracteres.`,
  color: "Elige un color de identidad válido.",
  colorcontraste: `Ese color no da contraste suficiente con texto blanco (mínimo ${CONTRASTE_MINIMO}:1). Elige uno más oscuro.`,
  orden: "El orden debe ser un número.",
  noexiste: "No encontramos esa línea.",
  accion: "No reconocimos la acción solicitada.",
  heroAntetitulolargo: `El antetítulo admite hasta ${LIMITES_CONTENIDO_LINEA.heroAntetitulo} caracteres.`,
  heroTitulolargo: `El título del hero admite hasta ${LIMITES_CONTENIDO_LINEA.heroTitulo} caracteres.`,
  heroParrafolargo: `El párrafo del hero admite hasta ${LIMITES_CONTENIDO_LINEA.heroParrafo} caracteres.`,
  pilaresTitulolargo: `El título de los pilares admite hasta ${LIMITES_CONTENIDO_LINEA.pilaresTitulo} caracteres.`,
  pilaresParrafolargo: `El párrafo de los pilares admite hasta ${LIMITES_CONTENIDO_LINEA.pilaresParrafo} caracteres.`,
  coleccionTitulolargo: `El título de la colección admite hasta ${LIMITES_CONTENIDO_LINEA.coleccionTitulo} caracteres.`,
  argumentosTitulolargo: `El título de los argumentos admite hasta ${LIMITES_CONTENIDO_LINEA.argumentosTitulo} caracteres.`,
  ctaTitulolargo: `El título del cierre admite hasta ${LIMITES_CONTENIDO_LINEA.ctaTitulo} caracteres.`,
  ctaParrafolargo: `El párrafo del cierre admite hasta ${LIMITES_CONTENIDO_LINEA.ctaParrafo} caracteres.`,
  sinimagen: "Selecciona una imagen para actualizar el hero.",
  sinalt: "El texto alternativo de la imagen es obligatorio.",
  altlargo: `El texto alternativo admite hasta ${LIMITES_CONTENIDO_LINEA.heroImagenAlt} caracteres.`,
  procesar: "No pudimos procesar la imagen. Verifica que sea un JPG, PNG o WebP válido.",
  almacen:
    "No pudimos guardar la imagen por un problema del servidor, no por el archivo. Vuelve a intentarlo en unos minutos; si persiste, avisa al equipo.",
};

const textoError = error ? (MENSAJES_ERROR[error] ?? error) : null;

const clasesCampo =
  "mt-1.5 min-h-[44px] w-full rounded-lg border border-line bg-paper px-3.5 py-2.5 text-sm outline-none focus-visible:border-brand focus-visible:ring-2 focus-visible:ring-brand/30";
const clasesBoton =
  "foco-marca inline-flex min-h-[44px] items-center justify-center gap-1.5 rounded-full border border-line bg-surface px-4 text-xs font-bold text-ink transition-colors hover:bg-surface-2 disabled:cursor-not-allowed disabled:opacity-40";
const clasesBotonPeligro =
  "foco-marca inline-flex min-h-[44px] items-center justify-center rounded-full border border-accent/40 bg-surface px-4 text-xs font-bold text-accent-deep transition-colors hover:bg-accent/10";
const clasesBotonPrincipal =
  "foco-marca inline-flex min-h-[44px] items-center rounded-full bg-brand px-7 text-sm font-bold text-white transition-colors hover:bg-brand-deep";

const AYUDA_CLAVE =
  "Identificador para las direcciones de la web. Solo minúsculas, números y guiones. No se repite entre líneas.";

// El color se usa como texto sobre fondo claro Y como fondo con texto blanco.
// El servidor rechaza los que no llegan al mínimo: conviene avisarlo antes.
const AYUDA_COLOR = `Se usa como texto y como fondo con letras blancas, así que debe ser oscuro: rechazamos los que no llegan a ${CONTRASTE_MINIMO}:1 de contraste con el blanco.`;

const clasesEnlaceAccion =
  "foco-marca inline-flex min-h-[44px] items-center justify-center gap-1.5 rounded-full border border-line bg-surface px-4 text-xs font-bold text-ink transition-colors hover:bg-surface-2";

// Formulario de contenido de la página pública, declarado como datos: el
// marcado de los doce campos es idéntico y repetirlo a mano invita a que uno se
// quede sin `maxlength` o sin ayuda.
interface CampoContenido {
  clave: keyof ContenidoLinea;
  campo: string;
  etiqueta: string;
  ayuda: string;
  /** Número de filas si el campo es un textarea; ausente = input de una línea. */
  filas?: number;
  ancho?: "completo";
}

const CAMPOS_CONTENIDO: readonly CampoContenido[] = [
  {
    clave: "heroAntetitulo",
    campo: "hero_antetitulo",
    etiqueta: "Antetítulo del hero",
    ayuda: "Palabra corta sobre el título. Se muestra en mayúsculas.",
  },
  {
    clave: "heroTitulo",
    campo: "hero_titulo",
    etiqueta: "Título del hero",
    ayuda: "El titular grande de la página.",
  },
  {
    clave: "heroParrafo",
    campo: "hero_parrafo",
    etiqueta: "Párrafo del hero",
    ayuda: "Presentación de la línea. Deja una línea en blanco para separar párrafos.",
    filas: 4,
    ancho: "completo",
  },
  {
    clave: "pilaresTitulo",
    campo: "pilares_titulo",
    etiqueta: "Título de los pilares",
    ayuda: "Encabezado de la fila de círculos con icono.",
  },
  {
    clave: "coleccionTitulo",
    campo: "coleccion_titulo",
    etiqueta: "Título de la colección",
    ayuda: "Encabezado de la grilla de libros de la línea.",
  },
  {
    clave: "pilaresParrafo",
    campo: "pilares_parrafo",
    etiqueta: "Párrafo de los pilares",
    ayuda: "Texto bajo ese encabezado. Puede quedar vacío.",
    filas: 3,
    ancho: "completo",
  },
  {
    clave: "argumentosTitulo",
    campo: "argumentos_titulo",
    etiqueta: "Título de los argumentos",
    ayuda: "Encabezado de las razones para elegir la línea.",
  },
  {
    clave: "ctaTitulo",
    campo: "cta_titulo",
    etiqueta: "Título del cierre",
    ayuda: "Titular de la franja final, con el botón de contacto.",
  },
  {
    clave: "ctaParrafo",
    campo: "cta_parrafo",
    etiqueta: "Párrafo del cierre",
    ayuda: "Texto bajo ese titular.",
    filas: 2,
    ancho: "completo",
  },
];

// Los textos por defecto se calculan una vez por línea: alimentan el
// `placeholder` de cada campo, que es exactamente lo que la web mostrará si se
// deja vacío.
const defectosPorLinea = new Map(lineas.map((linea) => [linea.id, defectosContenidoLinea(linea)]));
---

<PanelLayout titulo="Líneas" correo={Astro.locals.sesion?.correo}>
  <h1 class="text-2xl font-extrabold text-ink">Líneas de producto</h1>
  <p class="mt-1 text-sm text-ink/70">
    {lineas.length} línea{lineas.length === 1 ? "" : "s"}, {activas} activa{
      activas === 1 ? "" : "s"
    }. Cada línea agrupa los libros de su colección y aporta el color y el texto con los que se
    presenta.
  </p>

  {
    ok && (
      <p class="mt-4 rounded-lg bg-wa/10 px-4 py-2.5 text-sm font-semibold text-wa-deep">
        {MENSAJES_OK[ok] ?? "Listo."}
      </p>
    )
  }
  {
    textoError && (
      <p class="mt-4 rounded-lg bg-accent/10 px-4 py-2.5 text-sm font-semibold text-accent-deep">
        {textoError}
      </p>
    )
  }

  {
    lineas.length === 0 && (
      <p class="mt-6 rounded-xl border border-line bg-surface px-6 py-10 text-center text-sm text-ink/70">
        Todavía no hay líneas cargadas. Agrega la primera con el formulario de abajo.
      </p>
    )
  }

  {
    sinLinea > 0 && (
      <p class="mt-6 rounded-lg border border-line bg-surface-2 px-4 py-3 text-sm text-ink/75">
        Hay {sinLinea} libro{sinLinea === 1 ? "" : "s"} sin línea asignada. Puedes asignar la línea
        desde la ficha de cada libro, en <strong class="font-semibold text-ink">Libros</strong>.
      </p>
    )
  }

  <div class="mt-6 space-y-5">
    {
      lineas.map((linea, posicion) => (
        <article
          id={`linea-${linea.id}`}
          class="rounded-xl border border-line bg-surface p-6 shadow-sm"
          aria-labelledby={`titulo-${linea.id}`}
        >
          <div class="flex flex-wrap items-start justify-between gap-3">
            <div class="flex items-center gap-3">
              {/* El color es dato del cliente, no marcado: va como estilo de una
                  muestra decorativa y el valor tambien se escribe en texto para
                  quien no distingue colores. */}
              <span
                class="h-7 w-7 shrink-0 rounded-full ring-1 ring-line"
                style={`background-color:${linea.colorHex}`}
                aria-hidden="true"
              />
              <h2 id={`titulo-${linea.id}`} class="text-base font-bold text-ink">
                {posicion + 1}. {linea.nombre}
              </h2>
            </div>
            <span
              class:list={[
                "inline-block rounded-full px-2.5 py-0.5 text-[0.7rem] font-bold",
                linea.activa ? "bg-wa/15 text-wa-deep" : "bg-surface-2 text-ink/70",
              ]}
            >
              {linea.activa ? "Activa" : "Desactivada"}
            </span>
          </div>

          <dl class="mt-3 flex flex-wrap gap-x-6 gap-y-1 text-sm text-ink/70">
            <div class="flex gap-1.5">
              <dt class="font-semibold text-ink">Etiqueta corta:</dt>
              <dd>{linea.etiquetaCorta}</dd>
            </div>
            <div class="flex gap-1.5">
              <dt class="font-semibold text-ink">Clave:</dt>
              <dd>
                <code>{linea.clave}</code>
              </dd>
            </div>
            <div class="flex gap-1.5">
              <dt class="font-semibold text-ink">Color:</dt>
              <dd>
                <code>{linea.colorHex}</code>
              </dd>
            </div>
            <div class="flex gap-1.5">
              <dt class="font-semibold text-ink">Tipo:</dt>
              <dd>{ETIQUETA_TIPO_LINEA[linea.tipo]}</dd>
            </div>
            <div class="flex gap-1.5">
              <dt class="font-semibold text-ink">Libros:</dt>
              <dd>{linea._count.libros}</dd>
            </div>
            <div class="flex gap-1.5">
              <dt class="font-semibold text-ink">Orden:</dt>
              <dd>{linea.orden}</dd>
            </div>
          </dl>

          <div class="mt-4 flex flex-wrap items-center gap-2">
            <form method="post" action={`/api/admin/lineas/${linea.id}`}>
              <input type="hidden" name="_accion" value="subir" />
              <button
                type="submit"
                class={clasesBoton}
                disabled={posicion === 0}
                aria-label={`Subir la línea «${linea.nombre}» una posición`}
              >
                <svg viewBox="0 0 24 24" class="h-4 w-4 fill-current" aria-hidden="true">
                  <path d="M12 6l6 6h-4v6h-4v-6H6l6-6Z" />
                </svg>
                Subir
              </button>
            </form>
            <form method="post" action={`/api/admin/lineas/${linea.id}`}>
              <input type="hidden" name="_accion" value="bajar" />
              <button
                type="submit"
                class={clasesBoton}
                disabled={posicion === lineas.length - 1}
                aria-label={`Bajar la línea «${linea.nombre}» una posición`}
              >
                <svg viewBox="0 0 24 24" class="h-4 w-4 fill-current" aria-hidden="true">
                  <path d="M12 18l-6-6h4V6h4v6h4l-6 6Z" />
                </svg>
                Bajar
              </button>
            </form>
            <form method="post" action={`/api/admin/lineas/${linea.id}`}>
              <input type="hidden" name="_accion" value="activar" />
              <button
                type="submit"
                class={clasesBoton}
                aria-label={`${linea.activa ? "Desactivar" : "Activar"} la línea «${linea.nombre}»`}
              >
                {linea.activa ? "Desactivar" : "Activar"}
              </button>
            </form>
            {/* El nombre no se interpola dentro del literal de JavaScript:
                escaparlo a mano es fragil y el boton ya lo dice en su
                aria-label. El resto del panel usa avisos fijos igual.
                El comentario va FUERA de la etiqueta: entre atributos, Astro lo
                lee como un atributo abreviado y rompe el analisis del archivo. */}
            <form
              method="post"
              action={`/api/admin/lineas/${linea.id}`}
              data-confirmar={`¿Eliminar esta línea? Sus ${linea._count.libros} libro(s) no se borran, pero quedan sin línea y DEJAN DE MOSTRARSE en la web hasta que les asignes otra. No se puede deshacer.`}
            >
              <input type="hidden" name="_accion" value="eliminar" />
              <button
                type="submit"
                class={clasesBotonPeligro}
                aria-label={`Eliminar la línea «${linea.nombre}»`}
              >
                Eliminar
              </button>
            </form>
          </div>

          <div class="mt-2 flex flex-wrap items-center gap-2">
            <a
              href={`/lineas/${linea.clave}`}
              target="_blank"
              rel="noopener"
              class={clasesEnlaceAccion}
            >
              <svg viewBox="0 0 24 24" class="h-4 w-4 fill-current" aria-hidden="true">
                <path d="M12 5c-5 0-9 4.5-9 7s4 7 9 7 9-4.5 9-7-4-7-9-7Zm0 11a4 4 0 1 1 0-8 4 4 0 0 1 0 8Zm0-6a2 2 0 1 0 0 4 2 2 0 0 0 0-4Z" />
              </svg>
              Ver página
              <span class="sr-only">de «{linea.nombre}» (se abre en una pestaña nueva)</span>
            </a>
            <a href={`/admin/lineas/${linea.id}/bloques`} class={clasesEnlaceAccion}>
              <svg viewBox="0 0 24 24" class="h-4 w-4 fill-current" aria-hidden="true">
                <path d="M4 4h7v7H4V4Zm9 0h7v7h-7V4ZM4 13h7v7H4v-7Zm9 0h7v7h-7v-7Z" />
              </svg>
              Pilares y argumentos
              <span class="sr-only">de «{linea.nombre}»</span>
            </a>
          </div>

          <form
            method="post"
            action={`/api/admin/lineas/${linea.id}`}
            class="mt-5 border-t border-line pt-5"
          >
            <div class="grid gap-4 sm:grid-cols-2">
              <label class="block">
                <span class="text-sm font-semibold text-ink">
                  Nombre <span class="text-accent-deep">*</span>
                </span>
                <input
                  type="text"
                  name="nombre"
                  required
                  maxlength={LIMITES_LINEA.nombre}
                  value={linea.nombre}
                  class={clasesCampo}
                />
              </label>
              <label class="block">
                <span class="text-sm font-semibold text-ink">
                  Etiqueta corta <span class="text-accent-deep">*</span>
                </span>
                <input
                  type="text"
                  name="etiqueta_corta"
                  required
                  maxlength={LIMITES_LINEA.etiquetaCorta}
                  value={linea.etiquetaCorta}
                  class={clasesCampo}
                />
              </label>
              <label class="block">
                <span class="text-sm font-semibold text-ink">
                  Clave <span class="text-accent-deep">*</span>
                </span>
                <input
                  type="text"
                  name="clave"
                  required
                  maxlength={LIMITES_LINEA.clave}
                  pattern="[a-z0-9]+(-[a-z0-9]+)*"
                  value={linea.clave}
                  aria-describedby={`ayuda-clave-${linea.id}`}
                  class={clasesCampo}
                />
                <span id={`ayuda-clave-${linea.id}`} class="mt-1.5 block text-xs text-ink/70">
                  {AYUDA_CLAVE}
                </span>
              </label>
              <div class="grid grid-cols-2 gap-4">
                <label class="block">
                  <span class="text-sm font-semibold text-ink">Color</span>
                  <input
                    type="color"
                    name="color_hex"
                    value={linea.colorHex}
                    aria-label={`Color de identidad de ${linea.nombre}`}
                    aria-describedby={`ayuda-color-${linea.id}`}
                    class="mt-1.5 h-[44px] w-full cursor-pointer rounded-lg border border-line bg-paper px-1.5 py-1"
                  />
                </label>
                <label class="block">
                  <span class="text-sm font-semibold text-ink">Orden</span>
                  <input type="number" name="orden" value={linea.orden} class={clasesCampo} />
                </label>
              </div>
              <label class="block">
                <span class="text-sm font-semibold text-ink">Tipo</span>
                <select name="tipo" class={clasesCampo} aria-describedby={`ayuda-tipo-${linea.id}`}>
                  {Object.entries(ETIQUETA_TIPO_LINEA).map(([valor, etiqueta]) => (
                    <option value={valor} selected={linea.tipo === valor}>
                      {etiqueta}
                    </option>
                  ))}
                </select>
                <span id={`ayuda-tipo-${linea.id}`} class="mt-1.5 block text-xs text-ink/70">
                  Decide en qué sección de la portada aparecen sus libros.
                </span>
              </label>
              <label class="block sm:col-span-2">
                <span class="text-sm font-semibold text-ink">
                  Descripción <span class="text-accent-deep">*</span>
                </span>
                {/* `set:text` y NO el valor entre las etiquetas: escrito como hijo, el
                  formateador lo rodea de saltos e indentacion, y ese relleno ES parte
                  del valor. Sin hijos que reformatear no puede volver a pasar. */}
                <textarea
                  name="descripcion"
                  rows="3"
                  required
                  maxlength={LIMITES_LINEA.descripcion}
                  class={clasesCampo}
                  set:text={linea.descripcion}
                />
              </label>
              <p id={`ayuda-color-${linea.id}`} class="text-xs text-ink/70 sm:col-span-2">
                {AYUDA_COLOR}
              </p>
            </div>
            <button type="submit" class:list={[clasesBotonPrincipal, "mt-5"]}>
              Guardar cambios
            </button>
          </form>

          {/* El contenido de la página pública va plegado: son doce campos más y
              desplegados dejaban la lista de líneas imposible de recorrer.
              <details> funciona con teclado y sin JavaScript. */}
          <details id={`contenido-${linea.id}`} class="mt-5 border-t border-line pt-5">
            <summary class="foco-marca inline-flex min-h-[44px] cursor-pointer list-none items-center gap-2 text-sm font-bold text-brand [&::-webkit-details-marker]:hidden">
              <svg viewBox="0 0 24 24" class="h-4 w-4 fill-current" aria-hidden="true">
                <path d="M7 10l5 5 5-5H7Z" />
              </svg>
              Contenido de la página pública
            </summary>

            <p class="mt-3 text-sm text-ink/70">
              Textos de <code>/lineas/{linea.clave}</code>. Déjalos vacíos para usar el texto que
              aparece como sugerencia en cada campo: la página nunca queda incompleta.
            </p>

            <form
              method="post"
              action={`/api/admin/lineas/contenido/${linea.id}`}
              class="mt-5 grid gap-4 sm:grid-cols-2"
            >
              {CAMPOS_CONTENIDO.map((campo) => {
                const valor = linea[campo.clave] ?? "";
                const idAyuda = `ayuda-${campo.campo}-${linea.id}`;
                const sugerencia = defectosPorLinea.get(linea.id)?.[campo.clave] ?? "";
                return (
                  <label class:list={["block", campo.ancho === "completo" && "sm:col-span-2"]}>
                    <span class="text-sm font-semibold text-ink">{campo.etiqueta}</span>
                    {campo.filas ? (
                      // `set:text`: el relleno que el formateador metia entre las
                      // etiquetas era parte del valor y tapaba el placeholder.
                      <textarea
                        name={campo.campo}
                        rows={campo.filas}
                        maxlength={LIMITES_CONTENIDO_LINEA[campo.clave]}
                        placeholder={sugerencia}
                        aria-describedby={idAyuda}
                        class={clasesCampo}
                        set:text={valor}
                      />
                    ) : (
                      <input
                        type="text"
                        name={campo.campo}
                        maxlength={LIMITES_CONTENIDO_LINEA[campo.clave]}
                        value={valor}
                        placeholder={sugerencia}
                        aria-describedby={idAyuda}
                        class={clasesCampo}
                      />
                    )}
                    <span id={idAyuda} class="mt-1.5 block text-xs text-ink/70">
                      {campo.ayuda} Hasta {LIMITES_CONTENIDO_LINEA[campo.clave]} caracteres.
                    </span>
                  </label>
                );
              })}
              <div class="sm:col-span-2">
                <button type="submit" class={clasesBotonPrincipal}>
                  Guardar contenido
                </button>
              </div>
            </form>

            {/* Imagen del hero: formulario aparte porque va en multipart y su
                validación (formato, peso, medidas) no tiene que ver con los textos. */}
            <div id={`hero-${linea.id}`} class="mt-8 border-t border-line pt-6">
              <h3 class="text-base font-bold text-ink">Imagen del hero</h3>
              <p class="mt-1 text-sm text-ink/70">
                Fotografía horizontal que acompaña al titular. Sin imagen, el hero se ve igual a una
                sola columna.
              </p>

              {linea.heroImagenUrl && (
                <div class="mt-4 flex flex-wrap items-start gap-4">
                  <img
                    src={linea.heroImagenUrl}
                    alt=""
                    width={linea.heroAncho ?? 1600}
                    height={linea.heroAlto ?? 1200}
                    class="w-40 rounded-lg bg-paper object-contain ring-1 ring-line"
                    style="height:auto"
                    loading="lazy"
                  />
                  <p class="max-w-[30ch] flex-1 text-xs leading-relaxed text-ink/70">
                    <span class="font-semibold text-ink">Texto alternativo actual:</span>{" "}
                    {linea.heroImagenAlt}
                  </p>
                </div>
              )}

              <form
                method="post"
                action={`/api/admin/lineas/hero/${linea.id}`}
                enctype="multipart/form-data"
                class="mt-4"
              >
                <label
                  class="block text-sm font-semibold text-ink"
                  for={`hero-archivo-${linea.id}`}
                >
                  Nueva imagen <span class="text-accent-deep">*</span>
                </label>
                <input
                  type="file"
                  id={`hero-archivo-${linea.id}`}
                  name="imagen"
                  accept=".jpg,.jpeg,.png,.webp"
                  required
                  aria-describedby={`hero-ayuda-${linea.id}`}
                  class="mt-2 block w-full text-sm text-ink/75 file:mr-3 file:min-h-[44px] file:rounded-full file:border-0 file:bg-surface-2 file:px-4 file:text-sm file:font-semibold file:text-brand-deep hover:file:bg-line"
                />
                <p id={`hero-ayuda-${linea.id}`} class="mt-1.5 text-xs text-ink/70">
                  JPG, PNG o WebP. Máximo 5 MB. Orientación horizontal. Las que están cargadas hoy
                  son recortes provisionales del diseño: reemplázalas apenas llegue la fotografía
                  original.
                </p>

                <label class="mt-4 block">
                  <span class="text-sm font-semibold text-ink">
                    Texto alternativo <span class="text-accent-deep">*</span>
                  </span>
                  <input
                    type="text"
                    name="hero_imagen_alt"
                    required
                    maxlength={LIMITES_CONTENIDO_LINEA.heroImagenAlt}
                    value={linea.heroImagenAlt ?? ""}
                    aria-describedby={`hero-alt-ayuda-${linea.id}`}
                    class={clasesCampo}
                  />
                </label>
                <p id={`hero-alt-ayuda-${linea.id}`} class="mt-1.5 text-xs text-ink/70">
                  Describe qué se ve en la imagen: lo leen los lectores de pantalla.
                </p>

                <button type="submit" class:list={[clasesBotonPrincipal, "mt-5"]}>
                  Guardar imagen
                </button>
              </form>

              {linea.heroImagenUrl && (
                <form
                  method="post"
                  action={`/api/admin/lineas/hero/${linea.id}`}
                  class="mt-3"
                  data-confirmar="¿Quitar la imagen del hero? Se eliminará el archivo cargado y el hero quedará sin foto."
                >
                  <input type="hidden" name="_accion" value="restaurar" />
                  <button
                    type="submit"
                    class="foco-marca inline-flex min-h-[44px] items-center rounded-full border border-accent/40 px-5 text-xs font-bold text-accent-deep transition-colors hover:bg-accent/10"
                  >
                    Quitar la imagen
                  </button>
                </form>
              )}
            </div>
          </details>
        </article>
      ))
    }
  </div>

  <form
    method="post"
    action="/api/admin/lineas"
    class="mt-8 max-w-2xl rounded-xl border border-line bg-surface p-6 shadow-sm md:p-8"
  >
    <h2 class="text-lg font-bold text-ink">Agregar línea</h2>

    <div class="mt-5 grid gap-4 sm:grid-cols-2">
      <label class="block">
        <span class="text-sm font-semibold text-ink">
          Nombre <span class="text-accent-deep">*</span>
        </span>
        <input
          type="text"
          name="nombre"
          required
          maxlength={LIMITES_LINEA.nombre}
          placeholder="Ej. Tutoría SMART Secundaria"
          class={clasesCampo}
        />
      </label>
      <label class="block">
        <span class="text-sm font-semibold text-ink">
          Etiqueta corta <span class="text-accent-deep">*</span>
        </span>
        <input
          type="text"
          name="etiqueta_corta"
          required
          maxlength={LIMITES_LINEA.etiquetaCorta}
          placeholder="Ej. Secundaria"
          class={clasesCampo}
        />
      </label>
      <label class="block">
        <span class="text-sm font-semibold text-ink">
          Clave <span class="text-accent-deep">*</span>
        </span>
        <input
          type="text"
          name="clave"
          required
          maxlength={LIMITES_LINEA.clave}
          pattern="[a-z0-9]+(-[a-z0-9]+)*"
          placeholder="Ej. secundaria"
          aria-describedby="ayuda-clave-nueva"
          class={clasesCampo}
        />
        <span id="ayuda-clave-nueva" class="mt-1.5 block text-xs text-ink/70">{AYUDA_CLAVE}</span>
      </label>
      <div class="grid grid-cols-2 gap-4">
        <label class="block">
          <span class="text-sm font-semibold text-ink">Color</span>
          <input
            type="color"
            name="color_hex"
            value="#1e6fd9"
            aria-label="Color de identidad de la nueva línea"
            aria-describedby="ayuda-color-nueva"
            class="mt-1.5 h-[44px] w-full cursor-pointer rounded-lg border border-line bg-paper px-1.5 py-1"
          />
        </label>
        <label class="block">
          <span class="text-sm font-semibold text-ink">Orden</span>
          <input type="number" name="orden" value={lineas.length + 1} class={clasesCampo} />
        </label>
      </div>
      <label class="block">
        <span class="text-sm font-semibold text-ink">Tipo</span>
        <select name="tipo" class={clasesCampo} aria-describedby="ayuda-tipo-nueva">
          {
            Object.entries(ETIQUETA_TIPO_LINEA).map(([valor, etiqueta]) => (
              <option value={valor}>{etiqueta}</option>
            ))
          }
        </select>
        <span id="ayuda-tipo-nueva" class="mt-1.5 block text-xs text-ink/70">
          Decide en qué sección de la portada aparecen sus libros.
        </span>
      </label>
      <label class="block sm:col-span-2">
        <span class="text-sm font-semibold text-ink">
          Descripción <span class="text-accent-deep">*</span>
        </span>
        <textarea
          name="descripcion"
          rows="3"
          required
          maxlength={LIMITES_LINEA.descripcion}
          placeholder="Párrafo de presentación de la línea"
          aria-describedby="ayuda-descripcion-nueva"
          class={clasesCampo}></textarea>
        <span id="ayuda-descripcion-nueva" class="mt-1.5 block text-xs text-ink/70">
          Hasta {LIMITES_LINEA.descripcion} caracteres.
        </span>
      </label>
      <p id="ayuda-color-nueva" class="text-xs text-ink/70 sm:col-span-2">{AYUDA_COLOR}</p>
    </div>

    <button type="submit" class:list={[clasesBotonPrincipal, "mt-6"]}>Agregar línea</button>
  </form>
</PanelLayout>
