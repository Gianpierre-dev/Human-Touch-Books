---
import PanelLayout from "../../layouts/PanelLayout.astro";
import { bd } from "../../lib/bd";

export const prerender = false;

// Los totales se cuentan en la base y NO sobre la lista de esta pagina: al
// contarlos sobre la rebanada, con 340 mensajes la pantalla decia «200
// recibidos» para siempre y sus pendientes discrepaban de la insignia del menu,
// que si contaba de verdad. Un numero que miente sobre consultas comerciales
// sin responder es peor que no mostrarlo.
const POR_PAGINA = 50;
const paginaPedida = Number(Astro.url.searchParams.get("pagina") ?? "1");
const [total, pendientes] = await Promise.all([
  bd.mensaje.count(),
  bd.mensaje.count({ where: { atendido: false } }),
]);
const totalPaginas = Math.max(1, Math.ceil(total / POR_PAGINA));
const pagina = Number.isSafeInteger(paginaPedida)
  ? Math.min(Math.max(paginaPedida, 1), totalPaginas)
  : 1;

// El `id` desempata y con eso el orden es TOTAL. Sin el, dos mensajes con la
// misma marca de tiempo pueden ordenarse distinto en cada consulta, y como cada
// pagina es una consulta aparte, una fila podia salir dos veces y otra no salir
// en ninguna: probado con 120 mensajes creados a la vez, solo 90 eran
// alcanzables. En una bandeja de consultas comerciales eso es perder ventas.
const mensajes = await bd.mensaje.findMany({
  orderBy: [{ atendido: "asc" }, { creadoEn: "desc" }, { id: "asc" }],
  skip: (pagina - 1) * POR_PAGINA,
  take: POR_PAGINA,
});

const ok = Astro.url.searchParams.get("ok");
const error = Astro.url.searchParams.get("error");

const clasesPaginacion =
  "foco-marca inline-flex min-h-[44px] items-center rounded-full border border-line bg-surface px-5 text-sm font-bold text-ink transition-colors hover:bg-surface-2";

const formatoFecha = new Intl.DateTimeFormat("es-PE", {
  dateStyle: "short",
  timeStyle: "short",
  timeZone: "America/Lima",
});
---

<PanelLayout titulo="Mensajes" correo={Astro.locals.sesion?.correo}>
  <h1 class="text-2xl font-extrabold text-ink">Mensajes de contacto</h1>
  <p class="mt-1 text-sm text-ink/70">
    {total} mensaje{total === 1 ? "" : "s"} recibido{total === 1 ? "" : "s"}. {pendientes} sin atender.
    {totalPaginas > 1 && ` Página ${pagina} de ${totalPaginas}.`}
  </p>

  {
    ok && (
      <p class="mt-4 rounded-lg bg-wa/10 px-4 py-2.5 text-sm font-semibold text-wa-deep">
        Estado actualizado.
      </p>
    )
  }
  {
    error && (
      <p class="mt-4 rounded-lg bg-accent/10 px-4 py-2.5 text-sm font-semibold text-accent-deep">
        No encontramos ese mensaje.
      </p>
    )
  }

  {
    mensajes.length === 0 ? (
      <p class="mt-6 rounded-xl border border-line bg-surface px-6 py-10 text-center text-sm text-ink/70">
        Todavía no hay mensajes. Los envíos del formulario de la web aparecerán aquí.
      </p>
    ) : (
      <div class="mt-6 overflow-x-auto rounded-xl border border-line bg-surface shadow-sm">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-line text-left text-xs font-bold tracking-wide text-ink/70 uppercase">
              <th class="px-4 py-3">Fecha</th>
              <th class="px-4 py-3">Nombre</th>
              <th class="px-4 py-3">Contacto</th>
              <th class="px-4 py-3">Asunto</th>
              <th class="px-4 py-3">Mensaje</th>
              <th class="px-4 py-3">Estado</th>
            </tr>
          </thead>
          <tbody>
            {mensajes.map((mensaje) => (
              <tr
                class:list={[
                  "border-b border-line/60 last:border-0",
                  !mensaje.atendido && "bg-brand/5",
                ]}
              >
                <td class="px-4 py-3 whitespace-nowrap text-ink/70">
                  {formatoFecha.format(mensaje.creadoEn)}
                </td>
                <td class="px-4 py-3 font-semibold text-ink">{mensaje.nombre}</td>
                <td class="px-4 py-3 text-ink/70">
                  <a href={`mailto:${mensaje.correo}`} class="text-brand hover:text-brand-deep">
                    {mensaje.correo}
                  </a>
                  <br />
                  <a href={`tel:${mensaje.telefono.replace(/\s/g, "")}`} class="hover:text-brand">
                    {mensaje.telefono}
                  </a>
                </td>
                <td class="px-4 py-3 text-ink/70">{mensaje.asunto}</td>
                <td class="max-w-sm px-4 py-3 text-ink/70">
                  <p class="whitespace-pre-line">{mensaje.mensaje}</p>
                </td>
                <td class="px-4 py-3">
                  {/* El badge informa el estado; el boton describe la accion. */}
                  <span
                    class:list={[
                      "inline-block rounded-full px-2.5 py-0.5 text-[0.7rem] font-bold",
                      mensaje.atendido ? "bg-wa/15 text-wa-deep" : "bg-surface-2 text-ink/70",
                    ]}
                  >
                    {mensaje.atendido ? "Atendido" : "Pendiente"}
                  </span>
                  {/* Vuelve a la misma pagina: sin esto, marcar el mensaje 60
                      devolvia a la primera y habia que volver a paginar. */}
                  <form method="post" action={`/api/admin/mensajes/${mensaje.id}`} class="mt-2">
                    <input type="hidden" name="pagina" value={pagina} />
                    <button
                      type="submit"
                      aria-label={`${mensaje.atendido ? "Marcar pendiente" : "Marcar atendido"} el mensaje de ${mensaje.nombre}`}
                      class="foco-marca min-h-[44px] rounded-full bg-brand px-4 text-xs font-bold whitespace-nowrap text-white transition-colors hover:bg-brand-deep"
                    >
                      {mensaje.atendido ? "Marcar pendiente" : "Marcar atendido"}
                    </button>
                  </form>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )
  }

  {
    totalPaginas > 1 && (
      <nav class="mt-6 flex items-center justify-between gap-3" aria-label="Paginación de mensajes">
        {pagina > 1 ? (
          <a href={`/admin/mensajes?pagina=${pagina - 1}`} class={clasesPaginacion}>
            ← Anteriores
          </a>
        ) : (
          <span />
        )}
        <p class="text-sm text-ink/70">
          Página {pagina} de {totalPaginas}
        </p>
        {pagina < totalPaginas ? (
          <a href={`/admin/mensajes?pagina=${pagina + 1}`} class={clasesPaginacion}>
            Siguientes →
          </a>
        ) : (
          <span />
        )}
      </nav>
    )
  }
</PanelLayout>
