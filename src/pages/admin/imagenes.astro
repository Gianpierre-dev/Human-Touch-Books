---
import PanelLayout from "../../layouts/PanelLayout.astro";
import { bd } from "../../lib/bd";
import { ESPACIOS_IMAGEN, LIMITES } from "../../lib/contenido";

export const prerender = false;

const filas = await bd.imagenSitio.findMany();
const cargadas = new Map(filas.map((fila) => [fila.clave, fila]));

const ok = Astro.url.searchParams.get("ok");
const error = Astro.url.searchParams.get("error");

const MENSAJES_OK: Record<string, string> = {
  guardada: "Imagen actualizada.",
  restaurada: "Se restauró la imagen original del diseño.",
  sincambios: "No había nada que cambiar.",
};

// Los códigos cubren la validación propia; si llega el texto de otro validador
// (formato o peso del archivo) se muestra tal cual, que ya viene redactado.
const MENSAJES_ERROR: Record<string, string> = {
  tamano:
    "El envío era demasiado grande. Si estás subiendo una imagen, comprueba que pese menos de 5 MB.",
  clave: "No reconocimos el espacio de imagen.",
  sinimagen: "Selecciona una imagen para actualizarla.",
  sinalt: "El texto alternativo es obligatorio.",
  altlargo: `El texto alternativo admite hasta ${LIMITES.altTexto} caracteres.`,
  procesar: "No pudimos procesar la imagen. Verifica que sea un JPG, PNG o WebP válido.",
  almacen:
    "No pudimos guardar la imagen por un problema del servidor, no por el archivo. Vuelve a intentarlo en unos minutos; si persiste, avisa al equipo.",
};

const textoError = error ? (MENSAJES_ERROR[error] ?? error) : null;

const clasesCampo =
  "mt-1.5 min-h-[44px] w-full rounded-lg border border-line bg-paper px-3.5 py-2.5 text-sm outline-none focus-visible:border-brand focus-visible:ring-2 focus-visible:ring-brand/30";
---

<PanelLayout titulo="Imágenes" correo={Astro.locals.sesion?.correo}>
  <h1 class="text-2xl font-extrabold text-ink">Imágenes de las secciones</h1>
  <p class="mt-1 text-sm text-ink/70">
    Cada espacio tiene una sola imagen. Mientras no cargues una, la página muestra la que viene con
    el diseño.
  </p>

  {
    ok && (
      <p class="mt-4 rounded-lg bg-wa/10 px-4 py-2.5 text-sm font-semibold text-wa-deep">
        {MENSAJES_OK[ok] ?? "Listo."}
      </p>
    )
  }
  {
    textoError && (
      <p class="mt-4 rounded-lg bg-accent/10 px-4 py-2.5 text-sm font-semibold text-accent-deep">
        {textoError}
      </p>
    )
  }

  <div class="mt-6 grid gap-6 lg:grid-cols-2">
    {
      ESPACIOS_IMAGEN.map((espacio) => {
        const cargada = cargadas.get(espacio.clave);
        const imagenUrl = cargada?.imagenUrl ?? espacio.imagenUrl;
        const altTexto = cargada?.altTexto ?? espacio.altTexto;
        const idAyuda = `ayuda-${espacio.clave}`;
        const idAyudaAlt = `ayuda-alt-${espacio.clave}`;

        return (
          <section
            class="rounded-xl border border-line bg-surface p-6 shadow-sm"
            aria-labelledby={`titulo-${espacio.clave}`}
          >
            <div class="flex flex-wrap items-start justify-between gap-3">
              <h2 id={`titulo-${espacio.clave}`} class="text-lg font-bold text-ink">
                {espacio.etiqueta}
              </h2>
              <span
                class:list={[
                  "inline-block rounded-full px-2.5 py-0.5 text-[0.7rem] font-bold",
                  cargada ? "bg-wa/15 text-wa-deep" : "bg-surface-2 text-ink/70",
                ]}
              >
                {cargada ? "Personalizada" : "Imagen del diseño"}
              </span>
            </div>

            <div class="mt-4 flex flex-wrap items-start gap-4">
              <img
                src={imagenUrl}
                alt=""
                width={cargada?.ancho ?? espacio.ancho}
                height={cargada?.alto ?? espacio.alto}
                class="w-32 rounded-lg bg-paper object-contain ring-1 ring-line"
                style="height:auto"
                loading="lazy"
              />
              <p class="max-w-[26ch] flex-1 text-xs leading-relaxed text-ink/70">
                <span class="font-semibold text-ink">Texto alternativo actual:</span> {altTexto}
              </p>
            </div>

            <form
              method="post"
              action="/api/admin/imagenes"
              enctype="multipart/form-data"
              class="mt-5 border-t border-line pt-5"
            >
              <input type="hidden" name="clave" value={espacio.clave} />

              <label class="block text-sm font-semibold text-ink" for={`archivo-${espacio.clave}`}>
                Nueva imagen <span class="text-accent-deep">*</span>
              </label>
              <input
                type="file"
                id={`archivo-${espacio.clave}`}
                name="imagen"
                accept=".jpg,.jpeg,.png,.webp"
                required
                aria-describedby={idAyuda}
                class="mt-2 block w-full text-sm text-ink/75 file:mr-3 file:min-h-[44px] file:rounded-full file:border-0 file:bg-surface-2 file:px-4 file:text-sm file:font-semibold file:text-brand-deep hover:file:bg-line"
              />
              <p id={idAyuda} class="mt-1.5 text-xs text-ink/70">
                JPG, PNG o WebP. Máximo 5 MB. {espacio.ayuda}
              </p>

              <label class="mt-4 block">
                <span class="text-sm font-semibold text-ink">
                  Texto alternativo <span class="text-accent-deep">*</span>
                </span>
                <input
                  type="text"
                  name="alt_texto"
                  required
                  maxlength={LIMITES.altTexto}
                  value={altTexto}
                  aria-describedby={idAyudaAlt}
                  class={clasesCampo}
                />
              </label>
              <p id={idAyudaAlt} class="mt-1.5 text-xs text-ink/70">
                Describe qué se ve en la imagen: lo leen los lectores de pantalla.
              </p>

              <button
                type="submit"
                class="foco-marca mt-5 inline-flex min-h-[44px] items-center rounded-full bg-brand px-7 text-sm font-bold text-white transition-colors hover:bg-brand-deep"
              >
                Guardar imagen
              </button>
            </form>

            {cargada && (
              <form
                method="post"
                action="/api/admin/imagenes"
                class="mt-3"
                data-confirmar="¿Restaurar la imagen original del diseño? Se eliminará la imagen que cargaste."
              >
                <input type="hidden" name="clave" value={espacio.clave} />
                <input type="hidden" name="_accion" value="restaurar" />
                <button
                  type="submit"
                  class="foco-marca inline-flex min-h-[44px] items-center rounded-full border border-accent/40 px-5 text-xs font-bold text-accent-deep transition-colors hover:bg-accent/10"
                >
                  Restaurar imagen del diseño
                </button>
              </form>
            )}
          </section>
        );
      })
    }
  </div>
</PanelLayout>
