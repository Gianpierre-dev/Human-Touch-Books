---
import PanelLayout from "../../../layouts/PanelLayout.astro";
import FormularioLibro from "../../../components/FormularioLibro.astro";
import { bd } from "../../../lib/bd";
import { leerBorrador } from "../../../lib/borrador";

export const prerender = false;

const lineas = await bd.linea.findMany({
  orderBy: [{ orden: "asc" }, { creadoEn: "asc" }],
  select: { id: true, nombre: true, tipo: true },
});

const error = Astro.url.searchParams.get("error");

// Borrador del intento rechazado. La API lo deja en una cookie de un solo uso
// (misma mecanica que el resto del panel) porque por la URL viajarian miles de
// caracteres de sinopsis, a la vista en la barra de direcciones y en el
// historial. Se lee y se borra en el MISMO render: si sobreviviera, pisaria el
// formulario la proxima vez que se entrara limpio.
//
// La cookie cubre /admin/libros entero, asi que el borrador dice de que libro
// es: el de un alta («») no puede repoblar la ficha de otro.
const COOKIE_BORRADOR = "borrador_libros";
const RUTA_BORRADOR = "/admin/libros";

const borrador = leerBorrador(Astro.cookies, COOKIE_BORRADOR, RUTA_BORRADOR);
---

<PanelLayout titulo="Nuevo libro" correo={Astro.locals.sesion?.correo}>
  <h1 class="text-2xl font-extrabold text-ink">Agregar libro</h1>
  <p class="mt-1 mb-6 text-sm text-ink/60">Completa los datos y sube la portada.</p>
  {
    lineas.length === 0 ? (
      <p class="max-w-xl rounded-lg border border-accent/30 bg-accent/10 px-4 py-3 text-sm font-semibold text-accent-deep">
        Todo libro pertenece a una línea de producto y todavía no hay ninguna. Crea primero una en
        <a href="/admin/lineas" class="foco-marca underline underline-offset-2">
          Líneas
        </a>
        y vuelve aquí.
      </p>
    ) : (
      <FormularioLibro
        accion="/api/admin/libros"
        error={error}
        lineas={lineas}
        borrador={borrador}
      />
    )
  }
</PanelLayout>
