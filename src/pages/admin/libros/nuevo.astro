---
import PanelLayout from "../../../layouts/PanelLayout.astro";
import FormularioLibro from "../../../components/FormularioLibro.astro";

export const prerender = false;

const error = Astro.url.searchParams.get("error");
---

<PanelLayout titulo="Nuevo libro" correo={Astro.locals.sesion?.correo}>
  <h1 class="text-2xl font-extrabold text-ink">Agregar libro</h1>
  <p class="mt-1 mb-6 text-sm text-ink/60">Completa los datos y sube la portada.</p>
  <FormularioLibro accion="/api/admin/libros" error={error} />
</PanelLayout>
