---
import PanelLayout from "../../../layouts/PanelLayout.astro";
import FormularioLibro from "../../../components/FormularioLibro.astro";
import { bd } from "../../../lib/bd";
import { leerBorrador } from "../../../lib/borrador";

export const prerender = false;

const { id } = Astro.params;
const libro = await bd.libro.findUnique({ where: { id: id ?? "" } });
if (!libro) return Astro.redirect("/admin?error=noexiste", 302);

const lineas = await bd.linea.findMany({
  orderBy: [{ orden: "asc" }, { creadoEn: "asc" }],
  select: { id: true, nombre: true, tipo: true },
});

const error = Astro.url.searchParams.get("error");

// Borrador del intento rechazado. La API lo deja en una cookie de un solo uso
// (misma mecanica que el resto del panel) porque por la URL viajarian miles de
// caracteres de sinopsis, a la vista en la barra de direcciones y en el
// historial. Se lee y se borra en el MISMO render: si sobreviviera, pisaria el
// formulario la proxima vez que se entrara limpio.
//
// La cookie cubre /admin/libros entero, asi que el borrador dice de que libro
// es: el de otra ficha (o el de un alta) no puede repoblar esta.
const COOKIE_BORRADOR = "borrador_libros";
const RUTA_BORRADOR = "/admin/libros";

const borrador = leerBorrador(Astro.cookies, COOKIE_BORRADOR, RUTA_BORRADOR, libro.id);
---

<PanelLayout titulo={`Editar: ${libro.titulo}`} correo={Astro.locals.sesion?.correo}>
  <div class="flex flex-wrap items-center justify-between gap-4">
    <div>
      <h1 class="text-2xl font-extrabold text-ink">Editar libro</h1>
      <p class="mt-1 text-sm text-ink/60">{libro.titulo}</p>
    </div>
    <form
      method="post"
      action={`/api/admin/libros/${libro.id}`}
      data-confirmar="¿Eliminar este libro? Esta acción no se puede deshacer."
    >
      <input type="hidden" name="_accion" value="eliminar" />
      <button
        type="submit"
        class="foco-marca inline-flex min-h-[44px] items-center justify-center rounded-full border border-accent/40 bg-surface px-5 text-sm font-bold text-accent-deep transition-colors hover:bg-accent/10"
      >
        Eliminar<span class="sr-only"> «{libro.titulo}»</span>
      </button>
    </form>
  </div>

  <div class="mt-6">
    <FormularioLibro
      accion={`/api/admin/libros/${libro.id}`}
      libro={libro}
      error={error}
      lineas={lineas}
      borrador={borrador}
    />
  </div>
</PanelLayout>
