---
import PanelLayout from "../../layouts/PanelLayout.astro";
import { bd } from "../../lib/bd";
import {
  LIMITE_IMAGEN_ALT,
  LIMITES_CONTENIDO_PAGINA,
  LIMITES_PAGINA,
  type ContenidoPagina,
} from "../../lib/paginas";

export const prerender = false;

// Los conteos viajan en la misma consulta (`_count`): evita dos consultas por
// pagina al pintar la lista.
const paginas = await bd.paginaInstitucional.findMany({
  orderBy: [{ orden: "asc" }, { creadoEn: "asc" }],
  include: { _count: { select: { secciones: true, bloques: true } } },
});
const activas = paginas.filter((pagina) => pagina.activa).length;

const ok = Astro.url.searchParams.get("ok");
const error = Astro.url.searchParams.get("error");

const MENSAJES_OK: Record<string, string> = {
  creada: "Página agregada. Nace desactivada: publícala cuando el contenido esté listo.",
  guardada: "Cambios guardados.",
  eliminada: "Página eliminada, junto con sus secciones y valores.",
  visible: "La página quedó publicada y ya aparece en el menú.",
  oculta: "La página quedó despublicada: salió del menú y su dirección devuelve error 404.",
  reordenada: "Orden actualizado.",
  sincambios: "No había nada que cambiar.",
  contenido: "Contenido de la página guardado.",
  imagenguardada: "Fotografía actualizada.",
  imagenquitada: "Se quitó la fotografía. La página se sigue viendo, a una sola columna.",
};

const MENSAJES_ERROR: Record<string, string> = {
  tamano:
    "El envío era demasiado grande. Si estás subiendo una imagen, comprueba que pese menos de 5 MB.",
  sintitulo: "El título es obligatorio.",
  titulolargo: `El título admite hasta ${LIMITES_PAGINA.titulo} caracteres.`,
  sinclave: "La clave es obligatoria.",
  clavelarga: `La clave admite hasta ${LIMITES_PAGINA.clave} caracteres.`,
  claveformato:
    "La clave solo admite minúsculas, números y guiones internos. Por ejemplo: quienes-somos.",
  claverepetida: "Ya existe otra página con esa clave. Elige una diferente.",
  orden: "El orden debe ser un número.",
  noexiste: "No encontramos esa página.",
  accion: "No reconocimos la acción solicitada.",
  antetitulolargo: `El antetítulo admite hasta ${LIMITES_CONTENIDO_PAGINA.antetitulo} caracteres.`,
  tituloPaginalargo: `El titular admite hasta ${LIMITES_CONTENIDO_PAGINA.tituloPagina} caracteres.`,
  tituloDestacadolargo: `La parte destacada del titular admite hasta ${LIMITES_CONTENIDO_PAGINA.tituloDestacado} caracteres.`,
  parrafoslargo: `Los párrafos admiten hasta ${LIMITES_CONTENIDO_PAGINA.parrafos} caracteres.`,
  bloquesAntetitulolargo: `El antetítulo de los valores admite hasta ${LIMITES_CONTENIDO_PAGINA.bloquesAntetitulo} caracteres.`,
  bloquesTitulolargo: `El título de los valores admite hasta ${LIMITES_CONTENIDO_PAGINA.bloquesTitulo} caracteres.`,
  cierreTextolargo: `La frase de cierre admite hasta ${LIMITES_CONTENIDO_PAGINA.cierreTexto} caracteres.`,
  cierreDestacadolargo: `La parte destacada del cierre admite hasta ${LIMITES_CONTENIDO_PAGINA.cierreDestacado} caracteres.`,
  sinimagen: "Selecciona una imagen para actualizar la fotografía.",
  sinalt: "El texto alternativo de la imagen es obligatorio.",
  altlargo: `El texto alternativo admite hasta ${LIMITE_IMAGEN_ALT} caracteres.`,
  procesar: "No pudimos procesar la imagen. Verifica que sea un JPG, PNG o WebP válido.",
  almacen:
    "No pudimos guardar la imagen por un problema del servidor, no por el archivo. Vuelve a intentarlo en unos minutos; si persiste, avisa al equipo.",
};

const textoError = error ? (MENSAJES_ERROR[error] ?? error) : null;

const clasesCampo =
  "mt-1.5 min-h-[44px] w-full rounded-lg border border-line bg-paper px-3.5 py-2.5 text-sm outline-none focus-visible:border-brand focus-visible:ring-2 focus-visible:ring-brand/30";
const clasesBoton =
  "foco-marca inline-flex min-h-[44px] items-center justify-center gap-1.5 rounded-full border border-line bg-surface px-4 text-xs font-bold text-ink transition-colors hover:bg-surface-2 disabled:cursor-not-allowed disabled:opacity-40";
const clasesBotonPeligro =
  "foco-marca inline-flex min-h-[44px] items-center justify-center rounded-full border border-accent/40 bg-surface px-4 text-xs font-bold text-accent-deep transition-colors hover:bg-accent/10";
const clasesBotonPrincipal =
  "foco-marca inline-flex min-h-[44px] items-center rounded-full bg-brand px-7 text-sm font-bold text-white transition-colors hover:bg-brand-deep";
const clasesEnlaceAccion =
  "foco-marca inline-flex min-h-[44px] items-center justify-center gap-1.5 rounded-full border border-line bg-surface px-4 text-xs font-bold text-ink transition-colors hover:bg-surface-2";

const AYUDA_CLAVE =
  "Identificador para la dirección de la web (/nosotros/…). Solo minúsculas, números y guiones. No se repite entre páginas.";

// Formulario de contenido declarado como datos: el marcado de los ocho campos
// es idéntico y repetirlo a mano invita a que uno se quede sin `maxlength` o
// sin ayuda. Mismo criterio que /admin/lineas.
interface CampoContenido {
  clave: keyof ContenidoPagina;
  campo: string;
  etiqueta: string;
  ayuda: string;
  /** Número de filas si el campo es un textarea; ausente = input de una línea. */
  filas?: number;
  ancho?: "completo";
}

const CAMPOS_CONTENIDO: readonly CampoContenido[] = [
  {
    clave: "antetitulo",
    campo: "antetitulo",
    etiqueta: "Antetítulo",
    ayuda: "Palabra corta sobre el titular. Se muestra en mayúsculas.",
  },
  {
    clave: "tituloPagina",
    campo: "titulo_pagina",
    etiqueta: "Titular (primera parte)",
    ayuda: "El titular grande. Si lo dejas vacío se usa el título del menú.",
  },
  {
    clave: "tituloDestacado",
    campo: "titulo_destacado",
    etiqueta: "Titular (parte en azul)",
    ayuda: "Se escribe a continuación del titular, en el azul de la marca.",
  },
  {
    clave: "parrafos",
    campo: "parrafos",
    etiqueta: "Párrafos",
    ayuda: "Texto de presentación. Deja una línea en blanco para separar párrafos.",
    filas: 6,
    ancho: "completo",
  },
  {
    clave: "bloquesAntetitulo",
    campo: "bloques_antetitulo",
    etiqueta: "Antetítulo de los valores",
    ayuda: "Palabra corta sobre la fila de tarjetas. Por ejemplo: Nuestros valores.",
  },
  {
    clave: "bloquesTitulo",
    campo: "bloques_titulo",
    etiqueta: "Título de los valores",
    ayuda: "Encabezado de la fila de tarjetas.",
  },
  {
    clave: "cierreTexto",
    campo: "cierre_texto",
    etiqueta: "Frase de cierre",
    ayuda: "Frase centrada bajo las tarjetas.",
    filas: 2,
    ancho: "completo",
  },
  {
    clave: "cierreDestacado",
    campo: "cierre_destacado",
    etiqueta: "Cierre (parte en azul)",
    ayuda: "Se escribe a continuación de la frase de cierre, resaltada.",
    filas: 2,
    ancho: "completo",
  },
];
---

<PanelLayout titulo="Páginas" correo={Astro.locals.sesion?.correo}>
  <h1 class="text-2xl font-extrabold text-ink">Páginas institucionales</h1>
  <p class="mt-1 text-sm text-ink/70">
    {paginas.length} página{paginas.length === 1 ? "" : "s"}, {activas} publicada{
      activas === 1 ? "" : "s"
    }. Son las páginas de <code>/nosotros/…</code> que aparecen en el menú «Nosotros» de la web.
  </p>

  {
    /* La regla más importante de esta pantalla: se dice una vez, arriba, y se
      repite en la insignia de estado de cada página. */
  }
  <p class="mt-4 rounded-lg border border-line bg-surface-2 px-4 py-3 text-sm text-ink/80">
    <strong class="font-semibold text-ink">Una página despublicada no se ve.</strong> No aparece en el
    menú y su dirección devuelve error 404. Las páginas nuevas nacen así a propósito: publícalas recién
    cuando el contenido esté terminado.
  </p>

  {
    ok && (
      <p class="mt-4 rounded-lg bg-wa/10 px-4 py-2.5 text-sm font-semibold text-wa-deep">
        {MENSAJES_OK[ok] ?? "Listo."}
      </p>
    )
  }
  {
    textoError && (
      <p class="mt-4 rounded-lg bg-accent/10 px-4 py-2.5 text-sm font-semibold text-accent-deep">
        {textoError}
      </p>
    )
  }

  {
    paginas.length === 0 && (
      <p class="mt-6 rounded-xl border border-line bg-surface px-6 py-10 text-center text-sm text-ink/70">
        Todavía no hay páginas cargadas. Agrega la primera con el formulario de abajo.
      </p>
    )
  }

  <div class="mt-6 space-y-5">
    {
      paginas.map((pagina, posicion) => (
        <article
          id={`pagina-${pagina.id}`}
          class="rounded-xl border border-line bg-surface p-6 shadow-sm"
          aria-labelledby={`titulo-${pagina.id}`}
        >
          <div class="flex flex-wrap items-start justify-between gap-3">
            <h2 id={`titulo-${pagina.id}`} class="text-base font-bold text-ink">
              {posicion + 1}. {pagina.titulo}
            </h2>
            <span
              class:list={[
                "inline-block rounded-full px-2.5 py-0.5 text-[0.7rem] font-bold",
                pagina.activa ? "bg-wa/15 text-wa-deep" : "bg-surface-2 text-ink/70",
              ]}
            >
              {pagina.activa ? "Publicada" : "Despublicada (no se ve)"}
            </span>
          </div>

          <dl class="mt-3 flex flex-wrap gap-x-6 gap-y-1 text-sm text-ink/70">
            <div class="flex gap-1.5">
              <dt class="font-semibold text-ink">Dirección:</dt>
              <dd>
                <code>/nosotros/{pagina.clave}</code>
              </dd>
            </div>
            <div class="flex gap-1.5">
              <dt class="font-semibold text-ink">Secciones:</dt>
              <dd>{pagina._count.secciones}</dd>
            </div>
            <div class="flex gap-1.5">
              <dt class="font-semibold text-ink">Valores:</dt>
              <dd>{pagina._count.bloques}</dd>
            </div>
            <div class="flex gap-1.5">
              <dt class="font-semibold text-ink">Orden:</dt>
              <dd>{pagina.orden}</dd>
            </div>
          </dl>

          <div class="mt-4 flex flex-wrap items-center gap-2">
            <form method="post" action={`/api/admin/paginas/${pagina.id}`}>
              <input type="hidden" name="_accion" value="subir" />
              <button
                type="submit"
                class={clasesBoton}
                disabled={posicion === 0}
                aria-label={`Subir la página «${pagina.titulo}» una posición`}
              >
                <svg viewBox="0 0 24 24" class="h-4 w-4 fill-current" aria-hidden="true">
                  <path d="M12 6l6 6h-4v6h-4v-6H6l6-6Z" />
                </svg>
                Subir
              </button>
            </form>
            <form method="post" action={`/api/admin/paginas/${pagina.id}`}>
              <input type="hidden" name="_accion" value="bajar" />
              <button
                type="submit"
                class={clasesBoton}
                disabled={posicion === paginas.length - 1}
                aria-label={`Bajar la página «${pagina.titulo}» una posición`}
              >
                <svg viewBox="0 0 24 24" class="h-4 w-4 fill-current" aria-hidden="true">
                  <path d="M12 18l-6-6h4V6h4v6h4l-6 6Z" />
                </svg>
                Bajar
              </button>
            </form>
            <form method="post" action={`/api/admin/paginas/${pagina.id}`}>
              <input type="hidden" name="_accion" value="activar" />
              <button
                type="submit"
                class={clasesBoton}
                aria-label={`${pagina.activa ? "Despublicar" : "Publicar"} la página «${pagina.titulo}»`}
              >
                {pagina.activa ? "Despublicar" : "Publicar"}
              </button>
            </form>
            {/* El título no se interpola dentro del literal de JavaScript:
                escaparlo a mano es frágil y el botón ya lo dice en su
                aria-label. El resto del panel usa avisos fijos igual.
                El comentario va FUERA de la etiqueta: entre atributos, Astro lo
                lee como un atributo abreviado y rompe el análisis del archivo. */}
            <form
              method="post"
              action={`/api/admin/paginas/${pagina.id}`}
              data-confirmar={`¿Eliminar esta página? Se borran también sus ${pagina._count.secciones} sección(es) y ${pagina._count.bloques} valor(es). No se puede deshacer.`}
            >
              <input type="hidden" name="_accion" value="eliminar" />
              <button
                type="submit"
                class={clasesBotonPeligro}
                aria-label={`Eliminar la página «${pagina.titulo}»`}
              >
                Eliminar
              </button>
            </form>
          </div>

          <div class="mt-2 flex flex-wrap items-center gap-2">
            <a
              href={`/nosotros/${pagina.clave}`}
              target="_blank"
              rel="noopener"
              class={clasesEnlaceAccion}
            >
              <svg viewBox="0 0 24 24" class="h-4 w-4 fill-current" aria-hidden="true">
                <path d="M12 5c-5 0-9 4.5-9 7s4 7 9 7 9-4.5 9-7-4-7-9-7Zm0 11a4 4 0 1 1 0-8 4 4 0 0 1 0 8Zm0-6a2 2 0 1 0 0 4 2 2 0 0 0 0-4Z" />
              </svg>
              Ver página
              <span class="sr-only">
                «{pagina.titulo}» (se abre en una pestaña nueva)
                {!pagina.activa && "; está despublicada, así que verás un error 404"}
              </span>
            </a>
            <a href={`/admin/paginas/${pagina.id}/bloques`} class={clasesEnlaceAccion}>
              <svg viewBox="0 0 24 24" class="h-4 w-4 fill-current" aria-hidden="true">
                <path d="M4 4h7v7H4V4Zm9 0h7v7h-7V4ZM4 13h7v7H4v-7Zm9 0h7v7h-7v-7Z" />
              </svg>
              Secciones y valores
              <span class="sr-only">de «{pagina.titulo}»</span>
            </a>
          </div>

          <form
            method="post"
            action={`/api/admin/paginas/${pagina.id}`}
            class="mt-5 border-t border-line pt-5"
          >
            <div class="grid gap-4 sm:grid-cols-2">
              <label class="block">
                <span class="text-sm font-semibold text-ink">
                  Título <span class="text-accent-deep">*</span>
                </span>
                <input
                  type="text"
                  name="titulo"
                  required
                  maxlength={LIMITES_PAGINA.titulo}
                  value={pagina.titulo}
                  aria-describedby={`ayuda-titulo-${pagina.id}`}
                  class={clasesCampo}
                />
                <span id={`ayuda-titulo-${pagina.id}`} class="mt-1.5 block text-xs text-ink/70">
                  Es el nombre con el que la página aparece en el menú «Nosotros».
                </span>
              </label>
              <div class="grid grid-cols-2 gap-4">
                <label class="block">
                  <span class="text-sm font-semibold text-ink">
                    Clave <span class="text-accent-deep">*</span>
                  </span>
                  <input
                    type="text"
                    name="clave"
                    required
                    maxlength={LIMITES_PAGINA.clave}
                    pattern="[a-z0-9]+(-[a-z0-9]+)*"
                    value={pagina.clave}
                    aria-describedby={`ayuda-clave-${pagina.id}`}
                    class={clasesCampo}
                  />
                </label>
                <label class="block">
                  <span class="text-sm font-semibold text-ink">Orden</span>
                  <input type="number" name="orden" value={pagina.orden} class={clasesCampo} />
                </label>
              </div>
              <span id={`ayuda-clave-${pagina.id}`} class="text-xs text-ink/70 sm:col-span-2">
                {AYUDA_CLAVE}
              </span>
            </div>
            <button type="submit" class:list={[clasesBotonPrincipal, "mt-5"]}>
              Guardar cambios
            </button>
          </form>

          {/* El contenido va plegado: son ocho campos más y desplegados dejaban
              la lista imposible de recorrer. <details> funciona con teclado y
              sin JavaScript. */}
          <details id={`contenido-${pagina.id}`} class="mt-5 border-t border-line pt-5">
            <summary class="foco-marca inline-flex min-h-[44px] cursor-pointer list-none items-center gap-2 text-sm font-bold text-brand [&::-webkit-details-marker]:hidden">
              <svg viewBox="0 0 24 24" class="h-4 w-4 fill-current" aria-hidden="true">
                <path d="M7 10l5 5 5-5H7Z" />
              </svg>
              Contenido de la página pública
            </summary>

            <p class="mt-3 text-sm text-ink/70">
              Textos de <code>/nosotros/{pagina.clave}</code>. Cada campo vacío simplemente no se
              dibuja: una página con solo titular y párrafos se ve entera igual.
            </p>

            <form
              method="post"
              action={`/api/admin/paginas/contenido/${pagina.id}`}
              class="mt-5 grid gap-4 sm:grid-cols-2"
            >
              {CAMPOS_CONTENIDO.map((campo) => {
                const valor = pagina[campo.clave] ?? "";
                const idAyuda = `ayuda-${campo.campo}-${pagina.id}`;
                return (
                  <label class:list={["block", campo.ancho === "completo" && "sm:col-span-2"]}>
                    <span class="text-sm font-semibold text-ink">{campo.etiqueta}</span>
                    {campo.filas ? (
                      // `set:text`: el relleno que el formateador metia entre las
                      // etiquetas era parte del valor y consumia el maxlength.
                      <textarea
                        name={campo.campo}
                        rows={campo.filas}
                        maxlength={LIMITES_CONTENIDO_PAGINA[campo.clave]}
                        aria-describedby={idAyuda}
                        class={clasesCampo}
                        set:text={valor}
                      />
                    ) : (
                      <input
                        type="text"
                        name={campo.campo}
                        maxlength={LIMITES_CONTENIDO_PAGINA[campo.clave]}
                        value={valor}
                        aria-describedby={idAyuda}
                        class={clasesCampo}
                      />
                    )}
                    <span id={idAyuda} class="mt-1.5 block text-xs text-ink/70">
                      {campo.ayuda} Hasta {LIMITES_CONTENIDO_PAGINA[campo.clave]} caracteres.
                    </span>
                  </label>
                );
              })}
              <div class="sm:col-span-2">
                <button type="submit" class={clasesBotonPrincipal}>
                  Guardar contenido
                </button>
              </div>
            </form>

            {/* Fotografía: formulario aparte porque va en multipart y su
                validación (formato, peso, medidas) no tiene que ver con los textos. */}
            <div id={`imagen-${pagina.id}`} class="mt-8 border-t border-line pt-6">
              <h3 class="text-base font-bold text-ink">Fotografía</h3>
              <p class="mt-1 text-sm text-ink/70">
                Imagen horizontal que acompaña al titular. Sin imagen, el hero se ve igual a una
                sola columna.
              </p>

              {pagina.imagenUrl && (
                <div class="mt-4 flex flex-wrap items-start gap-4">
                  <img
                    src={pagina.imagenUrl}
                    alt=""
                    width={pagina.ancho ?? 1600}
                    height={pagina.alto ?? 1200}
                    class="w-40 rounded-lg bg-paper object-contain ring-1 ring-line"
                    style="height:auto"
                    loading="lazy"
                  />
                  <p class="max-w-[30ch] flex-1 text-xs leading-relaxed text-ink/70">
                    <span class="font-semibold text-ink">Texto alternativo actual:</span>{" "}
                    {pagina.imagenAlt}
                  </p>
                </div>
              )}

              <form
                method="post"
                action={`/api/admin/paginas/imagen/${pagina.id}`}
                enctype="multipart/form-data"
                class="mt-4"
              >
                <label
                  class="block text-sm font-semibold text-ink"
                  for={`imagen-archivo-${pagina.id}`}
                >
                  Nueva imagen <span class="text-accent-deep">*</span>
                </label>
                <input
                  type="file"
                  id={`imagen-archivo-${pagina.id}`}
                  name="imagen"
                  accept=".jpg,.jpeg,.png,.webp"
                  required
                  aria-describedby={`imagen-ayuda-${pagina.id}`}
                  class="mt-2 block w-full text-sm text-ink/75 file:mr-3 file:min-h-[44px] file:rounded-full file:border-0 file:bg-surface-2 file:px-4 file:text-sm file:font-semibold file:text-brand-deep hover:file:bg-line"
                />
                <p id={`imagen-ayuda-${pagina.id}`} class="mt-1.5 text-xs text-ink/70">
                  JPG, PNG o WebP. Máximo 5 MB. Orientación horizontal. Las que están cargadas hoy
                  son recortes provisionales del diseño: reemplázalas apenas llegue la fotografía
                  original.
                </p>

                <label class="mt-4 block">
                  <span class="text-sm font-semibold text-ink">
                    Texto alternativo <span class="text-accent-deep">*</span>
                  </span>
                  <input
                    type="text"
                    name="imagen_alt"
                    required
                    maxlength={LIMITE_IMAGEN_ALT}
                    value={pagina.imagenAlt ?? ""}
                    aria-describedby={`imagen-alt-ayuda-${pagina.id}`}
                    class={clasesCampo}
                  />
                </label>
                <p id={`imagen-alt-ayuda-${pagina.id}`} class="mt-1.5 text-xs text-ink/70">
                  Describe qué se ve en la imagen: lo leen los lectores de pantalla.
                </p>

                <button type="submit" class:list={[clasesBotonPrincipal, "mt-5"]}>
                  Guardar imagen
                </button>
              </form>

              {pagina.imagenUrl && (
                <form
                  method="post"
                  action={`/api/admin/paginas/imagen/${pagina.id}`}
                  class="mt-3"
                  data-confirmar="¿Quitar la fotografía? Se eliminará el archivo cargado y la página quedará sin foto."
                >
                  <input type="hidden" name="_accion" value="restaurar" />
                  <button
                    type="submit"
                    class="foco-marca inline-flex min-h-[44px] items-center rounded-full border border-accent/40 px-5 text-xs font-bold text-accent-deep transition-colors hover:bg-accent/10"
                  >
                    Quitar la fotografía
                  </button>
                </form>
              )}
            </div>
          </details>
        </article>
      ))
    }
  </div>

  <form
    method="post"
    action="/api/admin/paginas"
    class="mt-8 max-w-2xl rounded-xl border border-line bg-surface p-6 shadow-sm md:p-8"
  >
    <h2 class="text-lg font-bold text-ink">Agregar página</h2>
    <p class="mt-1.5 text-sm text-ink/70">
      Se crea despublicada y vacía. Escribe su contenido y publícala cuando esté lista.
    </p>

    <div class="mt-5 grid gap-4 sm:grid-cols-2">
      <label class="block">
        <span class="text-sm font-semibold text-ink">
          Título <span class="text-accent-deep">*</span>
        </span>
        <input
          type="text"
          name="titulo"
          required
          maxlength={LIMITES_PAGINA.titulo}
          placeholder="Ej. Compromiso"
          class={clasesCampo}
        />
      </label>
      <div class="grid grid-cols-2 gap-4">
        <label class="block">
          <span class="text-sm font-semibold text-ink">
            Clave <span class="text-accent-deep">*</span>
          </span>
          <input
            type="text"
            name="clave"
            required
            maxlength={LIMITES_PAGINA.clave}
            pattern="[a-z0-9]+(-[a-z0-9]+)*"
            placeholder="Ej. compromiso"
            aria-describedby="ayuda-clave-nueva"
            class={clasesCampo}
          />
        </label>
        <label class="block">
          <span class="text-sm font-semibold text-ink">Orden</span>
          <input type="number" name="orden" value={paginas.length + 1} class={clasesCampo} />
        </label>
      </div>
      <span id="ayuda-clave-nueva" class="text-xs text-ink/70 sm:col-span-2">{AYUDA_CLAVE}</span>
    </div>

    <button type="submit" class:list={[clasesBotonPrincipal, "mt-6"]}>Agregar página</button>
  </form>
</PanelLayout>
