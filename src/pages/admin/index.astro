---
import PanelLayout from "../../layouts/PanelLayout.astro";
import { bd } from "../../lib/bd";

export const prerender = false;

// Se agrupa por linea y dentro de cada una por orden, igual que el catalogo
// publico. Un libro sin linea (solo puede quedar asi si se borro la suya) cae al
// final: en Postgres los nulos ordenan ultimos en ascendente.
//
// El desempate por fecha es el MISMO que usa /api/admin/libros/[id] al mover un
// libro: si las dos listas no coinciden, los botones Subir y Bajar moverian una
// fila distinta de la que se ve.
const libros = await bd.libro.findMany({
  orderBy: [{ lineaRel: { orden: "asc" } }, { orden: "asc" }, { creadoEn: "asc" }],
  include: { lineaRel: { select: { etiquetaCorta: true } } },
});
const ok = Astro.url.searchParams.get("ok");
const error = Astro.url.searchParams.get("error");

const MENSAJES_OK: Record<string, string> = {
  creado: "Libro creado correctamente.",
  guardado: "Cambios guardados.",
  eliminado: "Libro eliminado.",
  reordenado: "Orden actualizado.",
  sincambios: "No había nada que cambiar.",
};

const MENSAJES_ERROR: Record<string, string> = {
  tamano:
    "El envío era demasiado grande. Si estás subiendo una imagen, comprueba que pese menos de 5 MB.",
  noexiste: "No encontramos ese libro.",
  sinlinea: "Ese libro no tiene línea asignada, así que no hay un orden que cambiar.",
};

const textoError = error ? (MENSAJES_ERROR[error] ?? error) : null;

// Un libro sin linea no se muestra en la web: hay que decirlo, no esconderlo.
const sinLinea = libros.filter((libro) => !libro.lineaRel).length;

// Posicion de cada libro DENTRO de su linea: es el ambito en el que se reordena,
// porque la web recorre los libros linea por linea. Se calcula de una pasada
// sobre la lista ya ordenada.
const totalPorLinea = new Map<string, number>();
const posicionEnLinea = new Map<string, number>();
for (const libro of libros) {
  if (!libro.lineaId) continue;
  const posicion = (totalPorLinea.get(libro.lineaId) ?? 0) + 1;
  totalPorLinea.set(libro.lineaId, posicion);
  posicionEnLinea.set(libro.id, posicion);
}

const clasesBoton =
  "foco-marca inline-flex min-h-[44px] items-center justify-center gap-1.5 rounded-full border border-line bg-surface px-4 text-xs font-bold text-ink transition-colors hover:bg-surface-2 disabled:cursor-not-allowed disabled:opacity-40";
---

<PanelLayout titulo="Libros" correo={Astro.locals.sesion?.correo}>
  <div class="flex flex-wrap items-center justify-between gap-4">
    <div>
      <h1 class="text-2xl font-extrabold text-ink">Libros</h1>
      <p class="mt-1 text-sm text-ink/60">
        {libros.length} título{libros.length === 1 ? "" : "s"} en el catálogo. Los cambios se publican
        al instante en la web.
      </p>
    </div>
    <a
      href="/admin/libros/nuevo"
      class="rounded-full bg-brand px-6 py-2.5 text-sm font-bold text-white transition-colors hover:bg-brand-deep"
    >
      + Agregar libro
    </a>
  </div>

  {
    ok && (
      <p class="mt-4 rounded-lg bg-wa/10 px-4 py-2.5 text-sm font-semibold text-[#15803d]">
        {MENSAJES_OK[ok] ?? "Listo."}
      </p>
    )
  }
  {
    textoError && (
      <p class="mt-4 rounded-lg bg-accent/10 px-4 py-2.5 text-sm font-semibold text-accent-deep">
        {textoError}
      </p>
    )
  }

  {
    sinLinea > 0 && (
      <p class="mt-4 rounded-lg border border-accent/30 bg-accent/10 px-4 py-2.5 text-sm font-semibold text-accent-deep">
        {sinLinea === 1
          ? "Hay 1 libro sin línea asignada. No se muestra"
          : `Hay ${sinLinea} libros sin línea asignada. No se muestran`}{" "}
        en la web hasta que le asignes una desde su ficha.
      </p>
    )
  }

  <div class="mt-6 overflow-x-auto rounded-xl border border-line bg-surface shadow-sm">
    <table class="w-full text-sm">
      <thead>
        <tr
          class="border-b border-line text-left text-xs font-bold tracking-wide text-ink/60 uppercase"
        >
          <th class="px-4 py-3">Portada</th>
          <th class="px-4 py-3">Título</th>
          <th class="px-4 py-3">Línea</th>
          <th class="px-4 py-3">Grado / Nivel</th>
          <th class="px-4 py-3">Orden</th>
          <th class="px-4 py-3 text-right">Acciones</th>
        </tr>
      </thead>
      <tbody>
        {
          libros.map((libro) => {
            // Los botones de orden mueven el libro dentro de SU linea: un libro
            // huerfano no esta en ninguna lista y no los muestra.
            const posicion = posicionEnLinea.get(libro.id);
            const total = libro.lineaId ? (totalPorLinea.get(libro.lineaId) ?? 0) : 0;
            return (
              <tr class="border-b border-line/60 last:border-0">
                <td class="px-4 py-3">
                  <img
                    src={libro.portadaUrl}
                    alt=""
                    class="h-16 w-12 rounded object-cover ring-1 ring-line"
                    loading="lazy"
                  />
                </td>
                <td class="px-4 py-3 font-semibold text-ink">{libro.titulo}</td>
                {/* El huerfano se marca, no se disimula con un guion: un libro
                  sin linea desaparecio de la web y eso hay que verlo. */}
                <td class="px-4 py-3">
                  {libro.lineaRel ? (
                    <span class="text-ink/70">{libro.lineaRel.etiquetaCorta}</span>
                  ) : (
                    <span class="rounded-full bg-accent/10 px-2.5 py-0.5 text-[0.7rem] font-bold text-accent-deep">
                      Sin línea
                    </span>
                  )}
                </td>
                <td class="px-4 py-3 text-ink/70">{libro.grado ?? libro.nivel ?? "—"}</td>
                <td class="px-4 py-3 text-ink/70">{libro.orden}</td>
                <td class="px-4 py-3">
                  <div class="flex flex-wrap items-center justify-end gap-2">
                    {posicion !== undefined && (
                      <>
                        <form method="post" action={`/api/admin/libros/${libro.id}`}>
                          <input type="hidden" name="_accion" value="subir" />
                          <button
                            type="submit"
                            class={clasesBoton}
                            disabled={posicion === 1}
                            aria-label={`Subir «${libro.titulo}» una posición dentro de su línea`}
                          >
                            <svg
                              viewBox="0 0 24 24"
                              class="h-4 w-4 fill-current"
                              aria-hidden="true"
                            >
                              <path d="M12 6l6 6h-4v6h-4v-6H6l6-6Z" />
                            </svg>
                            Subir
                          </button>
                        </form>
                        <form method="post" action={`/api/admin/libros/${libro.id}`}>
                          <input type="hidden" name="_accion" value="bajar" />
                          <button
                            type="submit"
                            class={clasesBoton}
                            disabled={posicion === total}
                            aria-label={`Bajar «${libro.titulo}» una posición dentro de su línea`}
                          >
                            <svg
                              viewBox="0 0 24 24"
                              class="h-4 w-4 fill-current"
                              aria-hidden="true"
                            >
                              <path d="M12 18l-6-6h4V6h4v6h4l-6 6Z" />
                            </svg>
                            Bajar
                          </button>
                        </form>
                      </>
                    )}
                    <a
                      href={`/admin/libros/${libro.id}`}
                      class="foco-marca inline-flex min-h-[44px] items-center px-2 font-semibold text-brand hover:text-brand-deep"
                    >
                      Editar<span class="sr-only"> «{libro.titulo}»</span>
                    </a>
                  </div>
                </td>
              </tr>
            );
          })
        }
      </tbody>
    </table>
  </div>
</PanelLayout>
