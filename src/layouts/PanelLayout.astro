---
import Layout from "./Layout.astro";
import { bd } from "./../lib/bd";

interface Props {
  titulo: string;
  correo?: string;
}

const { titulo, correo } = Astro.props;

// Conteo barato (una sola columna indexada por PK) para avisar de pendientes.
const mensajesPendientes = correo ? await bd.mensaje.count({ where: { atendido: false } }) : 0;

// Secciones del panel, en el orden en que aparecen en la página pública.
const SECCIONES = [
  { href: "/admin", etiqueta: "Libros" },
  { href: "/admin/portada", etiqueta: "Portada" },
  { href: "/admin/imagenes", etiqueta: "Imágenes" },
  { href: "/admin/preguntas", etiqueta: "Preguntas" },
  { href: "/admin/mensajes", etiqueta: "Mensajes" },
  { href: "/admin/ajustes", etiqueta: "Ajustes" },
  { href: "/admin/cuenta", etiqueta: "Mi cuenta" },
];

// `/admin` es prefijo de todo el panel: solo coincide de forma exacta.
const rutaActual = Astro.url.pathname.replace(/\/$/, "") || "/admin";
const esActual = (href: string): boolean =>
  href === "/admin" ? rutaActual === "/admin" : rutaActual.startsWith(href);
---

<Layout
  title={`${titulo} — Panel HTB`}
  description="Panel de administración de Human Touch Books"
  noindex
>
  <div class="min-h-screen bg-paper">
    <header class="border-b border-line bg-navy text-white">
      <div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 py-3 md:px-6">
        <a href="/admin" class="flex items-center gap-3 font-bold">
          <img src="/brand/logo.png" alt="" class="h-9 w-auto rounded bg-white/95 px-1.5 py-0.5" />
          Panel de administración
        </a>
        {
          correo && (
            <div class="flex flex-wrap items-center justify-end gap-x-4 gap-y-1 text-sm">
              <nav aria-label="Secciones del panel">
                <ul class="flex flex-wrap items-center gap-x-4 gap-y-1">
                  {SECCIONES.map((seccion) => (
                    <li>
                      <a
                        href={seccion.href}
                        aria-current={esActual(seccion.href) ? "page" : undefined}
                        class:list={[
                          "foco-claro inline-flex min-h-[44px] items-center gap-1.5 transition-colors hover:text-white",
                          esActual(seccion.href)
                            ? "font-bold text-white underline decoration-2 underline-offset-8"
                            : "text-white/85",
                        ]}
                      >
                        {seccion.etiqueta}
                        {seccion.href === "/admin/mensajes" && mensajesPendientes > 0 && (
                          <span
                            class="grid min-w-[1.35rem] place-items-center rounded-full bg-accent px-1.5 py-0.5 text-[0.7rem] font-bold text-white"
                            aria-label={`${mensajesPendientes} sin atender`}
                          >
                            {mensajesPendientes}
                          </span>
                        )}
                      </a>
                    </li>
                  ))}
                </ul>
              </nav>
              <a
                href="/"
                class="foco-claro inline-flex min-h-[44px] items-center text-white/85 transition-colors hover:text-white"
              >
                Ver sitio
              </a>
              <form method="post" action="/api/admin/salir">
                <button
                  type="submit"
                  class="foco-claro inline-flex min-h-[44px] items-center rounded-full border border-white/40 px-4 font-semibold transition-colors hover:bg-white/10"
                >
                  Salir
                </button>
              </form>
            </div>
          )
        }
      </div>
    </header>
    <main class="mx-auto max-w-5xl px-4 py-8 md:px-6">
      <slot />
    </main>
  </div>
</Layout>
