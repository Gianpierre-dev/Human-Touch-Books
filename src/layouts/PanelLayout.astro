---
import Layout from "./Layout.astro";
import NavPanel from "../components/NavPanel.astro";
import { bd } from "./../lib/bd";

interface Props {
  titulo: string;
  correo?: string;
}

const { titulo, correo } = Astro.props;

// Conteo barato (una sola columna indexada por PK) para avisar de pendientes.
const mensajesPendientes = correo ? await bd.mensaje.count({ where: { atendido: false } }) : 0;

const rutaActual = Astro.url.pathname.replace(/\/$/, "") || "/admin";
---

<Layout
  title={`${titulo} — Panel HTB`}
  description="Panel de administración de Human Touch Books"
  anclaContenido="#contenido-panel"
  noindex
>
  <div class="min-h-screen bg-paper lg:grid lg:grid-cols-[17rem_1fr]">
    {
      /* Barra lateral fija en escritorio: con una decena de secciones, una barra
        horizontal obliga a repartir los enlaces en dos lineas y deja de leerse
        de un vistazo. La lateral crece sin romperse. */
    }
    <aside
      class="sticky top-0 hidden h-screen flex-col border-r border-white/10 bg-navy text-white lg:flex"
    >
      <a
        href="/admin"
        class="foco-claro flex items-center gap-3 border-b border-white/10 px-4 py-4 font-bold"
      >
        <img src="/brand/logo.webp" alt="" class="h-9 w-auto rounded bg-white/95 px-1.5 py-0.5" />
        <span class="text-[0.95rem] leading-tight">Panel de<br />administración</span>
      </a>

      <div class="panel-desplazable flex-1 overflow-y-auto px-3 py-4">
        {correo && <NavPanel rutaActual={rutaActual} mensajesPendientes={mensajesPendientes} />}
      </div>

      {
        correo && (
          <div class="border-t border-white/10 px-3 py-3">
            <p class="truncate px-3 pb-1 text-xs text-white/60" title={correo}>
              {correo}
            </p>
            <a
              href="/"
              class="foco-claro flex min-h-[44px] items-center gap-3 rounded-lg px-3 text-[0.9375rem] font-semibold text-white/80 transition-colors hover:bg-white/10 hover:text-white"
            >
              <svg viewBox="0 0 24 24" class="h-5 w-5 shrink-0 fill-current" aria-hidden="true">
                <path d="M12 3 2 12h3v8h6v-5h2v5h6v-8h3L12 3Z" />
              </svg>
              Ver sitio
            </a>
            <form method="post" action="/api/admin/salir">
              <button
                type="submit"
                class="foco-claro flex min-h-[44px] w-full items-center gap-3 rounded-lg px-3 text-[0.9375rem] font-semibold text-white/80 transition-colors hover:bg-white/10 hover:text-white"
              >
                <svg viewBox="0 0 24 24" class="h-5 w-5 shrink-0 fill-current" aria-hidden="true">
                  <path d="M10 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h5v-2H5V5h5V3Zm6.2 4.6-1.4 1.4 2 2H8v2h8.8l-2 2 1.4 1.4L21 12l-4.8-4.4Z" />
                </svg>
                Cerrar sesión
              </button>
            </form>
          </div>
        )
      }
    </aside>

    {
      /* En pantallas menores la misma navegacion vive en un cajon desplegable.
        Es <details>: funciona con teclado y sin JavaScript. */
    }
    <header class="sticky top-0 z-40 border-b border-white/10 bg-navy text-white lg:hidden">
      <div class="flex items-center justify-between gap-3 px-4 py-2.5">
        <a href="/admin" class="foco-claro flex items-center gap-2.5 font-bold">
          <img src="/brand/logo.webp" alt="" class="h-8 w-auto rounded bg-white/95 px-1.5 py-0.5" />
          <span class="text-sm">Panel</span>
        </a>

        {
          correo && (
            <details id="menu-panel" class="relative">
              <summary class="foco-claro inline-flex min-h-[44px] min-w-[44px] cursor-pointer list-none items-center justify-center gap-2 rounded-full border border-white/35 px-3 text-sm font-semibold transition-colors hover:bg-white/10 [&::-webkit-details-marker]:hidden">
                <svg viewBox="0 0 24 24" class="h-5 w-5 fill-current" aria-hidden="true">
                  <path d="M3 6h18v2H3V6Zm0 5h18v2H3v-2Zm0 5h18v2H3v-2Z" />
                </svg>
                <span class="sr-only">Abrir menú del panel</span>
                {mensajesPendientes > 0 && (
                  <span
                    class="grid min-w-[1.3rem] place-items-center rounded-full bg-accent px-1.5 text-[0.7rem] font-bold"
                    aria-label={`${mensajesPendientes} mensajes sin atender`}
                  >
                    {mensajesPendientes}
                  </span>
                )}
              </summary>

              <div class="absolute right-0 z-50 mt-2.5 w-72 rounded-xl border border-white/15 bg-navy p-3 shadow-2xl">
                <NavPanel rutaActual={rutaActual} mensajesPendientes={mensajesPendientes} />
                <div class="mt-4 border-t border-white/10 pt-3">
                  <p class="truncate px-3 pb-1 text-xs text-white/60">{correo}</p>
                  <a
                    href="/"
                    class="foco-claro flex min-h-[44px] items-center rounded-lg px-3 text-[0.9375rem] font-semibold text-white/80 transition-colors hover:bg-white/10 hover:text-white"
                  >
                    Ver sitio
                  </a>
                  <form method="post" action="/api/admin/salir">
                    <button
                      type="submit"
                      class="foco-claro flex min-h-[44px] w-full items-center rounded-lg px-3 text-[0.9375rem] font-semibold text-white/80 transition-colors hover:bg-white/10 hover:text-white"
                    >
                      Cerrar sesión
                    </button>
                  </form>
                </div>
              </div>
            </details>
          )
        }
      </div>
    </header>

    <div class="min-w-0">
      <main id="contenido-panel" tabindex="-1" class="mx-auto max-w-5xl px-4 py-8 md:px-6">
        <slot />
      </main>
    </div>
  </div>

  {
    /* Modal de confirmacion compartido por todo el panel. Reemplaza al
      confirm() nativo del navegador: mismo mensaje, pero con la marca, foco
      atrapado y Escape gratis (elemento <dialog>). Los formularios se acogen
      con data-confirmar="mensaje"; Cancelar va primero en el DOM para que
      reciba el foco inicial — en una accion destructiva, el valor por defecto
      seguro es NO hacerla. */
  }
  <dialog
    id="dialogo-confirmar"
    class="m-auto w-[min(26rem,calc(100vw-2rem))] rounded-xl border border-line bg-surface p-6 shadow-2xl backdrop:bg-grafito/55"
    aria-labelledby="dialogo-confirmar-titulo"
    aria-describedby="dialogo-confirmar-mensaje"
  >
    <h2 id="dialogo-confirmar-titulo" class="text-lg font-bold text-ink">¿Estás seguro?</h2>
    <p id="dialogo-confirmar-mensaje" class="mt-2 text-sm leading-relaxed text-ink/75"></p>
    <div class="mt-6 flex flex-wrap justify-end gap-2.5">
      <form method="dialog">
        <button
          class="foco-marca inline-flex min-h-[44px] items-center rounded-full border border-line bg-surface px-5 text-sm font-bold text-ink transition-colors hover:bg-surface-2"
        >
          Cancelar
        </button>
      </form>
      <button
        type="button"
        id="dialogo-confirmar-boton"
        class="foco-marca inline-flex min-h-[44px] items-center rounded-full bg-accent-deep px-5 text-sm font-bold text-white transition-colors hover:bg-accent"
      >
        Sí, continuar
      </button>
    </div>
  </dialog>

  <script is:inline>
    (() => {
      const dialogo = document.getElementById("dialogo-confirmar");
      const mensaje = document.getElementById("dialogo-confirmar-mensaje");
      const botonConfirmar = document.getElementById("dialogo-confirmar-boton");
      if (!(dialogo instanceof HTMLDialogElement) || !mensaje || !botonConfirmar) return;

      let formularioPendiente = null;

      // Delegado en el documento: sirve a todos los formularios de la pagina,
      // incluidos los que esten dentro de tablas largas.
      document.addEventListener("submit", (evento) => {
        const formulario = evento.target;
        if (!(formulario instanceof HTMLFormElement) || !formulario.dataset.confirmar) return;
        evento.preventDefault();
        formularioPendiente = formulario;
        mensaje.textContent = formulario.dataset.confirmar;
        dialogo.showModal();
      });

      botonConfirmar.addEventListener("click", () => {
        const formulario = formularioPendiente;
        formularioPendiente = null;
        dialogo.close();
        // submit() directo: no re-dispara el evento submit y no vuelve a abrir
        // el modal. Son formularios de accion (campos ocultos), sin validacion.
        if (formulario) formulario.submit();
      });

      // Cancelar, Escape o clic fuera: se olvida el formulario pendiente.
      dialogo.addEventListener("close", () => {
        formularioPendiente = null;
      });
      dialogo.addEventListener("click", (evento) => {
        if (evento.target === dialogo) dialogo.close();
      });
    })();
  </script>

  <script is:inline>
    (() => {
      // Guardar dispara una recarga completa que puede tardar (subidas de
      // imagen sobre todo): sin freno, un segundo clic crea la fila dos veces.
      const ETIQUETA = "Guardando…";
      // Contenido previo de cada boton bloqueado. Vive en memoria, que
      // sobrevive al bfcache igual que el DOM que este restaura.
      const originales = new Map();

      // En captura, para adelantarse a cualquier manejador de la pagina que
      // detuviera la propagacion del submit.
      document.addEventListener(
        "submit",
        (evento) => {
          const formulario = evento.target;
          if (!(formulario instanceof HTMLFormElement)) return;

          // `method="dialog"` NO navega: solo cierra el <dialog>. Bloquear su
          // boton lo dejaria inservible para siempre, porque no hay recarga que
          // lo restaure. Es el caso del «Cancelar» del modal de confirmacion, y
          // ademas de no poder cancelarse, al perder el foco inicial este
          // pasaria al boton rojo: un Enter reflejo borraria la fila.
          if (formulario.getAttribute("method")?.toLowerCase() === "dialog") return;

          const boton =
            evento.submitter ??
            formulario.querySelector("button[type='submit'], button:not([type])");
          if (!(boton instanceof HTMLButtonElement) || boton.disabled) return;

          // Se aplaza al final del ciclo por dos razones: un boton deshabilitado
          // no aporta su propio name/value al envio, y aqui todavia no se sabe
          // si el modal de confirmacion (escucha en burbuja) cancelara el submit.
          setTimeout(() => {
            if (evento.defaultPrevented || boton.disabled) return;
            originales.set(boton, boton.innerHTML);
            boton.textContent = ETIQUETA;
            boton.disabled = true;
          }, 0);
        },
        true,
      );

      // Volver con el historial reusa el DOM tal como quedo: el boton seguiria
      // bloqueado y diciendo «Guardando…» sobre un formulario que si se puede
      // reenviar.
      addEventListener("pageshow", (evento) => {
        if (!evento.persisted) return;
        originales.forEach((contenido, boton) => {
          boton.innerHTML = contenido;
          boton.disabled = false;
        });
        originales.clear();
      });
    })();
  </script>

  <script is:inline>
    (() => {
      // El panel navega con recargas completas y la barra lateral renace con el
      // scroll arriba: estando en un modulo del fondo, el item activo quedaba
      // fuera de la vista. Se restaura la posicion anterior (sessionStorage,
      // muere al cerrar la pestana) y, como garantia, si el item activo quedo
      // fuera del area visible se desplaza lo minimo para verlo.
      const zona = document.querySelector(".panel-desplazable");
      if (!zona) return;
      const CLAVE = "panel-scroll-navegacion";
      try {
        const guardado = sessionStorage.getItem(CLAVE);
        if (guardado !== null) zona.scrollTop = Number(guardado);
      } catch {
        /* sin sessionStorage (modo privado estricto) simplemente no se restaura */
      }
      const activo = zona.querySelector('[aria-current="page"]');
      if (activo) {
        const marcoZona = zona.getBoundingClientRect();
        const marcoActivo = activo.getBoundingClientRect();
        if (marcoActivo.top < marcoZona.top || marcoActivo.bottom > marcoZona.bottom) {
          activo.scrollIntoView({ block: "nearest" });
        }
      }
      addEventListener("pagehide", () => {
        try {
          sessionStorage.setItem(CLAVE, String(zona.scrollTop));
        } catch {
          /* nada que guardar si no hay almacenamiento */
        }
      });
    })();
  </script>

  <script is:inline>
    (() => {
      const menu = document.getElementById("menu-panel");
      if (!menu) return;
      // Al elegir una seccion el cajon se cierra solo; en un enlace que navega
      // no se nota, pero evita que quede abierto si el destino es la misma pagina.
      menu.addEventListener("click", (evento) => {
        if (evento.target instanceof Element && evento.target.closest("a")) {
          menu.removeAttribute("open");
        }
      });
    })();
  </script>
</Layout>
