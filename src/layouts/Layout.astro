---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  /** Ancla del contenido principal. Si se pasa, se pinta el enlace de salto. */
  anclaContenido?: string;
}

const {
  title = "Human Touch Books — Editorial",
  description = "Editorial peruana especializada en tutoría, convivencia escolar y literatura con sentido humano. Serie Tutoría SMART para primaria y libros que acompañan.",
  noindex = false,
  anclaContenido,
} = Astro.props;

// Detras del proxy de Railway el adapter descarta Host y X-Forwarded-Host
// (Astro solo los acepta con security.allowedDomains), asi que Astro.url.origin
// resuelve a localhost. El dominio real vive en `site` de astro.config.mjs.
const base = Astro.site ?? new URL(Astro.url.origin);
const urlCanonica = new URL(Astro.url.pathname, base).href;
// Imagen social dedicada 1200x630 (la genera scripts/generar-og.mjs).
const imagenSocial = new URL("/og/portada-social.jpg", base).href;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f6f9fd" />
    <meta name="color-scheme" content="light" />
    <link rel="icon" type="image/png" href="/brand/logo.png" />
    <link rel="canonical" href={urlCanonica} />
    {noindex && <meta name="robots" content="noindex" />}
    <title>{title}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Hanken+Grotesk:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={urlCanonica} />
    <meta property="og:image" content={imagenSocial} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="es_PE" />
    <meta property="og:site_name" content="Human Touch Books" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body class="min-h-screen antialiased">
    {anclaContenido && <a class="salto-contenido" href={anclaContenido}>Saltar al contenido</a>}
    <slot />
  </body>
</html>
