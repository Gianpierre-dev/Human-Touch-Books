---
import "../styles/global.css";
// `?url` resuelve a la MISMA ruta con hash que emite el CSS: si el precargado
// apuntara a otra URL, el navegador descargaria la fuente dos veces.
import urlFuenteSans from "../fonts/hanken-grotesk-variable-latin.woff2?url";
import urlFuenteSerif from "../fonts/fraunces-variable-latin.woff2?url";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  /** Ancla del contenido principal. Si se pasa, se pinta el enlace de salto. */
  anclaContenido?: string;
  /**
   * Imagen de la tarjeta social de ESTA pagina. Sin ella se usa la portada
   * social general del sitio.
   */
  imagenSocial?: ImagenSocial;
}

/**
 * Imagen de tarjeta social. Las medidas van JUNTO a la ruta y no como props
 * sueltas: anunciar un tamaño que no es el de la imagen hace que la red
 * recorte mal la tarjeta, y separarlas permitiria desparejarlas sin querer.
 */
export interface ImagenSocial {
  /** Ruta del propio sitio ("/lineas/primaria-hero.jpg", "/uploads/…"). */
  url: string;
  /**
   * Descripcion de la imagen para la tarjeta social. Sin ella, quien navega
   * con lector de pantalla en la red social solo oye el titulo del enlace.
   */
  alt?: string;
  /** Medidas REALES. Solo se declaran si se conocen las dos. */
  ancho?: number;
  alto?: number;
}

const {
  title = "Human Touch Books — Editorial",
  description = "Editorial peruana especializada en tutoría, convivencia escolar y literatura con sentido humano. Serie Tutoría SMART para primaria y libros que acompañan.",
  noindex = false,
  anclaContenido,
  imagenSocial,
} = Astro.props;

// Detras del proxy de Railway el adapter descarta Host y X-Forwarded-Host
// (Astro solo los acepta con security.allowedDomains), asi que Astro.url.origin
// resuelve a localhost. El dominio real vive en `site` de astro.config.mjs.
const base = Astro.site ?? new URL(Astro.url.origin);
const urlCanonica = new URL(Astro.url.pathname, base).href;
// Imagen social dedicada 1200x630 (la genera scripts/generar-og.mjs).
const IMAGEN_SOCIAL_POR_DEFECTO: ImagenSocial = {
  url: "/og/portada-social.jpg",
  ancho: 1200,
  alto: 630,
};
const social = imagenSocial ?? IMAGEN_SOCIAL_POR_DEFECTO;
const urlImagenSocial = new URL(social.url, base).href;
// Las medidas se publican siempre que se conozcan las DOS: le ahorran a la red
// una descarga para averiguar la proporcion y evitan que la tarjeta salte. Las
// paginas de linea e institucionales las traen de la base (se guardan al
// procesar la imagen); si esa fila es vieja y no las tiene, se omiten en vez de
// inventarlas.
const hayMedidasSociales = social.ancho !== undefined && social.alto !== undefined;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f6f9fd" />
    <meta name="color-scheme" content="light" />
    {
      /* Iconos cuadrados con el isotipo (no el logotipo apaisado, que a 32 px se
        vuelve ilegible). Los genera scripts/generar-favicons.mjs. */
    }
    <link rel="icon" type="image/png" sizes="512x512" href="/brand/icono-512.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/brand/icono-apple-180.png" />
    <link rel="canonical" href={urlCanonica} />
    {noindex && <meta name="robots" content="noindex" />}
    <title>{title}</title>

    {
      /*
      Tipografia autoalojada (los @font-face viven en src/styles/global.css).
      Se precargan las DOS caras que pinta el primer viewport: la sans del
      cuerpo y la serif de los titulares. Precargar de mas compite por ancho de
      banda con la imagen del hero, que es el LCP.
      `crossorigin` es obligatorio aunque el archivo sea del mismo origen: las
      fuentes se piden en modo CORS y sin el atributo el navegador descarga el
      archivo DOS veces.
    */
    }
    <link rel="preload" as="font" type="font/woff2" href={urlFuenteSans} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={urlFuenteSerif} crossorigin />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={urlCanonica} />
    <meta property="og:image" content={urlImagenSocial} />
    <meta property="og:image:alt" content={social.alt ?? title} />
    {
      hayMedidasSociales && (
        <>
          <meta property="og:image:width" content={String(social.ancho)} />
          <meta property="og:image:height" content={String(social.alto)} />
        </>
      )
    }
    <meta property="og:locale" content="es_PE" />
    <meta property="og:site_name" content="Human Touch Books" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body class="min-h-screen antialiased">
    {
      anclaContenido && (
        <a class="salto-contenido" href={anclaContenido}>
          Saltar al contenido
        </a>
      )
    }
    <slot />
  </body>
</html>
