generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LineaLibro {
  escolar
  literatura
}

model Libro {
  id         String     @id @default(cuid())
  titulo     String
  subtitulo  String?
  linea      LineaLibro
  grado      String?
  nivel      String?
  autor      String?
  ilustrador String?
  anio       Int?
  sinopsis   String
  portadaUrl String     @map("portada_url")
  orden      Int        @default(0)
  destacado  Boolean    @default(false)
  creadoEn   DateTime   @default(now()) @map("creado_en")
  editadoEn  DateTime   @updatedAt @map("editado_en")

  @@map("libros")
}

model Usuario {
  id             String   @id @default(cuid())
  correo         String   @unique
  nombre         String
  hashContrasena String   @map("hash_contrasena")
  creadoEn       DateTime @default(now()) @map("creado_en")
  // Version de la credencial: el token de sesion la lleva dentro y el
  // middleware la compara con esta. Al cambiar la contrasena sube y todas las
  // sesiones emitidas antes dejan de valer (un JWT no se puede revocar solo).
  claveActualizadaEn DateTime @default(now()) @map("clave_actualizada_en")

  @@map("usuarios")
}

model Mensaje {
  id       String   @id @default(cuid())
  nombre   String
  correo   String
  telefono String
  asunto   String
  mensaje  String
  atendido Boolean  @default(false)
  creadoEn DateTime @default(now()) @map("creado_en")

  @@map("mensajes")
}

model Ajuste {
  clave     String   @id
  valor     String
  editadoEn DateTime @updatedAt @map("editado_en")

  @@map("ajustes")
}

// Imagenes del carrusel del hero. Con cero filas la portada usa la imagen del
// repositorio; con una se muestra sola; con dos o mas se arma el carrusel.
model ImagenHero {
  id        String   @id @default(cuid())
  imagenUrl String   @map("imagen_url")
  altTexto  String   @map("alt_texto")
  orden     Int      @default(0)
  activa    Boolean  @default(true)
  creadoEn  DateTime @default(now()) @map("creado_en")

  @@map("imagenes_hero")
}

// Imagenes de secciones fijas de la landing (una fila por espacio). La clave es
// el identificador del espacio: sin fila, la landing cae al archivo del repo.
model ImagenSitio {
  id            String   @id @default(cuid())
  clave         String   @unique
  imagenUrl     String   @map("imagen_url")
  altTexto      String   @map("alt_texto")
  // Medidas reales de la imagen ya procesada: reservan su espacio exacto en la
  // landing (CLS cero). Nullable por las filas creadas antes de guardarlas.
  ancho         Int?
  alto          Int?
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  @@map("imagenes_sitio")
}

// Textos comerciales sueltos de la landing (titulares, antetitulos, parrafos,
// botones). Una fila por texto y solo cuando se personaliza: el valor por
// defecto vive en el codigo (src/lib/textos.ts) y sin fila la web lo usa. Por
// eso vaciar el campo en el panel borra la fila en vez de guardar "".
model TextoSitio {
  id            String   @id @default(cuid())
  clave         String   @unique
  valor         String
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  @@map("textos_sitio")
}

// Bloques de la seccion "Que aporta Tutoria SMART". Con cero filas la landing
// muestra los cuatro bloques que trae el diseno (src/lib/bloques.ts).
model BloqueValor {
  id       String   @id @default(cuid())
  titulo   String
  texto    String
  orden    Int      @default(0)
  activa   Boolean  @default(true)
  creadoEn DateTime @default(now()) @map("creado_en")

  @@map("bloques_valor")
}

// Tarjetas pequenas de la seccion Plataforma. Mismo criterio que BloqueValor:
// con la tabla vacia se muestran las del diseno.
model ChipPlataforma {
  id       String   @id @default(cuid())
  titulo   String
  texto    String
  orden    Int      @default(0)
  activa   Boolean  @default(true)
  creadoEn DateTime @default(now()) @map("creado_en")

  @@map("chips_plataforma")
}

// Preguntas frecuentes de la landing. Los campos de enlace son opcionales y
// reproducen los enlaces de accion que la seccion ya mostraba.
model Pregunta {
  id          String   @id @default(cuid())
  pregunta    String
  respuesta   String
  enlaceHref  String?  @map("enlace_href")
  enlaceTexto String?  @map("enlace_texto")
  orden       Int      @default(0)
  activa      Boolean  @default(true)
  creadoEn    DateTime @default(now()) @map("creado_en")

  @@map("preguntas")
}
