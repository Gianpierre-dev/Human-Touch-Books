generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LineaLibro {
  escolar
  literatura
}

// Tipos de bloque corto de la pagina publica de una linea. Se distinguen por lo
// que muestran: el pilar es solo una etiqueta bajo un icono; el argumento lleva
// ademas una frase explicativa.
enum TipoBloqueLinea {
  pilar
  argumento
}

// Lineas de producto del catalogo: cada una agrupa libros y aporta su identidad
// (nombre comercial, color y texto de presentacion) a la pagina de la linea.
//
// Convive a proposito con el enum `LineaLibro` de Libro: la landing todavia
// filtra por ese campo. La migracion de datos y el retiro del enum quedan para
// una etapa posterior; mientras tanto la relacion es opcional y aditiva.
model Linea {
  id            String   @id @default(cuid())
  clave         String   @unique
  nombre        String
  etiquetaCorta String   @map("etiqueta_corta")
  descripcion   String
  colorHex      String   @map("color_hex")
  orden         Int      @default(0)
  activa        Boolean  @default(true)
  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  // Contenido de la pagina publica /lineas/{clave}. Todos opcionales: sin valor
  // la pagina cae a un defecto derivado de la propia linea (src/lib/lineas.ts),
  // igual que hace la landing con TextoSitio. Sembrar los defectos en la base
  // taparia para siempre cualquier retoque del copy hecho en el codigo.
  heroAntetitulo   String? @map("hero_antetitulo")
  heroTitulo       String? @map("hero_titulo")
  heroParrafo      String? @map("hero_parrafo")
  heroImagenUrl    String? @map("hero_imagen_url")
  heroImagenAlt    String? @map("hero_imagen_alt")
  // Medidas reales de la imagen ya procesada: reservan su espacio exacto en la
  // pagina (CLS cero). Mismo criterio que ImagenSitio.
  heroAncho        Int?    @map("hero_ancho")
  heroAlto         Int?    @map("hero_alto")
  pilaresTitulo    String? @map("pilares_titulo")
  pilaresParrafo   String? @map("pilares_parrafo")
  coleccionTitulo  String? @map("coleccion_titulo")
  argumentosTitulo String? @map("argumentos_titulo")
  ctaTitulo        String? @map("cta_titulo")
  ctaParrafo       String? @map("cta_parrafo")

  libros  Libro[]
  bloques BloqueLinea[]

  @@map("lineas")
}

// Bloques cortos de la pagina de una linea: los pilares (solo etiqueta) y los
// argumentos (etiqueta + frase). Viven en una sola tabla porque comparten forma
// y mecanica de administracion; los separa el campo `tipo`.
//
// Al borrar la linea se borran sus bloques (`Cascade`): no son contenido
// reutilizable como los libros, solo tienen sentido dentro de su pagina.
model BloqueLinea {
  id       String          @id @default(cuid())
  lineaId  String          @map("linea_id")
  linea    Linea           @relation(fields: [lineaId], references: [id], onDelete: Cascade)
  tipo     TipoBloqueLinea
  titulo   String
  // Solo lo usan los argumentos: el pilar es una etiqueta suelta bajo su icono.
  texto    String?
  orden    Int             @default(0)
  activa   Boolean         @default(true)
  creadoEn DateTime        @default(now()) @map("creado_en")

  @@index([lineaId, tipo])
  @@map("bloques_linea")
}

model Libro {
  id               String     @id @default(cuid())
  titulo           String
  subtitulo        String?
  linea            LineaLibro
  grado            String?
  nivel            String?
  autor            String?
  ilustrador       String?
  anio             Int?
  sinopsis         String
  // Frase breve que acompana al libro en la pagina de su linea.
  descripcionCorta String?    @map("descripcion_corta")
  portadaUrl       String     @map("portada_url")
  orden            Int        @default(0)
  destacado        Boolean    @default(false)
  creadoEn         DateTime   @default(now()) @map("creado_en")
  editadoEn        DateTime   @updatedAt @map("editado_en")

  // Al borrar una linea los libros no se pierden: quedan sin linea asignada.
  lineaId  String? @map("linea_id")
  lineaRel Linea?  @relation(fields: [lineaId], references: [id], onDelete: SetNull)

  @@index([lineaId])
  @@map("libros")
}

// Paginas institucionales (/nosotros/{clave}): «Quienes somos», «Mision y
// vision», «Compromiso»... Son paginas de contenido, no de catalogo, y por eso
// no cuelgan de Linea.
//
// `activa` arranca en FALSE a proposito: una pagina recien creada esta a medio
// escribir. Mientras siga inactiva no aparece en el menu y su URL responde 404,
// asi que nadie publica un borrador sin querer.
//
// Todos los campos de contenido son opcionales salvo `titulo`: una pagina con
// solo titulo y parrafos tiene que verse digna, y cada seccion de la plantilla
// se omite cuando no tiene contenido (mismo criterio que /lineas/{clave}).
//
// A diferencia de Linea, aqui NO hay defectos derivados: el contenido
// institucional no se puede inventar a partir del nombre de la pagina.
model PaginaInstitucional {
  id     String @id @default(cuid())
  // Slug estable: es el identificador que usa la URL publica.
  clave  String @unique
  // Nombre con el que la pagina aparece en el menu «Nosotros».
  titulo String

  // --- Hero ---
  antetitulo      String?
  tituloPagina    String? @map("titulo_pagina")
  // Segunda mitad del titular, la que va en el color de marca. Se concatena al
  // final de `tituloPagina`: la pieza parte la frase, no la repite.
  tituloDestacado String? @map("titulo_destacado")
  // Texto largo del hero. Una linea en blanco separa parrafos, igual que el
  // parrafo del hero de una linea (src/lib/lineas.ts).
  parrafos        String?
  imagenUrl       String? @map("imagen_url")
  imagenAlt       String? @map("imagen_alt")
  // Medidas reales de la imagen ya procesada: reservan su hueco exacto (CLS
  // cero). Mismo criterio que ImagenSitio y que el hero de Linea.
  ancho           Int?
  alto            Int?

  // --- Encabezado de la fila de valores ---
  bloquesAntetitulo String? @map("bloques_antetitulo")
  bloquesTitulo     String? @map("bloques_titulo")

  // --- Frase de cierre ---
  cierreTexto     String? @map("cierre_texto")
  // Parte de esa frase que va en el color de marca. Se concatena al final.
  cierreDestacado String? @map("cierre_destacado")

  orden         Int      @default(0)
  activa        Boolean  @default(false)
  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  secciones SeccionPagina[]
  bloques   BloquePagina[]

  @@map("paginas_institucionales")
}

// Bloques grandes de una pagina institucional: MISION, VISION... Cada uno lleva
// icono en circulo, titulo, texto y una frase destacada opcional con barra
// lateral.
//
// Al borrar la pagina se borran sus secciones (`Cascade`): no son contenido
// reutilizable, solo tienen sentido dentro de su pagina.
model SeccionPagina {
  id       String              @id @default(cuid())
  paginaId String              @map("pagina_id")
  pagina   PaginaInstitucional @relation(fields: [paginaId], references: [id], onDelete: Cascade)
  titulo   String
  // Una linea en blanco separa parrafos.
  texto    String
  // Frase resaltada con barra lateral, bajo el texto. Opcional.
  destacado String?
  orden    Int                 @default(0)
  activa   Boolean             @default(true)
  creadoEn DateTime            @default(now()) @map("creado_en")

  @@index([paginaId])
  @@map("secciones_pagina")
}

// Tarjetas de valores de una pagina institucional (Etica, Compromiso...): icono
// en circulo claro, titulo y texto corto. Mismo `Cascade` que las secciones.
model BloquePagina {
  id       String              @id @default(cuid())
  paginaId String              @map("pagina_id")
  pagina   PaginaInstitucional @relation(fields: [paginaId], references: [id], onDelete: Cascade)
  titulo   String
  texto    String
  orden    Int                 @default(0)
  activa   Boolean             @default(true)
  creadoEn DateTime            @default(now()) @map("creado_en")

  @@index([paginaId])
  @@map("bloques_pagina")
}

model Usuario {
  id                 String   @id @default(cuid())
  correo             String   @unique
  nombre             String
  hashContrasena     String   @map("hash_contrasena")
  creadoEn           DateTime @default(now()) @map("creado_en")
  // Version de la credencial: el token de sesion la lleva dentro y el
  // middleware la compara con esta. Al cambiar la contrasena sube y todas las
  // sesiones emitidas antes dejan de valer (un JWT no se puede revocar solo).
  claveActualizadaEn DateTime @default(now()) @map("clave_actualizada_en")

  @@map("usuarios")
}

model Mensaje {
  id       String   @id @default(cuid())
  nombre   String
  correo   String
  telefono String
  asunto   String
  mensaje  String
  atendido Boolean  @default(false)
  creadoEn DateTime @default(now()) @map("creado_en")

  @@map("mensajes")
}

model Ajuste {
  clave     String   @id
  valor     String
  editadoEn DateTime @updatedAt @map("editado_en")

  @@map("ajustes")
}

// Imagenes del carrusel del hero. Con cero filas la portada usa la imagen del
// repositorio; con una se muestra sola; con dos o mas se arma el carrusel.
model ImagenHero {
  id        String   @id @default(cuid())
  imagenUrl String   @map("imagen_url")
  altTexto  String   @map("alt_texto")
  orden     Int      @default(0)
  activa    Boolean  @default(true)
  creadoEn  DateTime @default(now()) @map("creado_en")

  @@map("imagenes_hero")
}

// Imagenes de secciones fijas de la landing (una fila por espacio). La clave es
// el identificador del espacio: sin fila, la landing cae al archivo del repo.
model ImagenSitio {
  id            String   @id @default(cuid())
  clave         String   @unique
  imagenUrl     String   @map("imagen_url")
  altTexto      String   @map("alt_texto")
  // Medidas reales de la imagen ya procesada: reservan su espacio exacto en la
  // landing (CLS cero). Nullable por las filas creadas antes de guardarlas.
  ancho         Int?
  alto          Int?
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  @@map("imagenes_sitio")
}

// Textos comerciales sueltos de la landing (titulares, antetitulos, parrafos,
// botones). Una fila por texto y solo cuando se personaliza: el valor por
// defecto vive en el codigo (src/lib/textos.ts) y sin fila la web lo usa. Por
// eso vaciar el campo en el panel borra la fila en vez de guardar "".
model TextoSitio {
  id            String   @id @default(cuid())
  clave         String   @unique
  valor         String
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  @@map("textos_sitio")
}

// Bloques de la seccion "Que aporta Tutoria SMART". Con cero filas la landing
// muestra los cuatro bloques que trae el diseno (src/lib/bloques.ts).
model BloqueValor {
  id       String   @id @default(cuid())
  titulo   String
  texto    String
  orden    Int      @default(0)
  activa   Boolean  @default(true)
  creadoEn DateTime @default(now()) @map("creado_en")

  @@map("bloques_valor")
}

// Tarjetas pequenas de la seccion Plataforma. Mismo criterio que BloqueValor:
// con la tabla vacia se muestran las del diseno.
model ChipPlataforma {
  id       String   @id @default(cuid())
  titulo   String
  texto    String
  orden    Int      @default(0)
  activa   Boolean  @default(true)
  creadoEn DateTime @default(now()) @map("creado_en")

  @@map("chips_plataforma")
}

// Preguntas frecuentes de la landing. Los campos de enlace son opcionales y
// reproducen los enlaces de accion que la seccion ya mostraba.
model Pregunta {
  id          String   @id @default(cuid())
  pregunta    String
  respuesta   String
  enlaceHref  String?  @map("enlace_href")
  enlaceTexto String?  @map("enlace_texto")
  orden       Int      @default(0)
  activa      Boolean  @default(true)
  creadoEn    DateTime @default(now()) @map("creado_en")

  @@map("preguntas")
}
